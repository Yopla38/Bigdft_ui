diff --git a/haps/tests/test_offline.py b/haps/tests/test_offline.py
index 94ea02d..061ae14 100644
--- a/haps/tests/test_offline.py
+++ b/haps/tests/test_offline.py
@@ -129,3 +129,40 @@ def test_select_sends_the_run_and_its_side_files(tmp_path):
     assert sorted(inputs.select(tmp_path, "N2")) == ["N2.yaml", "posinp.xyz", "psppar.N"]
     with pytest.raises(inputs.InputError):
         inputs.select(tmp_path, "CO")
+
+
+def test_inputs_accept_the_wavefunctions_of_the_run_and_nothing_else_in_a_directory():
+    wf = ["data-N2/wavefunction-k001-NR.bin.b000001", "data-N2/wavefunction-k001-UR.b000012",
+          "data-N2/wavefunction-k002-DI.bin.b000003", "data-N2/wavefunction-rhoij.bin"]
+    inputs.check(["N2.yaml", *wf], "N2")
+    for bad in ("data-CO/wavefunction-k001-NR.bin.b000001",      # another run's directory
+                "data-N2/run.py", "data-N2/time-N2.yaml", "data-N2/N2.yaml",
+                "data-N2/sub/wavefunction-k001-NR.bin.b000001",
+                "data-N2/../wavefunction-k001-NR.bin.b000001",
+                "data-N2/wavefunction-k001-NR.bin.b000001.sh",
+                "wavefunction-k001-NR.bin.b000001"):               # not where BigDFT reads it
+        with pytest.raises(inputs.InputError):
+            inputs.check(["N2.yaml", bad], "N2")
+
+
+def test_select_sends_the_wavefunctions_to_restart_from(tmp_path):
+    (tmp_path / "N2.yaml").write_text("x")
+    for folder in ("data-N2", "data-CO"):
+        (tmp_path / folder).mkdir()
+        for f in ("wavefunction-k001-NR.bin.b000001", "time-N2.yaml", "notes.txt"):
+            (tmp_path / folder / f).write_text("x")
+    selected = inputs.select(tmp_path, "N2")
+    assert sorted(selected) == ["N2.yaml", "data-N2/wavefunction-k001-NR.bin.b000001"]
+    inputs.check(list(selected), "N2")
+
+
+def test_wavefunctions_travel_and_land_in_their_directory(tmp_path):
+    src, dst = tmp_path / "src", tmp_path / "dst"
+    (src / "data-N2").mkdir(parents=True)
+    dst.mkdir()
+    (src / "N2.yaml").write_text("x")
+    (src / "data-N2" / "wavefunction-k001-NR.bin.b000001").write_bytes(b"\x00\x01")
+    data = archive.pack(inputs.select(src, "N2"))
+    inputs.check(archive.members(data), "N2")
+    archive.unpack(data, dst)
+    assert (dst / "data-N2" / "wavefunction-k001-NR.bin.b000001").read_bytes() == b"\x00\x01"
