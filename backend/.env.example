# The settings of the server (backend/serve.py). Copy to backend/.env and change what you need:
#
#     cp .env.example .env
#
# Every variable has a default that suits a start on your own machine, so an
# empty .env works. In production, the first block is the one to fill.
# backend/.env is not committed. The credentials of the HAPS are NOT here: they
# belong to the bridge (./bridge.sh credentials.env), the only process that holds them.

# ── where and how it is served ───────────────────────────────────────────────
# development: cookies travel over http://localhost, the API is described at /api/docs.
# production:  ONDELETTE_PUBLIC_URL is required and must be HTTPS; cookies are Secure, named __Host-…
ONDELETTE_ENV=development

# The address people open. Required in production (https://…), behind your reverse proxy.
# Requests that change something are accepted from this origin only.
#ONDELETTE_PUBLIC_URL=https://ondelette.example.org

# What the server listens on. Keep 127.0.0.1 and put a reverse proxy in front for HTTPS.
ONDELETTE_HOST=127.0.0.1
ONDELETTE_PORT=8766

# The proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (comma-separated addresses).
#ONDELETTE_FORWARDED_ALLOW_IPS=127.0.0.1

# Other Host headers to answer, e.g. the address a health check uses (comma-separated).
#ONDELETTE_EXTRA_HOSTS=10.0.0.12

# Other origins allowed to call the API with the session cookie (a page served from elsewhere).
# Empty: none, the API is same-origin only. Cross-site cookies also need ONDELETTE_COOKIE_SAMESITE=none.
#ONDELETTE_CORS_ORIGINS=https://app.example.org

# ── the database ─────────────────────────────────────────────────────────────
# SQLite by default, in backend/data/. For PostgreSQL: `uv sync --extra postgres`, then
#ONDELETTE_DATABASE_URL=postgresql+psycopg://ondelette:PASSWORD@localhost:5432/ondelette
# After any change here:  uv run alembic upgrade head
#ONDELETTE_DATABASE_URL=sqlite:////absolute/path/to/ondelette.db

# ── accounts and sessions ────────────────────────────────────────────────────
# open:   anyone who reaches the page can create an account (and compute on the HAPS account of the bridge).
# closed: accounts are created by an administrator (profile menu → Users).
ONDELETTE_REGISTRATION=open

# A session ends after that many days without a request.
ONDELETTE_SESSION_DAYS=14
ONDELETTE_PASSWORD_MIN_LENGTH=10

# Failed sign-ins for one address and one e-mail before the next ones are refused, and for how long they count.
ONDELETTE_LOGIN_MAX_ATTEMPTS=8
ONDELETTE_LOGIN_WINDOW_MINUTES=15

# true in production, false otherwise, unless said here. `none` only for a page on another site, over HTTPS.
#ONDELETTE_COOKIE_SECURE=true
#ONDELETTE_COOKIE_SAMESITE=lax

# ── computing ────────────────────────────────────────────────────────────────
# The MCP bridge (./bridge.sh). Empty: mcp_url of the default HAPS in ../config/haps.yaml (http://127.0.0.1:8791/mcp).
#ONDELETTE_BRIDGE=http://127.0.0.1:8791/mcp

# Where the studies are written, one directory per user and per study. It MUST be the working
# directory of the bridge. bridge.sh does not read this file: when you change it here, export the
# same ONDELETTE_WORKDIR in the shell that starts ./bridge.sh. Default for both: backend/work.
#ONDELETTE_WORKDIR=/var/lib/ondelette/work

# Seconds a run may take on the HAPS. Empty: limits.max_timeout_s of ../config/haps.yaml.
#ONDELETTE_TIMEOUT=3600

# Waves one user may have on their way at the same time, and studies one account may hold.
ONDELETTE_MAX_JOBS_PER_USER=2
ONDELETTE_MAX_STUDIES_PER_USER=200

# ── python -m app.seed ───────────────────────────────────────────────────────
# The first administrator. A password left empty is generated and printed once by the seed.
ONDELETTE_ADMIN_EMAIL=admin@example.org
ONDELETTE_ADMIN_NAME=Administrator
ONDELETTE_ADMIN_PASSWORD=

# A demonstration account with two studies. Empty e-mail: none (recommended in production).
ONDELETTE_DEMO_EMAIL=demo@example.org
ONDELETTE_DEMO_PASSWORD=
