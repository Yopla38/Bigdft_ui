  rdfs:label "perf.adjust_kernel_threshold" ;
  ws:inputPath "perf.adjust_kernel_threshold" ;
  ws:inSection ws:Section_perf ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
