  rdfs:label "linear_fragments" ;
  ws:profileValues "{\"dft\": {\"inputpsiid\": \"linear_restart\"}, \"lin_basis\": {\"idsx\": 0, \"nit\": 1}, \"lin_general\": {\"charge_multipoles\": 0, \"hybrid\": false, \"nit\": [0, 1], \"subspace_diag\": true}, \"lin_kernel\": {\"alphamix\": 0.1, \"delta_pnrm\": -1, \"nit\": 100, \"rpnrm_cv\": 1e-11}, \"perf\": {\"adjust_kernel_iterations\": false, \"adjust_kernel_threshold\": false}}" ;
