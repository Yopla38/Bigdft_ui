  rdfs:label "linear_convergence" ;
  ws:profileValues "{\"lin_kernel\": {\"rpnrm_cv\": \"1e-10\"}, \"lin_general\": {\"nit\": 100}, \"lin_basis\": {\"nit\": 2}, \"perf\": {\"adjust_kernel_iterations\": false, \"adjust_kernel_threshold\": false}}" ;
