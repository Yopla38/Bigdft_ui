ws:Parameter_perf_calculate_forces a ws:Parameter ;
  rdfs:label "perf.calculate_forces" ;
  ws:inputPath "perf.calculate_forces" ;
  ws:inSection ws:Section_perf ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "true" ;
