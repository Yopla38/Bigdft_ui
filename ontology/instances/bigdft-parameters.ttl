ws:Profile_bigdft_md a ws:Profile ;
  rdfs:label "md" ;
  ws:profileValues "{\"geopt\": {\"method\": \"AB6MD\", \"ionmov\": 8, \"dtion\": 20.0, \"noseinert\": 30.0}}" ;
  rdfs:comment "Molecular dynamics input parameters for H2O molecules"@en ;
  ws:sets ws:Parameter_geopt_method ;
  ws:sets ws:Parameter_geopt_ionmov ;
  ws:sets ws:Parameter_geopt_dtion ;
  ws:sets ws:Parameter_geopt_noseinert .

ws:Section_psolver_kernel a ws:Section ; rdfs:label "psolver.kernel" .
ws:Parameter_psolver_kernel_screening a ws:Parameter ;
  rdfs:label "psolver.kernel.screening" ;
  ws:inputPath "psolver.kernel.screening" ;
  ws:inSection ws:Section_psolver_kernel ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0" ;
  ws:shortDescription "Mu screening parameter"@en ;
  ws:lowerBound "0.0"^^xsd:double .
ws:Parameter_psolver_kernel_isf_order a ws:Parameter ;
  rdfs:label "psolver.kernel.isf_order" ;
  ws:inputPath "psolver.kernel.isf_order" ;
  ws:inSection ws:Section_psolver_kernel ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "16" ;
  ws:shortDescription "Order of the Interpolating Scaling Function family"@en ;
  ws:allowedValues "[2, 4, 6, 8, 14, 16, 20, 24, 30, 40, 50, 60, 100]" .
ws:Parameter_psolver_kernel_stress_tensor a ws:Parameter ;
  rdfs:label "psolver.kernel.stress_tensor" ;
  ws:inputPath "psolver.kernel.stress_tensor" ;
  ws:inSection ws:Section_psolver_kernel ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Triggers the calculation of the stress tensor"@en .

ws:Section_psolver_environment a ws:Section ; rdfs:label "psolver.environment" .
ws:Parameter_psolver_environment_cavity a ws:Parameter ;
  rdfs:label "psolver.environment.cavity" ;
  ws:inputPath "psolver.environment.cavity" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Type of the cavity"@en ;
  ws:allowedValues "[\"none\", \"soft-sphere\", \"sccs\"]" .
ws:Parameter_psolver_environment_epsilon a ws:Parameter ;
  rdfs:label "psolver.environment.epsilon" ;
  ws:inputPath "psolver.environment.epsilon" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"water\"" ;
  ws:shortDescription "Dielectric constant of the exterior region"@en ;
  ws:lowerBound "1.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_edensmaxmin a ws:Parameter ;
  rdfs:label "psolver.environment.edensmaxmin" ;
  ws:inputPath "psolver.environment.edensmaxmin" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0.0001, 0.005]" ;
  ws:shortDescription "Extremum values of the charge density, for the definition of the transition region"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_radii_set a ws:Parameter ;
  rdfs:label "psolver.environment.radii_set" ;
  ws:inputPath "psolver.environment.radii_set" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"UFF\"" ;
  ws:shortDescription "Set of vdW radii used by default in the setter function"@en ;
  ws:allowedValues "[\"UFF\", \"Bondi\", \"Pauling\"]" ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_atomic_radii a ws:Parameter ;
  rdfs:label "psolver.environment.atomic_radii" ;
  ws:inputPath "psolver.environment.atomic_radii" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Mapping of the radii that have to be used for each atomic species"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_delta a ws:Parameter ;
  rdfs:label "psolver.environment.delta" ;
  ws:inputPath "psolver.environment.delta" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0.5" ;
  ws:shortDescription "Amplitude of the transition region in the soft-sphere cavity (AU)"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_cavitation a ws:Parameter ;
  rdfs:label "psolver.environment.cavitation" ;
  ws:inputPath "psolver.environment.cavitation" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "true" ;
  ws:shortDescription "Triggers the evaluation of the extra cavitation terms"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_fact_rigid a ws:Parameter ;
  rdfs:label "psolver.environment.fact_rigid" ;
  ws:inputPath "psolver.environment.fact_rigid" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "1.12" ;
  ws:shortDescription "Multiplying factor for the whole soft-sphere cavity"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_gammaS a ws:Parameter ;
  rdfs:label "psolver.environment.gammaS" ;
  ws:inputPath "psolver.environment.gammaS" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"water\"" ;
  ws:shortDescription "Cavitation term, surface tension of the solvent [dyn/cm]"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavitation .
ws:Parameter_psolver_environment_alphaS a ws:Parameter ;
  rdfs:label "psolver.environment.alphaS" ;
  ws:inputPath "psolver.environment.alphaS" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"water\"" ;
  ws:shortDescription "Proportionality of repulsion free energy in term of the surface integral [dyn/cm]"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavitation .
ws:Parameter_psolver_environment_betaV a ws:Parameter ;
  rdfs:label "psolver.environment.betaV" ;
  ws:inputPath "psolver.environment.betaV" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"water\"" ;
  ws:shortDescription "Proportionality of dispersion free energy in term of volume integral [GPa]"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavitation .
ws:Parameter_psolver_environment_gps_algorithm a ws:Parameter ;
  rdfs:label "psolver.environment.gps_algorithm" ;
  ws:inputPath "psolver.environment.gps_algorithm" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"PCG\"" ;
  ws:shortDescription "Algorithm for the Generalised Poisson Equation"@en ;
  ws:allowedValues "[\"SC\", \"PCG\"]" ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_pi_eta a ws:Parameter ;
  rdfs:label "psolver.environment.pi_eta" ;
  ws:inputPath "psolver.environment.pi_eta" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.6" ;
  ws:shortDescription "Mixing parameter of the SC algorithm"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_psolver_environment_gps_algorithm .
ws:Parameter_psolver_environment_input_guess a ws:Parameter ;
  rdfs:label "psolver.environment.input_guess" ;
  ws:inputPath "psolver.environment.input_guess" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Triggers the input guess procedure of gps_algorithm"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_cavity .
ws:Parameter_psolver_environment_fd_order a ws:Parameter ;
  rdfs:label "psolver.environment.fd_order" ;
  ws:inputPath "psolver.environment.fd_order" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "16" ;
  ws:shortDescription "Order of the Finite-difference derivatives for the GPS solver"@en ;
  ws:allowedValues "[2, 4, 6, 8, 16]" .
ws:Parameter_psolver_environment_itermax a ws:Parameter ;
  rdfs:label "psolver.environment.itermax" ;
  ws:inputPath "psolver.environment.itermax" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "200" ;
  ws:shortDescription "Maximum number of iterations of the GPS outer loop"@en .
ws:Parameter_psolver_environment_minres a ws:Parameter ;
  rdfs:label "psolver.environment.minres" ;
  ws:inputPath "psolver.environment.minres" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-08" ;
  ws:shortDescription "Convergence threshold of the loop"@en .
ws:Parameter_psolver_environment_pb_method a ws:Parameter ;
  rdfs:label "psolver.environment.pb_method" ;
  ws:inputPath "psolver.environment.pb_method" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Defines the method for the Poisson Boltzmann Equation"@en ;
  ws:allowedValues "[\"none\", \"linear\", \"standard\", \"modified\"]" .
ws:Parameter_psolver_environment_pb_minres a ws:Parameter ;
  rdfs:label "psolver.environment.pb_minres" ;
  ws:inputPath "psolver.environment.pb_minres" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-10" ;
  ws:shortDescription "Convergence criterion of the PBe loop"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .
ws:Parameter_psolver_environment_pb_input_guess a ws:Parameter ;
  rdfs:label "psolver.environment.pb_input_guess" ;
  ws:inputPath "psolver.environment.pb_input_guess" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Triggers the input guess procedure of PBe loop"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .
ws:Parameter_psolver_environment_pb_eta a ws:Parameter ;
  rdfs:label "psolver.environment.pb_eta" ;
  ws:inputPath "psolver.environment.pb_eta" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Mixing parameter of the PBe loop"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .
ws:Parameter_psolver_environment_pb_itermax a ws:Parameter ;
  rdfs:label "psolver.environment.pb_itermax" ;
  ws:inputPath "psolver.environment.pb_itermax" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "50" ;
  ws:shortDescription "Maximum number of iterations of the PBe loop"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .
ws:Parameter_psolver_environment_pb_t a ws:Parameter ;
  rdfs:label "psolver.environment.pb_t" ;
  ws:inputPath "psolver.environment.pb_t" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "300.0" ;
  ws:shortDescription "Temperature in Kelvin of the electrolytic solution"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .
ws:Parameter_psolver_environment_pb_ions a ws:Parameter ;
  rdfs:label "psolver.environment.pb_ions" ;
  ws:inputPath "psolver.environment.pb_ions" ;
  ws:inSection ws:Section_psolver_environment ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"nacl\"" ;
  ws:shortDescription "List of the ions of the PBe environment"@en ;
  ws:dependsOn ws:Parameter_psolver_environment_pb_method .

ws:Section_psolver_setup a ws:Section ; rdfs:label "psolver.setup" .
ws:Parameter_psolver_setup_accel a ws:Parameter ;
  rdfs:label "psolver.setup.accel" ;
  ws:inputPath "psolver.setup.accel" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Material Acceleration"@en ;
  ws:allowedValues "[\"none\", \"CUDA\", \"DBFFT\", \"DBFFTCPU\", \"ONEMATH\", \"ONEMATHCPU\"]" .
ws:Parameter_psolver_setup_keep_gpu_memory a ws:Parameter ;
  rdfs:label "psolver.setup.keep_gpu_memory" ;
  ws:inputPath "psolver.setup.keep_gpu_memory" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Do not deallocate GPU memory at each call of the (G)PS routine"@en ;
  ws:dependsOn ws:Parameter_psolver_setup_accel .
ws:Parameter_psolver_setup_use_gpu_direct a ws:Parameter ;
  rdfs:label "psolver.setup.use_gpu_direct" ;
  ws:inputPath "psolver.setup.use_gpu_direct" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Force (or not) the usage of GPUdirect communication, if available"@en ;
  ws:dependsOn ws:Parameter_psolver_setup_accel .
ws:Parameter_psolver_setup_taskgroup_size a ws:Parameter ;
  rdfs:label "psolver.setup.taskgroup_size" ;
  ws:inputPath "psolver.setup.taskgroup_size" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Size of the taskgroups of the Poisson Solver"@en .
ws:Parameter_psolver_setup_global_data a ws:Parameter ;
  rdfs:label "psolver.setup.global_data" ;
  ws:inputPath "psolver.setup.global_data" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Charge density and Electrostatic potential are given by global arrays"@en .
ws:Parameter_psolver_setup_verbose a ws:Parameter ;
  rdfs:label "psolver.setup.verbose" ;
  ws:inputPath "psolver.setup.verbose" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Verbosity switch"@en .
ws:Parameter_psolver_setup_output a ws:Parameter ;
  rdfs:label "psolver.setup.output" ;
  ws:inputPath "psolver.setup.output" ;
  ws:inSection ws:Section_psolver_setup ;
  ws:exposedIn ws:Block_machine ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Quantities to be plotted after the main solver routine"@en .

ws:Profile_psolver_water a ws:Profile ;
  rdfs:label "water" ;
  ws:profileValues "{\"environment\": {\"cavity\": \"sccs\", \"epsilon\": \"water\", \"cavitation\": true}}" ;
  rdfs:comment "Solvation in water"@en ;
  ws:sets ws:Parameter_psolver_environment_cavity ;
  ws:sets ws:Parameter_psolver_environment_epsilon ;
  ws:sets ws:Parameter_psolver_environment_cavitation .

ws:Section_chess_foe a ws:Section ; rdfs:label "chess.foe" .
ws:Parameter_chess_foe_ef_interpol_det a ws:Parameter ;
  rdfs:label "chess.foe.ef_interpol_det" ;
  ws:inputPath "chess.foe.ef_interpol_det" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-12" ;
  ws:shortDescription "FOE max determinant of cubic interpolation matrix"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_foe_ef_interpol_chargediff a ws:Parameter ;
  rdfs:label "chess.foe.ef_interpol_chargediff" ;
  ws:inputPath "chess.foe.ef_interpol_chargediff" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "FOE max charge difference for interpolation"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_chess_foe_evbounds_nsatur a ws:Parameter ;
  rdfs:label "chess.foe.evbounds_nsatur" ;
  ws:inputPath "chess.foe.evbounds_nsatur" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "3" ;
  ws:shortDescription "Number of FOE cycles before the eigenvalue bounds are shrinked (linear)"@en .
ws:Parameter_chess_foe_evboundsshrink_nsatur a ws:Parameter ;
  rdfs:label "chess.foe.evboundsshrink_nsatur" ;
  ws:inputPath "chess.foe.evboundsshrink_nsatur" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "4" ;
  ws:shortDescription "Maximal number of unsuccessful eigenvalue bounds shrinkings"@en .
ws:Parameter_chess_foe_fscale a ws:Parameter ;
  rdfs:label "chess.foe.fscale" ;
  ws:inputPath "chess.foe.fscale" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0.05" ;
  ws:shortDescription "Initial guess for the error function decay length"@en ;
  ws:lowerBound "0.0001"^^xsd:double ;
  ws:upperBound "0.1"^^xsd:double .
ws:Parameter_chess_foe_fscale_lowerbound a ws:Parameter ;
  rdfs:label "chess.foe.fscale_lowerbound" ;
  ws:inputPath "chess.foe.fscale_lowerbound" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.005" ;
  ws:shortDescription "Lower bound for the error function decay length"@en ;
  ws:lowerBound "0.0001"^^xsd:double ;
  ws:upperBound "0.01"^^xsd:double .
ws:Parameter_chess_foe_fscale_upperbound a ws:Parameter ;
  rdfs:label "chess.foe.fscale_upperbound" ;
  ws:inputPath "chess.foe.fscale_upperbound" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.05" ;
  ws:shortDescription "Upper bound for the error function decay length"@en ;
  ws:lowerBound "0.01"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_foe_eval_range_foe a ws:Parameter ;
  rdfs:label "chess.foe.eval_range_foe" ;
  ws:inputPath "chess.foe.eval_range_foe" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[-0.5, 0.5]" ;
  ws:shortDescription "Lower and upper bound of the eigenvalue spectrum, will be adjusted automatically if chosen unproperly"@en ;
  ws:lowerBound "-10.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_chess_foe_accuracy_foe a ws:Parameter ;
  rdfs:label "chess.foe.accuracy_foe" ;
  ws:inputPath "chess.foe.accuracy_foe" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-05" ;
  ws:shortDescription "Required accuracy for the Chebyshev fit for FOE"@en ;
  ws:lowerBound "1e-10"^^xsd:double ;
  ws:upperBound "0.001"^^xsd:double .
ws:Parameter_chess_foe_accuracy_ice a ws:Parameter ;
  rdfs:label "chess.foe.accuracy_ice" ;
  ws:inputPath "chess.foe.accuracy_ice" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-08" ;
  ws:shortDescription "Required accuracy for the Chebyshev fit for ICE (calculation of matrix powers)"@en ;
  ws:lowerBound "1e-10"^^xsd:double ;
  ws:upperBound "0.001"^^xsd:double .
ws:Parameter_chess_foe_accuracy_penalty a ws:Parameter ;
  rdfs:label "chess.foe.accuracy_penalty" ;
  ws:inputPath "chess.foe.accuracy_penalty" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-05" ;
  ws:shortDescription "Required accuracy for the Chebyshev fit for the penalty function"@en ;
  ws:lowerBound "1e-10"^^xsd:double ;
  ws:upperBound "0.001"^^xsd:double .
ws:Parameter_chess_foe_accuracy_entropy a ws:Parameter ;
  rdfs:label "chess.foe.accuracy_entropy" ;
  ws:inputPath "chess.foe.accuracy_entropy" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "Required accuracy for the Chebyshev fit for the function to calculate the entropy term"@en ;
  ws:lowerBound "1e-09"^^xsd:double ;
  ws:upperBound "0.01"^^xsd:double .
ws:Parameter_chess_foe_betax_foe a ws:Parameter ;
  rdfs:label "chess.foe.betax_foe" ;
  ws:inputPath "chess.foe.betax_foe" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "-1000.0" ;
  ws:shortDescription "the exponent in the exponential penalty function which is used to determine the eigenvalue bounds for FOE"@en ;
  ws:lowerBound "-10000.0"^^xsd:double ;
  ws:upperBound "-10.0"^^xsd:double .
ws:Parameter_chess_foe_betax_ice a ws:Parameter ;
  rdfs:label "chess.foe.betax_ice" ;
  ws:inputPath "chess.foe.betax_ice" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "-1000.0" ;
  ws:shortDescription "the exponent in the exponential penalty function which is used to determine the eigenvalue bounds for ICE"@en ;
  ws:lowerBound "-10000.0"^^xsd:double ;
  ws:upperBound "-10.0"^^xsd:double .
ws:Parameter_chess_foe_occupation_function a ws:Parameter ;
  rdfs:label "chess.foe.occupation_function" ;
  ws:inputPath "chess.foe.occupation_function" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "102" ;
  ws:shortDescription "the function to assign the occupation numbers"@en ;
  ws:allowedValues "[102, 106]" .
ws:Parameter_chess_foe_adjust_fscale a ws:Parameter ;
  rdfs:label "chess.foe.adjust_fscale" ;
  ws:inputPath "chess.foe.adjust_fscale" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "dynamically adjust the value of fscale or not"@en .
ws:Parameter_chess_foe_matmul_optimize_load_balancing a ws:Parameter ;
  rdfs:label "chess.foe.matmul_optimize_load_balancing" ;
  ws:inputPath "chess.foe.matmul_optimize_load_balancing" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "optimize the load balancing of the sparse matrix matrix multiplications (at the cost of memory unbalancing)"@en .
ws:Parameter_chess_foe_fscale_ediff_low a ws:Parameter ;
  rdfs:label "chess.foe.fscale_ediff_low" ;
  ws:inputPath "chess.foe.fscale_ediff_low" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "5e-05" ;
  ws:shortDescription "lower bound for the optimal relative energy difference between the kernel and the control kernel"@en ;
  ws:lowerBound "1e-07"^^xsd:double ;
  ws:upperBound "0.001"^^xsd:double .
ws:Parameter_chess_foe_fscale_ediff_up a ws:Parameter ;
  rdfs:label "chess.foe.fscale_ediff_up" ;
  ws:inputPath "chess.foe.fscale_ediff_up" ;
  ws:inSection ws:Section_chess_foe ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "upper bound for the optimal relative energy difference between the kernel and the control kernel"@en ;
  ws:lowerBound "5e-06"^^xsd:double ;
  ws:upperBound "0.05"^^xsd:double .

ws:Section_chess_lapack a ws:Section ; rdfs:label "chess.lapack" .
