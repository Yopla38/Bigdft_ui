  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_ntpoly_threshold_overlap a ws:Parameter ;
  rdfs:label "chess.ntpoly.threshold_overlap" ;
  ws:inputPath "chess.ntpoly.threshold_overlap" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "threshold for flushing small matrix values of the overlap matrix."@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_ntpoly_convergence_overlap a ws:Parameter ;
  rdfs:label "chess.ntpoly.convergence_overlap" ;
  ws:inputPath "chess.ntpoly.convergence_overlap" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-10" ;
  ws:shortDescription "threshold for convergence of ntpoly overlap inverse calculation."@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_ntpoly_temperature a ws:Parameter ;
  rdfs:label "chess.ntpoly.temperature" ;
  ws:inputPath "chess.ntpoly.temperature" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "300" ;
  ws:shortDescription "temperature in Kelvin for smearing."@en ;
  ws:lowerBound "1e-10"^^xsd:double ;
  ws:upperBound "1000000.0"^^xsd:double ;
