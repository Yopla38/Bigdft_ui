ws:Section_lin_general a ws:Section ; rdfs:label "lin_general" .
ws:Parameter_lin_general_hybrid a ws:Parameter ;
  rdfs:label "lin_general.hybrid" ;
  ws:inputPath "lin_general.hybrid" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "false" ;
  ws:shortDescription "Activate the hybrid mode; if activated, only the low accuracy values will be relevant"@en .
ws:Parameter_lin_general_nit a ws:Parameter ;
  rdfs:label "lin_general.nit" ;
  ws:inputPath "lin_general.nit" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "[100, 100]" ;
  ws:shortDescription "Number of iteration with low/high accuracy"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_general_rpnrm_cv a ws:Parameter ;
  rdfs:label "lin_general.rpnrm_cv" ;
  ws:inputPath "lin_general.rpnrm_cv" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[1e-12, 1e-12]" ;
  ws:shortDescription "Convergence criterion for low/high accuracy"@en ;
  ws:lowerBound "1e-15"^^xsd:double ;
  ws:upperBound "1e-05"^^xsd:double .
ws:Parameter_lin_general_conf_damping a ws:Parameter ;
  rdfs:label "lin_general.conf_damping" ;
  ws:inputPath "lin_general.conf_damping" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "-0.5" ;
  ws:shortDescription "How the confinement should be decreased, only relevant for hybrid mode; negative -> automatic"@en ;
  ws:lowerBound "-1.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_general_taylor_order a ws:Parameter ;
  rdfs:label "lin_general.taylor_order" ;
  ws:inputPath "lin_general.taylor_order" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Order of the Taylor approximation; 0 -> exact"@en ;
  ws:lowerBound "-100.0"^^xsd:double ;
  ws:upperBound "10000.0"^^xsd:double .
ws:Parameter_lin_general_max_inversion_error a ws:Parameter ;
  rdfs:label "lin_general.max_inversion_error" ;
  ws:inputPath "lin_general.max_inversion_error" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Linear scaling maximal error of the Taylor approximations to calculate the inverse of the overlap matrix"@en ;
  ws:lowerBound "1e-20"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_general_output_wf a ws:Parameter ;
  rdfs:label "lin_general.output_wf" ;
  ws:inputPath "lin_general.output_wf" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0" ;
  ws:shortDescription "Output basis functions; 0 no output, 1 formatted output, 2 Fortran bin, 3 ETSF"@en ;
  ws:allowedValues "[0, 1, 2, 3, 10, 11, 12, 13, 20, 21, 22, 23]" .
ws:Parameter_lin_general_output_mat a ws:Parameter ;
  rdfs:label "lin_general.output_mat" ;
  ws:inputPath "lin_general.output_mat" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0" ;
  ws:shortDescription "Output sparse matrices; 0 no output, 1 formatted sparse, 11 formatted dense, 21 formatted both."@en ;
  ws:allowedValues "[0, 1, 11, 21, 2, 12, 22, 31, 4]" .
ws:Parameter_lin_general_output_matder a ws:Parameter ;
  rdfs:label "lin_general.output_matder" ;
  ws:inputPath "lin_general.output_matder" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Output sparse matrices derivatives; 0 no output, 1 formatted sparse,"@en ;
  ws:allowedValues "[0, 1]" .
ws:Parameter_lin_general_output_coeff a ws:Parameter ;
  rdfs:label "lin_general.output_coeff" ;
  ws:inputPath "lin_general.output_coeff" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Output KS coefficients; 0 no output, 1 formatted output"@en ;
  ws:allowedValues "[0, 1]" .
ws:Parameter_lin_general_output_multipole_matrices a ws:Parameter ;
  rdfs:label "lin_general.output_multipole_matrices" ;
  ws:inputPath "lin_general.output_multipole_matrices" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "If outputting support function matrices, also output the multipole matrices in the same format as the other matrices"@en .
ws:Parameter_lin_general_output_matmul a ws:Parameter ;
  rdfs:label "lin_general.output_matmul" ;
  ws:inputPath "lin_general.output_matmul" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "If outputting support function matrices, also include the matmul file"@en .
ws:Parameter_lin_general_output_fragments a ws:Parameter ;
  rdfs:label "lin_general.output_fragments" ;
  ws:inputPath "lin_general.output_fragments" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Output support functions, kernel and coeffs; 0 fragments and full system, 1 fragments only, 2 full system only"@en ;
  ws:allowedValues "[0, 1, 2]" .
ws:Parameter_lin_general_kernel_restart_mode a ws:Parameter ;
  rdfs:label "lin_general.kernel_restart_mode" ;
  ws:inputPath "lin_general.kernel_restart_mode" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Method for restarting kernel; 0 kernel, 1 coefficients, 2 random, 3 diagonal, 4 full kernel, 5 full coeffs"@en ;
  ws:allowedValues "[0, 1, 2, 3, 4, 5, 6, 7]" .
ws:Parameter_lin_general_kernel_restart_noise a ws:Parameter ;
  rdfs:label "lin_general.kernel_restart_noise" ;
  ws:inputPath "lin_general.kernel_restart_noise" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Add random noise to kernel or coefficients when restarting"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_general_frag_num_neighbours a ws:Parameter ;
  rdfs:label "lin_general.frag_num_neighbours" ;
  ws:inputPath "lin_general.frag_num_neighbours" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0" ;
  ws:shortDescription "Number of neighbours to output for each fragment"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "4.0"^^xsd:double .
ws:Parameter_lin_general_frag_neighbour_cutoff a ws:Parameter ;
  rdfs:label "lin_general.frag_neighbour_cutoff" ;
  ws:inputPath "lin_general.frag_neighbour_cutoff" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "12.0" ;
  ws:shortDescription "Number of neighbours to output for each fragment"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double .
ws:Parameter_lin_general_cdft_add_w_guess a ws:Parameter ;
  rdfs:label "lin_general.cdft_add_w_guess" ;
  ws:inputPath "lin_general.cdft_add_w_guess" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Add cdft_add_w_guess * W to kernel for CDFT initial guess"@en ;
  ws:lowerBound "-1000.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_general_calc_dipole a ws:Parameter ;
  rdfs:label "lin_general.calc_dipole" ;
  ws:inputPath "lin_general.calc_dipole" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "false" ;
  ws:shortDescription "Calculate dipole"@en .
ws:Parameter_lin_general_calc_quadrupole a ws:Parameter ;
  rdfs:label "lin_general.calc_quadrupole" ;
  ws:inputPath "lin_general.calc_quadrupole" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Calculate quadrupole"@en .
ws:Parameter_lin_general_subspace_diag a ws:Parameter ;
  rdfs:label "lin_general.subspace_diag" ;
  ws:inputPath "lin_general.subspace_diag" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "false" ;
  ws:shortDescription "Diagonalization at the end"@en .
ws:Parameter_lin_general_extra_states a ws:Parameter ;
  rdfs:label "lin_general.extra_states" ;
  ws:inputPath "lin_general.extra_states" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0" ;
  ws:shortDescription "Number of extra states to include in support function and kernel optimization (dmin only), must be equal to norbsempty"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000.0"^^xsd:double .
ws:Parameter_lin_general_calculate_onsite_overlap a ws:Parameter ;
  rdfs:label "lin_general.calculate_onsite_overlap" ;
  ws:inputPath "lin_general.calculate_onsite_overlap" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Calculate the onsite overlap matrix (has only an effect if the matrices are all written to disk)"@en .
ws:Parameter_lin_general_charge_multipoles a ws:Parameter ;
  rdfs:label "lin_general.charge_multipoles" ;
  ws:inputPath "lin_general.charge_multipoles" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "0" ;
  ws:shortDescription "Calculate the atom-centered multipole coefficients; 0 no, 1 old approach Loewdin, 2 new approach Projector"@en ;
  ws:allowedValues "[0, 1, 11]" .
ws:Parameter_lin_general_check_multipoles a ws:Parameter ;
  rdfs:label "lin_general.check_multipoles" ;
  ws:inputPath "lin_general.check_multipoles" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Check the multipoles computed by computing the total dipole."@en .
ws:Parameter_lin_general_support_function_multipoles a ws:Parameter ;
  rdfs:label "lin_general.support_function_multipoles" ;
  ws:inputPath "lin_general.support_function_multipoles" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "false" ;
  ws:shortDescription "Calculate the multipole moments of the support functions"@en .
ws:Parameter_lin_general_plot_locreg_grids a ws:Parameter ;
  rdfs:label "lin_general.plot_locreg_grids" ;
  ws:inputPath "lin_general.plot_locreg_grids" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Plot the scaling function and wavelets grid of each localization region"@en .
ws:Parameter_lin_general_calculate_FOE_eigenvalues a ws:Parameter ;
  rdfs:label "lin_general.calculate_FOE_eigenvalues" ;
  ws:inputPath "lin_general.calculate_FOE_eigenvalues" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_observables ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0, -1]" ;
  ws:shortDescription "First and last eigenvalue to be calculated using the FOE procedure"@en .
ws:Parameter_lin_general_precision_FOE_eigenvalues a ws:Parameter ;
  rdfs:label "lin_general.precision_FOE_eigenvalues" ;
  ws:inputPath "lin_general.precision_FOE_eigenvalues" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.005" ;
  ws:shortDescription "Decay length of the error function used to extract the eigenvalues (i.e. something like the resolution)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "0.1"^^xsd:double .
ws:Parameter_lin_general_multipole_centers a ws:Parameter ;
  rdfs:label "lin_general.multipole_centers" ;
  ws:inputPath "lin_general.multipole_centers" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Determines whether the multipole centers shall be determined automatically (i.e. taking the atoms) or whether they are provided manually"@en .
ws:Parameter_lin_general_consider_entropy a ws:Parameter ;
  rdfs:label "lin_general.consider_entropy" ;
  ws:inputPath "lin_general.consider_entropy" ;
  ws:inSection ws:Section_lin_general ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Indicate whether the entropy contribution to the total energy shall be considered"@en .

ws:Section_lin_basis a ws:Section ; rdfs:label "lin_basis" .
ws:Parameter_lin_basis_nit a ws:Parameter ;
  rdfs:label "lin_basis.nit" ;
  ws:inputPath "lin_basis.nit" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "[4, 5]" ;
  ws:shortDescription "Maximal number of iterations in the optimization of the support functions"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double .
ws:Parameter_lin_basis_nit_ig a ws:Parameter ;
  rdfs:label "lin_basis.nit_ig" ;
  ws:inputPath "lin_basis.nit_ig" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "50" ;
  ws:shortDescription "maximal number of iterations to optimize the support functions in the extended input guess (experimental mode only)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double .
ws:Parameter_lin_basis_extended_ig a ws:Parameter ;
  rdfs:label "lin_basis.extended_ig" ;
  ws:inputPath "lin_basis.extended_ig" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "whether or not to do an extended input guess (will be activated by default in experimental mode)"@en .
ws:Parameter_lin_basis_orthogonalize_sfs a ws:Parameter ;
  rdfs:label "lin_basis.orthogonalize_sfs" ;
  ws:inputPath "lin_basis.orthogonalize_sfs" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "whether or not to explicitly orthogonalize SFs (will be activated by default except in experimental mode, and may eventually be automatically turned off)"@en .
ws:Parameter_lin_basis_idsx a ws:Parameter ;
  rdfs:label "lin_basis.idsx" ;
  ws:inputPath "lin_basis.idsx" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[6, 6]" ;
  ws:shortDescription "DIIS history for optimization of the support functions (low/high accuracy); 0 -> SD"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "20.0"^^xsd:double .
ws:Parameter_lin_basis_gnrm_cv a ws:Parameter ;
  rdfs:label "lin_basis.gnrm_cv" ;
  ws:inputPath "lin_basis.gnrm_cv" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0.01, 0.0001]" ;
  ws:shortDescription "Convergence criterion for the optimization of the support functions (low/high accuracy)"@en ;
  ws:lowerBound "1e-06"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_basis_gnrm_ig a ws:Parameter ;
  rdfs:label "lin_basis.gnrm_ig" ;
  ws:inputPath "lin_basis.gnrm_ig" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.001" ;
  ws:shortDescription "Convergence criterion for the optimization of the support functions in the extended input guess (experimental mode only)"@en ;
  ws:lowerBound "1e-05"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_basis_deltae_cv a ws:Parameter ;
  rdfs:label "lin_basis.deltae_cv" ;
  ws:inputPath "lin_basis.deltae_cv" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "Total relative energy difference to stop the optimization ('experimental_mode' only)"@en ;
  ws:lowerBound "1e-06"^^xsd:double ;
  ws:upperBound "0.1"^^xsd:double .
ws:Parameter_lin_basis_gnrm_dyn a ws:Parameter ;
  rdfs:label "lin_basis.gnrm_dyn" ;
  ws:inputPath "lin_basis.gnrm_dyn" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "Dynamic convergence criterion ('experimental_mode' only)"@en ;
  ws:lowerBound "1e-07"^^xsd:double ;
  ws:upperBound "0.1"^^xsd:double .
ws:Parameter_lin_basis_min_gnrm_for_dynamic a ws:Parameter ;
  rdfs:label "lin_basis.min_gnrm_for_dynamic" ;
  ws:inputPath "lin_basis.min_gnrm_for_dynamic" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.001" ;
  ws:shortDescription "Minimal gnrm to active the dynamic gnrm criterion"@en ;
  ws:lowerBound "1e-07"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_basis_alpha_diis a ws:Parameter ;
  rdfs:label "lin_basis.alpha_diis" ;
  ws:inputPath "lin_basis.alpha_diis" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Multiplicator for DIIS"@en ;
  ws:lowerBound "0.1"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_basis_alpha_sd a ws:Parameter ;
  rdfs:label "lin_basis.alpha_sd" ;
  ws:inputPath "lin_basis.alpha_sd" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Initial step size for SD"@en ;
  ws:lowerBound "0.0001"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_basis_nstep_prec a ws:Parameter ;
  rdfs:label "lin_basis.nstep_prec" ;
  ws:inputPath "lin_basis.nstep_prec" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "5" ;
  ws:shortDescription "Number of iterations in the preconditioner"@en ;
  ws:lowerBound "1.0"^^xsd:double ;
  ws:upperBound "30.0"^^xsd:double .
ws:Parameter_lin_basis_fix_basis a ws:Parameter ;
  rdfs:label "lin_basis.fix_basis" ;
  ws:inputPath "lin_basis.fix_basis" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-10" ;
  ws:shortDescription "Fix the support functions if the density change is below this threshold"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1e-06"^^xsd:double .
ws:Parameter_lin_basis_correction_orthoconstraint a ws:Parameter ;
  rdfs:label "lin_basis.correction_orthoconstraint" ;
  ws:inputPath "lin_basis.correction_orthoconstraint" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1" ;
  ws:shortDescription "Correction for the slight non-orthonormality in the orthoconstraint"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_basis_orthogonalize_ao a ws:Parameter ;
  rdfs:label "lin_basis.orthogonalize_ao" ;
  ws:inputPath "lin_basis.orthogonalize_ao" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "true" ;
  ws:shortDescription "Orthogonalize the atomic orbitals used as input guess"@en .
ws:Parameter_lin_basis_reset_DIIS_history a ws:Parameter ;
  rdfs:label "lin_basis.reset_DIIS_history" ;
  ws:inputPath "lin_basis.reset_DIIS_history" ;
  ws:inSection ws:Section_lin_basis ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Reset the DIIS history when starting the loop which optimizes the support functions"@en .

ws:Section_lin_kernel a ws:Section ; rdfs:label "lin_kernel" .
ws:Parameter_lin_kernel_nstep a ws:Parameter ;
  rdfs:label "lin_kernel.nstep" ;
  ws:inputPath "lin_kernel.nstep" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[1, 1]" ;
  ws:shortDescription "Number of steps taken when updating the coefficients via direct minimization for each iteration of the density kernel loop"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_kernel_nit a ws:Parameter ;
  rdfs:label "lin_kernel.nit" ;
  ws:inputPath "lin_kernel.nit" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "[5, 5]" ;
  ws:shortDescription "Number of iterations in the (self-consistent) optimization of the density kernel"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_kernel_idsx_coeff a ws:Parameter ;
  rdfs:label "lin_kernel.idsx_coeff" ;
  ws:inputPath "lin_kernel.idsx_coeff" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0, 0]" ;
  ws:shortDescription "DIIS history for direct mininimization - warning, there is currently a problem for idsx_coeff/=0"@en .
ws:Parameter_lin_kernel_idsx a ws:Parameter ;
  rdfs:label "lin_kernel.idsx" ;
  ws:inputPath "lin_kernel.idsx" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0, 0]" ;
  ws:shortDescription "Mixing method; 0 -> linear mixing, >=1 -> Pulay mixing"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "20.0"^^xsd:double .
ws:Parameter_lin_kernel_alphamix a ws:Parameter ;
  rdfs:label "lin_kernel.alphamix" ;
  ws:inputPath "lin_kernel.alphamix" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0.5, 0.5]" ;
  ws:shortDescription "Mixing parameter (low/high accuracy)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_kernel_gnrm_cv_coeff a ws:Parameter ;
  rdfs:label "lin_kernel.gnrm_cv_coeff" ;
  ws:inputPath "lin_kernel.gnrm_cv_coeff" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[1e-05, 1e-05]" ;
  ws:shortDescription "Convergence criterion on the gradient for direct minimization"@en .
ws:Parameter_lin_kernel_rpnrm_cv a ws:Parameter ;
  rdfs:label "lin_kernel.rpnrm_cv" ;
  ws:inputPath "lin_kernel.rpnrm_cv" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[1e-10, 1e-10]" ;
  ws:shortDescription "Convergence criterion (change in density/potential) for the kernel optimization"@en ;
  ws:lowerBound "1e-14"^^xsd:double ;
  ws:upperBound "1e-05"^^xsd:double .
ws:Parameter_lin_kernel_linear_method a ws:Parameter ;
  rdfs:label "lin_kernel.linear_method" ;
  ws:inputPath "lin_kernel.linear_method" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"DIAG\"" ;
  ws:shortDescription "Method to optimize the density kernel"@en ;
  ws:allowedValues "[\"DIRMIN\", \"DIAG\", \"NTPOLY\", \"FOE\"]" .
ws:Parameter_lin_kernel_mixing_method a ws:Parameter ;
  rdfs:label "lin_kernel.mixing_method" ;
  ws:inputPath "lin_kernel.mixing_method" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"DEN\"" ;
  ws:shortDescription "Quantity to be mixed"@en ;
  ws:allowedValues "[\"DEN\", \"POT\"]" .
ws:Parameter_lin_kernel_alpha_sd_coeff a ws:Parameter ;
  rdfs:label "lin_kernel.alpha_sd_coeff" ;
  ws:inputPath "lin_kernel.alpha_sd_coeff" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.2" ;
  ws:shortDescription "Initial step size for SD for direct minimization"@en .
ws:Parameter_lin_kernel_alpha_fit_coeff a ws:Parameter ;
  rdfs:label "lin_kernel.alpha_fit_coeff" ;
  ws:inputPath "lin_kernel.alpha_fit_coeff" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Update the SD step size by fitting a quadratic polynomial"@en .
ws:Parameter_lin_kernel_coeff_scaling_factor a ws:Parameter ;
  rdfs:label "lin_kernel.coeff_scaling_factor" ;
  ws:inputPath "lin_kernel.coeff_scaling_factor" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Factor to scale the gradient in direct minimization"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_kernel_delta_pnrm a ws:Parameter ;
  rdfs:label "lin_kernel.delta_pnrm" ;
  ws:inputPath "lin_kernel.delta_pnrm" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "-1.0" ;
  ws:shortDescription "Stop the kernel optimization if the density/potential difference has decreased by this factor (deactivated if -1.0)"@en ;
  ws:lowerBound "-1.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_lin_kernel_diag_start a ws:Parameter ;
  rdfs:label "lin_kernel.diag_start" ;
  ws:inputPath "lin_kernel.diag_start" ;
  ws:inSection ws:Section_lin_kernel ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "whether or not to diagonalize the SF Hamiltonian at the beginning of a restart calculation (useful for (pseudo-)fragment calculations)"@en .

ws:Section_lin_basis_params a ws:Section ; rdfs:label "lin_basis_params" .
ws:Parameter_lin_basis_params_nbasis a ws:Parameter ;
  rdfs:label "lin_basis_params.nbasis" ;
  ws:inputPath "lin_basis_params.nbasis" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "4" ;
  ws:shortDescription "Number of support functions per atom"@en .
ws:Parameter_lin_basis_params_ao_confinement a ws:Parameter ;
  rdfs:label "lin_basis_params.ao_confinement" ;
  ws:inputPath "lin_basis_params.ao_confinement" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0083" ;
  ws:shortDescription "Prefactor for the input guess confining potential"@en ;
  ws:lowerBound "-1.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_basis_params_confinement a ws:Parameter ;
  rdfs:label "lin_basis_params.confinement" ;
  ws:inputPath "lin_basis_params.confinement" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "[0.0083, 0.0]" ;
  ws:shortDescription "Prefactor for the confining potential (low/high accuracy)"@en ;
  ws:lowerBound "-1.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_lin_basis_params_rloc a ws:Parameter ;
  rdfs:label "lin_basis_params.rloc" ;
  ws:inputPath "lin_basis_params.rloc" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "[7.0, 7.0]" ;
  ws:shortDescription "Localization radius for the support functions"@en ;
  ws:lowerBound "2.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_basis_params_rloc_kernel a ws:Parameter ;
  rdfs:label "lin_basis_params.rloc_kernel" ;
  ws:inputPath "lin_basis_params.rloc_kernel" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "9.0" ;
  ws:shortDescription "Localization radius for the density kernel"@en ;
  ws:lowerBound "2.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .
ws:Parameter_lin_basis_params_rloc_kernel_foe a ws:Parameter ;
  rdfs:label "lin_basis_params.rloc_kernel_foe" ;
  ws:inputPath "lin_basis_params.rloc_kernel_foe" ;
  ws:inSection ws:Section_lin_basis_params ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "14.0" ;
  ws:shortDescription "Cutoff radius for the FOE matrix vector multiplications"@en ;
  ws:lowerBound "2.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double .

ws:Profile_bigdft_linear_accurate a ws:Profile ;
  rdfs:label "linear_accurate" ;
  ws:profileValues "{\"dft\": {\"hgrids\": 0.3, \"ixc\": \"PBE\", \"inputpsiid\": \"linear\"}, \"chess\": {\"foe\": {\"ef_interpol_chargediff\": 1.0}}, \"perf\": {\"experimental_mode\": true, \"correction_co_contra\": true}, \"lin_general\": {\"hybrid\": true, \"taylor_order\": 1015, \"max_inversion_error\": 5e-08}, \"lin_basis\": {\"nit\": 8, \"idsx\": 8, \"gnrm_cv\": 0.001, \"gnrm_dyn\": 0.0001, \"deltae_cv\": 5e-05, \"min_gnrm_for_dynamic\": 0.002, \"alpha_diis\": 0.5, \"alpha_sd\": 0.5, \"nstep_prec\": 6, \"fix_basis\": 1e-12, \"correction_orthoconstraint\": 0}, \"lin_kernel\": {\"nit\": 4, \"idsx\": 6, \"alphamix\": 0.1, \"rpnrm_cv\": [1e-12, 1e-12], \"linear_method\": \"FOE\"}, \"lin_basis_params\": {\"ao_confinement\": -1.0, \"confinement\": [-1.0, 0.0], \"rloc_kernel\": 10.0, \"rloc_kernel_foe\": 12.0, \"H\": {\"nbasis\": 1, \"rloc\": 5.0}, \"C\": {\"nbasis\": 4, \"rloc\": 5.5}, \"N\": {\"nbasis\": 4, \"rloc\": 5.5}, \"O\": {\"nbasis\": 4, \"rloc\": 5.5}, \"P\": {\"nbasis\": 4, \"rloc\": 6.0}, \"S\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Cl\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Na\": {\"nbasis\": 1, \"rloc\": 7.5}, \"K\": {\"nbasis\": 1, \"rloc\": 8.0}, \"Sn\": {\"nbasis\": 4, \"rloc\": 6.5}}}" ;
  rdfs:comment "Appropriate input parameters for a high accuracy linear scaling calculation"@en ;
  ws:sets ws:Parameter_dft_hgrids ;
  ws:sets ws:Parameter_dft_ixc ;
  ws:sets ws:Parameter_dft_inputpsiid ;
  ws:sets ws:Parameter_perf_experimental_mode ;
  ws:sets ws:Parameter_perf_correction_co_contra ;
  ws:sets ws:Parameter_lin_general_hybrid ;
  ws:sets ws:Parameter_lin_general_taylor_order ;
  ws:sets ws:Parameter_lin_general_max_inversion_error ;
  ws:sets ws:Parameter_lin_basis_nit ;
  ws:sets ws:Parameter_lin_basis_idsx ;
  ws:sets ws:Parameter_lin_basis_gnrm_cv ;
  ws:sets ws:Parameter_lin_basis_gnrm_dyn ;
  ws:sets ws:Parameter_lin_basis_deltae_cv ;
  ws:sets ws:Parameter_lin_basis_min_gnrm_for_dynamic ;
  ws:sets ws:Parameter_lin_basis_alpha_diis ;
  ws:sets ws:Parameter_lin_basis_alpha_sd ;
  ws:sets ws:Parameter_lin_basis_nstep_prec ;
  ws:sets ws:Parameter_lin_basis_fix_basis ;
  ws:sets ws:Parameter_lin_basis_correction_orthoconstraint ;
  ws:sets ws:Parameter_lin_kernel_nit ;
  ws:sets ws:Parameter_lin_kernel_idsx ;
  ws:sets ws:Parameter_lin_kernel_alphamix ;
  ws:sets ws:Parameter_lin_kernel_rpnrm_cv ;
  ws:sets ws:Parameter_lin_kernel_linear_method ;
  ws:sets ws:Parameter_lin_basis_params_ao_confinement ;
  ws:sets ws:Parameter_lin_basis_params_confinement ;
  ws:sets ws:Parameter_lin_basis_params_rloc_kernel ;
  ws:sets ws:Parameter_lin_basis_params_rloc_kernel_foe .
ws:Profile_bigdft_linear_moderate a ws:Profile ;
  rdfs:label "linear_moderate" ;
  ws:profileValues "{\"dft\": {\"hgrids\": 0.3, \"ixc\": \"PBE\", \"inputpsiid\": \"linear\"}, \"chess\": {\"foe\": {\"ef_interpol_chargediff\": 1.0}}, \"perf\": {\"experimental_mode\": true, \"correction_co_contra\": true}, \"lin_general\": {\"hybrid\": true, \"taylor_order\": 10}, \"lin_basis\": {\"nit\": [10, 10], \"gnrm_cv\": [0.002, 0.002], \"gnrm_dyn\": 0.0002, \"deltae_cv\": 5e-05, \"min_gnrm_for_dynamic\": 0.004, \"alpha_diis\": 0.5, \"alpha_sd\": 0.5, \"nstep_prec\": 6, \"fix_basis\": 1e-11, \"correction_orthoconstraint\": 0}, \"lin_kernel\": {\"nit\": [3, 3], \"idsx\": [6, 6], \"alphamix\": [0.2, 0.2], \"rpnrm_cv\": [1e-11, 1e-11], \"linear_method\": \"FOE\"}, \"lin_basis_params\": {\"ao_confinement\": -1.0, \"confinement\": [-1.0, 0.0], \"rloc_kernel\": 10.0, \"rloc_kernel_foe\": 12.0, \"H\": {\"nbasis\": 1, \"rloc\": 5.0}, \"C\": {\"nbasis\": 4, \"rloc\": 5.5}, \"N\": {\"nbasis\": 4, \"rloc\": 5.5}, \"O\": {\"nbasis\": 4, \"rloc\": 5.5}, \"P\": {\"nbasis\": 4, \"rloc\": 6.0}, \"S\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Cl\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Na\": {\"nbasis\": 1, \"rloc\": 7.5}, \"K\": {\"nbasis\": 1, \"rloc\": 8.0}, \"Sn\": {\"nbasis\": 4, \"rloc\": 6.5}}}" ;
  rdfs:comment "Appropriate input parameters for a moderate accuracy linear scaling calculation"@en ;
  ws:sets ws:Parameter_dft_hgrids ;
  ws:sets ws:Parameter_dft_ixc ;
  ws:sets ws:Parameter_dft_inputpsiid ;
  ws:sets ws:Parameter_perf_experimental_mode ;
  ws:sets ws:Parameter_perf_correction_co_contra ;
  ws:sets ws:Parameter_lin_general_hybrid ;
  ws:sets ws:Parameter_lin_general_taylor_order ;
  ws:sets ws:Parameter_lin_basis_nit ;
  ws:sets ws:Parameter_lin_basis_gnrm_cv ;
  ws:sets ws:Parameter_lin_basis_gnrm_dyn ;
  ws:sets ws:Parameter_lin_basis_deltae_cv ;
  ws:sets ws:Parameter_lin_basis_min_gnrm_for_dynamic ;
  ws:sets ws:Parameter_lin_basis_alpha_diis ;
  ws:sets ws:Parameter_lin_basis_alpha_sd ;
  ws:sets ws:Parameter_lin_basis_nstep_prec ;
  ws:sets ws:Parameter_lin_basis_fix_basis ;
  ws:sets ws:Parameter_lin_basis_correction_orthoconstraint ;
