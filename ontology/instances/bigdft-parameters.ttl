ws:Profile_bigdft_linear a ws:Profile ;
  rdfs:label "linear" ;
  ws:profileValues "{\"dft\": {\"disablesym\": true, \"inputpsiid\": \"linear\"}, \"chess\": {\"foe\": {\"ef_interpol_chargediff\": 1.0, \"eval_range_foe\": [-1.0, 1.0], \"fscale\": 0.05}}, \"perf\": {\"check_sumrho\": 0, \"check_overlap\": 0, \"experimental_mode\": true, \"calculate_KS_residue\": false, \"check_matrix_compression\": false, \"correction_co_contra\": true, \"store_index\": false, \"mixing_after_inputguess\": 0, \"kappa_conv\": 0.1, \"FOE_restart\": 1, \"hamapp_radius_incr\": 6}, \"lin_general\": {\"hybrid\": true, \"nit\": 50, \"taylor_order\": 1020, \"max_inversion_error\": 5e-08, \"rpnrm_cv\": 1e-11, \"output_mat\": 1, \"output_coeff\": 0, \"output_multipole_matrices\": false, \"charge_multipoles\": 11, \"check_multipoles\": false, \"calc_dipole\": true}, \"lin_basis\": {\"nit\": 8, \"idsx\": 4, \"gnrm_cv\": 0.002, \"deltae_cv\": 0.0001, \"min_gnrm_for_dynamic\": 0.004, \"alpha_diis\": 0.5, \"alpha_sd\": 0.5, \"nstep_prec\": 6, \"fix_basis\": 1e-12, \"correction_orthoconstraint\": 0, \"gnrm_ig\": 0.1, \"reset_DIIS_history\": true}, \"lin_kernel\": {\"nstep\": 10, \"nit\": 6, \"idsx_coeff\": 0, \"idsx\": 6, \"rpnrm_cv\": 1e-08, \"alphamix\": 0.1, \"linear_method\": \"FOE\", \"delta_pnrm\": 0.1}, \"lin_basis_params\": {\"ao_confinement\": -1.0, \"confinement\": [-1.0, 0.0], \"rloc_kernel\": 10.0, \"rloc_kernel_foe\": 12.0, \"H\": {\"nbasis\": 1, \"rloc\": 5.0}, \"Li\": {\"nbasis\": 1, \"rloc\": 5.5}, \"C\": {\"nbasis\": 4, \"rloc\": 5.5}, \"N\": {\"nbasis\": 4, \"rloc\": 5.5}, \"O\": {\"nbasis\": 4, \"rloc\": 5.5}, \"F\": {\"nbasis\": 4, \"rloc\": 5.5}, \"Si\": {\"nbasis\": 4, \"rloc\": 8.0}, \"P\": {\"nbasis\": 4, \"rloc\": 6.0}, \"S\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Cl\": {\"nbasis\": 4, \"rloc\": 6.0}, \"Na\": {\"nbasis\": 1, \"rloc\": 7.5}, \"K\": {\"nbasis\": 1, \"rloc\": 8.0}, \"Sn\": {\"nbasis\": 4, \"rloc\": 6.5}, \"Fe\": {\"nbasis\": 13, \"rloc\": 8.0}, \"Cu\": {\"nbasis\": 9, \"rloc\": 7.0}, \"W\": {\"nbasis\": 9, \"rloc\": 7.5}, \"Zn\": {\"nbasis\": 6, \"rloc\": 8.0}, \"Ca\": {\"nbasis\": 5, \"rloc\": 7.5}, \"Ni\": {\"nbasis\": 10, \"rloc\": 8.0}}, \"ig_occupation\": {\"Fe\": {\"3s\": 2.0, \"3p\": 6.0, \"3d\": {\"up\": 4.0, \"down\": 2.0}, \"4s\": 2.0, \"4p\": 0.0}, \"Cu\": {\"3d\": 10.0, \"4s\": 1.0, \"4p\": 0.0}, \"W\": {\"6s\": 2.0, \"5d\": 4.0, \"6p\": 0.0}, \"Zn\": {\"4s\": 2.0, \"3d\": 10.0}, \"Ni\": {\"3s\": 2.0, \"3p\": 6.0, \"3d\": 8.0, \"4s\": 2.0}}}" ;
  rdfs:comment "Linear parameters sufficient for PDoS, charge analysis, MD"@en ;
