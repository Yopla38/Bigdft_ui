ws:Section_chess_ntpoly a ws:Section ; rdfs:label "chess.ntpoly" .
ws:Parameter_chess_ntpoly_serial_io a ws:Parameter ;
  rdfs:label "chess.ntpoly.serial_io" ;
  ws:inputPath "chess.ntpoly.serial_io" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "turn on serial IO if MPI is having problem on a machine."@en .
ws:Parameter_chess_ntpoly_threshold_density a ws:Parameter ;
  rdfs:label "chess.ntpoly.threshold_density" ;
  ws:inputPath "chess.ntpoly.threshold_density" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "threshold for flushing small matrix values of the density matrix."@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double .
ws:Parameter_chess_ntpoly_convergence_density a ws:Parameter ;
  rdfs:label "chess.ntpoly.convergence_density" ;
  ws:inputPath "chess.ntpoly.convergence_density" ;
  ws:inSection ws:Section_chess_ntpoly ;
  ws:exposedIn ws:Block_accuracy ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-10" ;
