  ws:profileValues "{\"dft\": {\"inputpsiid\": \"linear_restart\"}, \"lin_basis\": {\"fix_basis\": 0.0, \"gnrm_cv\": 0.01, \"idsx\": 2, \"nit\": 4}, \"lin_general\": {\"hybrid\": false, \"kernel_restart_mode\": \"coeff\", \"nit\": [0, 200], \"rpnrm_cv\": 1e-08}, \"lin_kernel\": {\"alphamix\": 0.0, \"delta_pnrm\": -1, \"gnrm_cv_coeff\": 0.0001, \"linear_method\": \"DIRMIN\", \"nit\": 1, \"nstep\": 500, \"rpnrm_cv\": 1e-08}, \"perf\": {\"adjust_kernel_iterations\": false, \"adjust_kernel_threshold\": false}}" ;
