  ws:inSection ws:Section_kpt ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[1]" ;
  ws:shortDescription "Points for each segment of the Brillouin zone path"@en ;
  ws:dependsOn ws:Parameter_kpt_bands .
ws:Parameter_kpt_kptv a ws:Parameter ;
  rdfs:label "kpt.kptv" ;
  ws:inputPath "kpt.kptv" ;
  ws:inSection ws:Section_kpt ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[[0.0, 0.0, 0.0], [0.5, 0.5, 0.5]]" ;
  ws:shortDescription "K points defining each segment of the Brillouin zone path"@en ;
  ws:dependsOn ws:Parameter_kpt_bands .
ws:Parameter_kpt_ngranularity a ws:Parameter ;
  rdfs:label "kpt.ngranularity" ;
  ws:inputPath "kpt.ngranularity" ;
  ws:inSection ws:Section_kpt ;
  ws:exposedIn ws:Block_environment ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1" ;
  ws:shortDescription "No. of points done for each group"@en ;
  ws:lowerBound "1.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_kpt_bands .

ws:Section_geopt a ws:Section ; rdfs:label "geopt" .
ws:Parameter_geopt_method a ws:Parameter ;
  rdfs:label "geopt.method" ;
  ws:inputPath "geopt.method" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Geometry optimisation method"@en ;
  ws:allowedValues "[\"none\", \"SDCG\", \"VSSD\", \"LBFGS\", \"BFGS\", \"PBFGS\", \"AB6MD\", \"DIIS\", \"FIRE\", \"SOCK\", \"NEB\", \"SBFGS\", \"SQNM\", \"MD\", \"LOOP\"]" .
ws:Parameter_geopt_ncount_cluster_x a ws:Parameter ;
  rdfs:label "geopt.ncount_cluster_x" ;
  ws:inputPath "geopt.ncount_cluster_x" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "50" ;
  ws:shortDescription "Maximum number of force evaluations"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "2000.0"^^xsd:double .
ws:Parameter_geopt_sockinet a ws:Parameter ;
  rdfs:label "geopt.sockinet" ;
  ws:inputPath "geopt.sockinet" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1" ;
  ws:shortDescription "Socket either unix (0) or tcp (1)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_sockport a ws:Parameter ;
  rdfs:label "geopt.sockport" ;
  ws:inputPath "geopt.sockport" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "2121" ;
  ws:shortDescription "Socket port number"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_sockhost a ws:Parameter ;
  rdfs:label "geopt.sockhost" ;
  ws:inputPath "geopt.sockhost" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "\"127.0.0.1\"" ;
  ws:shortDescription "Socket host name"@en ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_frac_fluct a ws:Parameter ;
  rdfs:label "geopt.frac_fluct" ;
  ws:inputPath "geopt.frac_fluct" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Fraction of force fluctuations. Stop if fmax < forces_fluct*frac_fluct"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_geopt_forcemax a ws:Parameter ;
  rdfs:label "geopt.forcemax" ;
  ws:inputPath "geopt.forcemax" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Max forces criterion when stop"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_geopt_randdis a ws:Parameter ;
  rdfs:label "geopt.randdis" ;
  ws:inputPath "geopt.randdis" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Random displacement amplitude"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double .
ws:Parameter_geopt_betax a ws:Parameter ;
  rdfs:label "geopt.betax" ;
  ws:inputPath "geopt.betax" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "4.0" ;
  ws:shortDescription "Stepsize for the geometry optimization"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_history a ws:Parameter ;
  rdfs:label "geopt.history" ;
  ws:inputPath "geopt.history" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "4" ;
  ws:shortDescription "History for DIIS method"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_dtinit a ws:Parameter ;
  rdfs:label "geopt.dtinit" ;
  ws:inputPath "geopt.dtinit" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.75" ;
  ws:shortDescription "Initial time step for the FIRE method"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_dtmax a ws:Parameter ;
  rdfs:label "geopt.dtmax" ;
  ws:inputPath "geopt.dtmax" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.5" ;
  ws:shortDescription "Maximal time step for the FIRE method"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_nhistx a ws:Parameter ;
  rdfs:label "geopt.nhistx" ;
  ws:inputPath "geopt.nhistx" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "10" ;
  ws:shortDescription "Maximum history length"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_biomode a ws:Parameter ;
  rdfs:label "geopt.biomode" ;
  ws:inputPath "geopt.biomode" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "false" ;
  ws:shortDescription "Enable mode for biomolecules."@en ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_beta_stretchx a ws:Parameter ;
  rdfs:label "geopt.beta_stretchx" ;
  ws:inputPath "geopt.beta_stretchx" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.5" ;
  ws:shortDescription "Stepsize for steepest descent in stretching mode direction (only if in biomode)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double .
ws:Parameter_geopt_maxrise a ws:Parameter ;
  rdfs:label "geopt.maxrise" ;
  ws:inputPath "geopt.maxrise" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1e-06" ;
  ws:shortDescription "Maximum allowed rise in energy in one geopt step"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_cutoffratio a ws:Parameter ;
  rdfs:label "geopt.cutoffratio" ;
  ws:inputPath "geopt.cutoffratio" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "If ratio of eigenvalues of displacement overlapmatrix is smaller than cutoffratio, the corresponding directions are not used"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_steepthresh a ws:Parameter ;
  rdfs:label "geopt.steepthresh" ;
  ws:inputPath "geopt.steepthresh" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.1" ;
  ws:shortDescription "If fmax < steepthresh, geopt method uses steepest descent"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_trustr a ws:Parameter ;
  rdfs:label "geopt.trustr" ;
  ws:inputPath "geopt.trustr" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.5" ;
  ws:shortDescription "Maximum displacement of single atom"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "10000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_ionmov a ws:Parameter ;
  rdfs:label "geopt.ionmov" ;
  ws:inputPath "geopt.ionmov" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "6" ;
  ws:shortDescription "Movement ion method"@en ;
  ws:allowedValues "[6, 7, 8, 9, 12, 13]" ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_dtion a ws:Parameter ;
  rdfs:label "geopt.dtion" ;
  ws:inputPath "geopt.dtion" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "20.670689" ;
  ws:shortDescription "Time step - Atomic Units (20.670689 AU=0.5 fs)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_mditemp a ws:Parameter ;
  rdfs:label "geopt.mditemp" ;
  ws:inputPath "geopt.mditemp" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "300.0" ;
  ws:shortDescription "Temperature of molecular dynamics"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_mdftemp a ws:Parameter ;
  rdfs:label "geopt.mdftemp" ;
  ws:inputPath "geopt.mdftemp" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "300.0" ;
  ws:shortDescription "Final temperature of molecular dynamics"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_noseinert a ws:Parameter ;
  rdfs:label "geopt.noseinert" ;
  ws:inputPath "geopt.noseinert" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "100000.0" ;
  ws:shortDescription "Thermostat inertia coefficient for Nose_Hoover dynamics"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_friction a ws:Parameter ;
  rdfs:label "geopt.friction" ;
  ws:inputPath "geopt.friction" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.001" ;
  ws:shortDescription "Friction coefficient for Langevin dynamics"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_mdwall a ws:Parameter ;
  rdfs:label "geopt.mdwall" ;
  ws:inputPath "geopt.mdwall" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "10000.0" ;
  ws:shortDescription "Distance in bohr where atoms can bounce for Langevin dynamics"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_qmass a ws:Parameter ;
  rdfs:label "geopt.qmass" ;
  ws:inputPath "geopt.qmass" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0.0]" ;
  ws:shortDescription "Mass of each thermostat (isothermal/isenthalpic ensemble)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_bmass a ws:Parameter ;
  rdfs:label "geopt.bmass" ;
  ws:inputPath "geopt.bmass" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "10.0" ;
  ws:shortDescription "Barostat masses (isothermal/isenthalpic ensemble)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_vmass a ws:Parameter ;
  rdfs:label "geopt.vmass" ;
  ws:inputPath "geopt.vmass" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Barostat masses (isothermal/isenthalpic ensemble)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000000000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_ionmov .
ws:Parameter_geopt_climbing a ws:Parameter ;
  rdfs:label "geopt.climbing" ;
  ws:inputPath "geopt.climbing" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "false" ;
  ws:shortDescription "Make the highest energy image to climb along the path"@en ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_extrema_opt a ws:Parameter ;
  rdfs:label "geopt.extrema_opt" ;
  ws:inputPath "geopt.extrema_opt" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Minimize the energy of extremum images during NEB optimization"@en ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_neb_method a ws:Parameter ;
  rdfs:label "geopt.neb_method" ;
  ws:inputPath "geopt.neb_method" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "\"quick-min\"" ;
  ws:shortDescription "Image minimization method"@en ;
  ws:allowedValues "[\"steepest_descent\", \"fletcher-reeves\", \"polak-ribiere\", \"quick-min\", \"damped-verlet\", \"sim-annealing\"]" ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_temp a ws:Parameter ;
  rdfs:label "geopt.temp" ;
  ws:inputPath "geopt.temp" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0" ;
  ws:shortDescription "Temperature for simulated annealing"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_neb_method .
ws:Parameter_geopt_damp a ws:Parameter ;
  rdfs:label "geopt.damp" ;
  ws:inputPath "geopt.damp" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1.0" ;
  ws:shortDescription "Damping factor"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_neb_method .
ws:Parameter_geopt_springs_k a ws:Parameter ;
  rdfs:label "geopt.springs_k" ;
  ws:inputPath "geopt.springs_k" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "[0.05, 0.1]" ;
  ws:shortDescription "Maximum and minimum value when changing spring constant during optimization"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "1000.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_fix_tol a ws:Parameter ;
  rdfs:label "geopt.fix_tol" ;
  ws:inputPath "geopt.fix_tol" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "0.0001" ;
  ws:shortDescription "Tolerance to apply on atom moves between extrema"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .
ws:Parameter_geopt_nimg a ws:Parameter ;
  rdfs:label "geopt.nimg" ;
  ws:inputPath "geopt.nimg" ;
  ws:inSection ws:Section_geopt ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "15" ;
  ws:shortDescription "Number of images"@en ;
  ws:lowerBound "3.0"^^xsd:double ;
  ws:upperBound "100.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_geopt_method .

ws:Section_md a ws:Section ; rdfs:label "md" .
ws:Parameter_md_mdsteps a ws:Parameter ;
  rdfs:label "md.mdsteps" ;
  ws:inputPath "md.mdsteps" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "0" ;
  ws:shortDescription "Number of MD steps"@en ;
  ws:lowerBound "0.0"^^xsd:double .
ws:Parameter_md_print_frequency a ws:Parameter ;
  rdfs:label "md.print_frequency" ;
  ws:inputPath "md.print_frequency" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "1" ;
  ws:shortDescription "Printing frequency for energy.dat and Trajectory.xyz files"@en ;
  ws:lowerBound "1.0"^^xsd:double ;
  ws:upperBound "999999.0"^^xsd:double .
ws:Parameter_md_temperature a ws:Parameter ;
  rdfs:label "md.temperature" ;
  ws:inputPath "md.temperature" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "300.0" ;
  ws:shortDescription "Initial temperature in Kelvin"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "9999999.0"^^xsd:double .
ws:Parameter_md_timestep a ws:Parameter ;
  rdfs:label "md.timestep" ;
  ws:inputPath "md.timestep" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "20.0" ;
  ws:shortDescription "Time step for integration (in a.u.)"@en ;
  ws:lowerBound "0.0"^^xsd:double ;
  ws:upperBound "99999.0"^^xsd:double .
ws:Parameter_md_no_translation a ws:Parameter ;
  rdfs:label "md.no_translation" ;
  ws:inputPath "md.no_translation" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "false" ;
  ws:shortDescription "Logical input to set translational correction"@en .
ws:Parameter_md_thermostat a ws:Parameter ;
  rdfs:label "md.thermostat" ;
  ws:inputPath "md.thermostat" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_essential ;
  ws:defaultValue "\"none\"" ;
  ws:shortDescription "Activates a thermostat for MD"@en ;
  ws:allowedValues "[\"none\", \"nose_hoover_chain\"]" .
ws:Parameter_md_nose_chain_length a ws:Parameter ;
  rdfs:label "md.nose_chain_length" ;
  ws:inputPath "md.nose_chain_length" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_advanced ;
  ws:defaultValue "3" ;
  ws:shortDescription "Length of the Nose-Hoover Chains (integer input)"@en ;
  ws:lowerBound "2.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_md_thermostat .
ws:Parameter_md_nose_mts_size a ws:Parameter ;
  rdfs:label "md.nose_mts_size" ;
  ws:inputPath "md.nose_mts_size" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "1" ;
  ws:shortDescription "Multiple time steps used to integrate Nose-Hoover Chains equations of motion (integer input)"@en ;
  ws:lowerBound "1.0"^^xsd:double ;
  ws:upperBound "10.0"^^xsd:double ;
  ws:dependsOn ws:Parameter_md_thermostat .
ws:Parameter_md_nose_yoshida_factor a ws:Parameter ;
  rdfs:label "md.nose_yoshida_factor" ;
  ws:inputPath "md.nose_yoshida_factor" ;
  ws:inSection ws:Section_md ;
  ws:exposedIn ws:Block_task ;
  ws:hasTier ws:Tier_expert ;
  ws:defaultValue "7" ;
  ws:shortDescription "Yoshida-Suzuki order to integrate the Nose-Hoover Chains equations of motion (integer input)"@en ;
