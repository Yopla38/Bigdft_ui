  ws:profileValues "{\"lin_kernel\": {\"linear_method\": \"NTPOLY\"}, \"chess\": {\"ntpoly\": {\"threshold_density\": \"1e-6\", \"threshold_overlap\": \"1e-6\", \"convergence_density\": 0.0001, \"convergence_overlap\": 0.0}}}" ;
  rdfs:comment "Input parameters to turn on purification instead of chess"@en ;
