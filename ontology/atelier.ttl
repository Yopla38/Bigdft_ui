@prefix at:   <http://bigdft.org/atelier#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontologie de l'atelier : ce que l'interface doit savoir pour
# proposer des valeurs, les justifier et refuser les incohérences.
# Non instanciée : aom_ingest crée les noeuds à partir du corpus
# (ontology/corpus/) et de la documentation de BigDFT.
# Autoportante, comme l'exige le format AOM 1.0.1 : toute classe et
# toute propriété utilisée est déclarée ici, avec son rdfs:range.
#################################################################
at:OntologieAtelier a owl:Ontology ; rdfs:label "Ontologie de l'atelier de simulation"@fr ; rdfs:comment "Paramètres de BigDFT, briques de l'interface, traits des systèmes et règles de recommandation qui les relient."@fr ; owl:versionInfo "0.1" .

#################################################################
# 1. Ce que l'on règle
#################################################################
at:Brique a owl:Class ; rdfs:label "Brique"@fr ; rdfs:comment "Une des sept parties d'une recette : Matière, Théorie, Précision, Milieu, Action, Mesures, Machine."@fr .
at:Section a owl:Class ; rdfs:label "Section du fichier d'entrée"@fr ; rdfs:comment "Groupe de variables du fichier YAML de BigDFT, par exemple dft, kpt, geopt, psolver.environment."@fr .
at:Parametre a owl:Class ; rdfs:label "Paramètre"@fr ; rdfs:comment "Variable d'entrée de BigDFT, de PSolver ou de CheSS, telle que déclarée dans les fichiers input_variables_definition.yaml."@fr .
at:Profil a owl:Class ; rdfs:label "Profil"@fr ; rdfs:comment "Jeu nommé de valeurs fourni par BigDFT et appelé par le mot-clé import, par exemple linear ou mixing."@fr .
at:ActionPyBigDFT a owl:Class ; rdfs:label "Action PyBigDFT"@fr ; rdfs:comment "Fonction de BigDFT.InputActions qui règle un ou plusieurs paramètres. Noeud artefact : le code de la fonction est conservé verbatim."@fr .

#################################################################
# 2. Ce que l'on simule
#################################################################
at:TraitDeSysteme a owl:Class ; rdfs:label "Trait de système"@fr ; rdfs:comment "Propriété d'un système qui oriente les réglages : nombre impair d'électrons, absence de gap, anion, biomolécule, interaction non covalente, grande taille."@fr .
at:ConditionAuxLimites a owl:Class ; rdfs:subClassOf at:TraitDeSysteme ; rdfs:label "Conditions aux limites"@fr ; rdfs:comment "Isolé, surface (périodique selon x et z, libre selon y) ou périodique."@fr .
at:TypeDeCalcul a owl:Class ; rdfs:label "Type de calcul"@fr ; rdfs:comment "Ce que l'on demande : énergie, relaxation, dynamique moléculaire, chemin de réaction, excitations, analyse en fragments."@fr .
at:Methode a owl:Class ; rdfs:label "Méthode"@fr ; rdfs:comment "Méthode physique ou numérique mobilisée : fonctionnelle, correction de dispersion, cavité de solvant, optimiseur, mode linéaire."@fr .
at:Observable a owl:Class ; rdfs:label "Observable"@fr ; rdfs:comment "Grandeur que l'on veut obtenir : énergie, forces, densité, orbitales, densité d'états, dipôle, charges atomiques."@fr .
at:Ressource a owl:Class ; rdfs:label "Ressource de calcul"@fr ; rdfs:comment "Cible d'exécution : conteneur CPU, noeud GPU, partition HPC."@fr .

#################################################################
# 3. Ce que l'on sait (relations n-aires : noeuds pivots)
#################################################################
at:Recommandation a owl:Class ; rdfs:label "Recommandation"@fr ; rdfs:comment "Pivot : pour un trait de système ou un type de calcul donné, un paramètre reçoit une valeur conseillée, avec sa justification."@fr .
at:Contrainte a owl:Class ; rdfs:label "Contrainte"@fr ; rdfs:comment "Pivot : combinaison impossible ou déconseillée, par exemple une correction disponible seulement en conditions isolées."@fr .
at:Reference a owl:Class ; rdfs:label "Référence bibliographique"@fr ; rdfs:comment "Article à citer lorsqu'une méthode est utilisée."@fr .

#################################################################
# 4. Ce que l'on a déjà fait
#################################################################
at:Recette a owl:Class ; rdfs:label "Recette"@fr ; rdfs:comment "Une simulation complète : un système et la valeur de chaque paramètre réglé, avec sa provenance."@fr .
at:Capsule a owl:Class ; rdfs:label "Capsule"@fr ; rdfs:comment "Session enregistrée d'un agent ou d'une personne : conversation, fichiers de travail et environnement figé, rejouable pas à pas."@fr .
at:EtapeDeCapsule a owl:Class ; rdfs:label "Étape de capsule"@fr ; rdfs:comment "Un pas d'une capsule. Noeud artefact : l'appel d'outil ou le message est conservé verbatim."@fr .

#################################################################
# 5. Propriétés entre noeuds
#################################################################
at:appartientA a owl:ObjectProperty ; rdfs:domain at:Parametre ; rdfs:range at:Section ; rdfs:label "appartient à"@fr .
at:exposeDans a owl:ObjectProperty ; rdfs:domain at:Parametre ; rdfs:range at:Brique ; rdfs:label "est exposé dans"@fr .
at:dependDe a owl:ObjectProperty ; rdfs:domain at:Parametre ; rdfs:range at:Parametre ; rdfs:label "n'a de sens que selon"@fr ; rdfs:comment "Condition d'activation déclarée dans la source (MASTER_KEY)."@fr .
at:fixe a owl:ObjectProperty ; rdfs:domain at:Profil ; rdfs:range at:Parametre ; rdfs:label "fixe"@fr .
at:regle a owl:ObjectProperty ; rdfs:domain at:ActionPyBigDFT ; rdfs:range at:Parametre ; rdfs:label "règle"@fr .
at:concerne a owl:ObjectProperty ; rdfs:domain at:Recommandation ; rdfs:range at:Parametre ; rdfs:label "concerne"@fr .
at:siSysteme a owl:ObjectProperty ; rdfs:domain at:Recommandation ; rdfs:range at:TraitDeSysteme ; rdfs:label "si le système est"@fr .
at:siCalcul a owl:ObjectProperty ; rdfs:domain at:Recommandation ; rdfs:range at:TypeDeCalcul ; rdfs:label "si le calcul est"@fr .
at:preconise a owl:ObjectProperty ; rdfs:domain at:Recommandation ; rdfs:range at:Methode ; rdfs:label "préconise"@fr .
at:porteSur a owl:ObjectProperty ; rdfs:domain at:Contrainte ; rdfs:range at:Methode ; rdfs:label "porte sur"@fr .
at:incompatibleAvec a owl:ObjectProperty ; rdfs:domain at:Contrainte ; rdfs:range at:TraitDeSysteme ; rdfs:label "incompatible avec"@fr .
at:activeePar a owl:ObjectProperty ; rdfs:domain at:Methode ; rdfs:range at:Parametre ; rdfs:label "est activée par"@fr .
at:aCiter a owl:ObjectProperty ; rdfs:domain at:Methode ; rdfs:range at:Reference ; rdfs:label "à citer"@fr .
at:produit a owl:ObjectProperty ; rdfs:domain at:TypeDeCalcul ; rdfs:range at:Observable ; rdfs:label "produit"@fr .
at:demandeePar a owl:ObjectProperty ; rdfs:domain at:Observable ; rdfs:range at:Parametre ; rdfs:label "est demandée par"@fr .
at:tourneSur a owl:ObjectProperty ; rdfs:domain at:Recette ; rdfs:range at:Ressource ; rdfs:label "tourne sur"@fr .
at:aboutitA a owl:ObjectProperty ; rdfs:domain at:Capsule ; rdfs:range at:Recette ; rdfs:label "aboutit à"@fr .
at:contientEtape a owl:ObjectProperty ; rdfs:domain at:Capsule ; rdfs:range at:EtapeDeCapsule ; rdfs:label "contient l'étape"@fr .
at:traite a owl:ObjectProperty ; rdfs:domain at:Capsule ; rdfs:range at:TypeDeCalcul ; rdfs:label "traite"@fr .

#################################################################
# 6. Propriétés à valeur littérale
#################################################################
at:nomVariable a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:string ; rdfs:label "nom dans le fichier d'entrée"@fr .
at:valeurParDefaut a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:string ; rdfs:label "valeur par défaut"@fr .
at:borneMin a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:double ; rdfs:label "borne inférieure"@fr .
at:borneMax a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:double ; rdfs:label "borne supérieure"@fr .
at:unite a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:string ; rdfs:label "unité"@fr .
at:niveau a owl:DatatypeProperty ; rdfs:domain at:Parametre ; rdfs:range xsd:string ; rdfs:label "niveau d'exposition"@fr ; rdfs:comment "essentiel, avancé ou expert."@fr .
at:valeurConseillee a owl:DatatypeProperty ; rdfs:domain at:Recommandation ; rdfs:range xsd:string ; rdfs:label "valeur conseillée"@fr .
at:justification a owl:DatatypeProperty ; rdfs:domain at:Recommandation ; rdfs:range xsd:string ; rdfs:label "justification"@fr .
at:raison a owl:DatatypeProperty ; rdfs:domain at:Contrainte ; rdfs:range xsd:string ; rdfs:label "raison"@fr .
at:doi a owl:DatatypeProperty ; rdfs:domain at:Reference ; rdfs:range xsd:string ; rdfs:label "DOI"@fr .
at:nombreAtomes a owl:DatatypeProperty ; rdfs:domain at:Recette ; rdfs:range xsd:integer ; rdfs:label "nombre d'atomes"@fr .
at:coeurHeures a owl:DatatypeProperty ; rdfs:domain at:Recette ; rdfs:range xsd:decimal ; rdfs:label "coût mesuré en coeur-heures"@fr .
