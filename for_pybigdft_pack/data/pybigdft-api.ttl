:Function_BigDFT_Fragments_interpolate_fragments a :Function ;
    rdfs:label "interpolate_fragments" ;
    rdfs:comment "Given two fragments A and B, this generates a list of Fragments\nthat interpolate between A and B in a specified number of steps.\n\nArgs:\n  A (BigDFT.Fragments.Fragment): starting fragment.\n  B (BigDFT.Fragments.Fragment): ending fragment.\n  steps (int): the number of steps to take between A and B.\n  extrapolation_steps (int): optionally, we can extrapolate a number of\n    steps beyond B on the same trajectory.\n\nReturns:\n  (list): a list of fragments interpolating between A and B including\n  A and B." ;
    :hasDescription "Given two fragments A and B, this generates a list of Fragments that interpolate between A and B in a specified number of steps." ;
    :definedIn :Module_BigDFT_Fragments ;
    :hasSignature "interpolate_fragments(A, B, steps, extrapolation_steps=0)" ;
    :hasArgument "A (required)" ;
    :hasArgument "B (required)" ;
    :hasArgument "steps (required)" ;
    :hasArgument "extrapolation_steps=0" .

:Function_BigDFT_Fragments_lineup_fragment a :Function ;
    rdfs:label "lineup_fragment" ;
    rdfs:comment "Align the principal axis of inertia of the fragments along the\ncoordinate axis. Also shift the fragment such as its centroid is zero.\n\nArgs:\n  (BigDFT.Fragments.Fragment): the fragment to transform.\n\nReturns:\n  (BigDFT.Fragments.Fragment): the transformed fragment." ;
    :hasDescription "Align the principal axis of inertia of the fragments along the coordinate axis. Also shift the fragment such as its centroid is zero." ;
    :definedIn :Module_BigDFT_Fragments ;
    :hasSignature "lineup_fragment(frag)" ;
    :hasArgument "frag (required)" .

:Function_BigDFT_Fragments_pairwise_distance a :Function ;
    rdfs:label "pairwise_distance" ;
    rdfs:comment "Distance between fragments, as defined by the distance between their two\nnearest atoms.\n\nArgs:\n  i (Fragment): first fragment.\n  j (Fragment): second fragment.\n  cell (array): an array describing the unit cell.\n\nReturns:\n  (float): the pairwise distance between fragments." ;
    :hasDescription "Distance between fragments, as defined by the distance between their two nearest atoms." ;
    :definedIn :Module_BigDFT_Fragments ;
    :hasSignature "pairwise_distance(i, j, cell=None)" ;
    :hasArgument "i (required)" ;
    :hasArgument "j (required)" ;
    :hasArgument "cell=None" .

