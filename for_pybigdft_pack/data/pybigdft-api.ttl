    :hasSignature "examine_system_dataframe(df, dist=None, view=None, fragment_forces=None)" ;
    :hasArgument "df (required)" ;
    :hasArgument "dist=None" ;
    :hasArgument "view=None" ;
    :hasArgument "fragment_forces=None" .

:Function_BigDFT_Systems_fragment_slicing_from_system_dataframe a :Function ;
    rdfs:label "fragment_slicing_from_system_dataframe" ;
    rdfs:comment "Define the slicing tuple needed to identify the fragment blocks\ninto a system dataframe\n\nArgs:\n    df (Dataframe): the system dataframe\n\nReturns:\n    dict: dictionary of the slicing obtained in form of [start,end] list" ;
    :hasDescription "Define the slicing tuple needed to identify the fragment blocks into a system dataframe" ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "fragment_slicing_from_system_dataframe(df)" ;
    :hasArgument "df (required)" .

:Function_BigDFT_Systems_lineup_system a :Function ;
    rdfs:label "lineup_system" ;
    rdfs:comment "Align the principal axis of inertia of a system along the\ncoordinate axis. Also shift the system such as its centroid is zero.\n\nArgs:\n  (BigDFT.Systems.System): the system to transform.\n\nReturns:\n  (BigDFT.Systems.System): the transformed system." ;
    :hasDescription "Align the principal axis of inertia of a system along the coordinate axis. Also shift the system such as its centroid is zero." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "lineup_system(sys)" ;
    :hasArgument "sys (required)" .

:Function_BigDFT_Systems_plot_fragment_information a :Function ;
    rdfs:label "plot_fragment_information" ;
    rdfs:comment "Often times we want to plot measures related to the different fragments\nin a system. For this routine, you can pass a dictionary mapping\nfragment ids to some kind of value. This routine takes care of the\nformatting of the axis to easily read the different fragment names.\n\nArgs:\n  axs (matplotlib.Axes): an axes object to plot on.\n  datadict (dict): a dictionary from fragment ids to some kind of data\n    value.\n  colordict (dict): optionally, a dictionary from fragment ids to a\n    color value." ;
    :hasDescription "Often times we want to plot measures related to the different fragments in a system. For this routine, you can pass a dictionary mapping fragment ids to some kind of value. This routine takes care of the formatting of the axis to easily read the different fragment names." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "plot_fragment_information(axs, datadict, colordict=None)" ;
    :hasArgument "axs (required)" ;
    :hasArgument "datadict (required)" ;
    :hasArgument "colordict=None" .

:Function_BigDFT_Systems_point_particle_objects a :Function ;
    rdfs:label "point_particle_objects" ;
    rdfs:comment "Return the dictionary of the point particle quantities from a\nSystems' dataframe" ;
    :hasDescription "Return the dictionary of the point particle quantities from a Systems' dataframe" ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "point_particle_objects(df)" ;
    :hasArgument "df (required)" .

:Function_BigDFT_Systems_select_from_view a :Function ;
    rdfs:label "select_from_view" ;
    rdfs:comment "Identify the fragments of the view that contain\nat least one of the targets\n\nArgs:\n    view (dict): if present, identifies the fragments that contain the\n        relevant units\n    targets (list): list of the fragments to search in the view\nReturns:\n    list: fragments to select" ;
    :hasDescription "Identify the fragments of the view that contain at least one of the targets" ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "select_from_view(view, targets)" ;
    :hasArgument "view (required)" ;
    :hasArgument "targets (required)" .

:Function_BigDFT_Systems_system_from_df a :Function ;
    rdfs:label "system_from_df" ;
    rdfs:comment "System instance from system dataframe.\n\nReturns a System from a dataframe. Useful to reconstruct a\ndataframe-serialized system in case one needs to extract quantities of\nrelevance.\n\nArgs:\n    df (pandas.DataFrame): the System Dataframe as returned usually from\n        `py:func:System.df` property.\n\nReturns:\n    System: the instance derived from the dataframe." ;
    :hasDescription "System instance from system dataframe." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "system_from_df(df)" ;
    :hasArgument "df (required)" .

:Function_BigDFT_Systems_system_from_dict_positions a :Function ;
    rdfs:label "system_from_dict_positions" ;
    rdfs:comment "Build a system from a set of positions from a dictionary whose yaml\nserialisation is compliant with the BigDFT yaml position format\n\nArgs:\n   posinp (list): list of the atomic specifications\nReturns:\n   BigDFT.Systems.System: an instance of the system class.\n      The employed fragment specification is specified in the file." ;
    :hasDescription "Build a system from a set of positions from a dictionary whose yaml serialisation is compliant with the BigDFT yaml position format" ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "system_from_dict_positions(posinp, units='angstroem')" ;
    :hasArgument "posinp (required)" ;
    :hasArgument "units='angstroem'" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_5fb8fd409fbe> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_c77befd3bc39> .

:Function_BigDFT_Systems_system_from_log a :Function ;
    rdfs:label "system_from_log" ;
    rdfs:comment "This function returns a :class:`~BigDFT.Fragment.System` class out of a\nlogfile. If the logfile contains information about fragmentation and atomic\nmultipoles, then the system is created accordingly.\nOtherwise, the fragmentation scheme is determined by the fragmentation\nvariable.\n\nArgs:\n   log (Logfile): the logfile of the QM run. In general must have been done\n       with Linear Scaling formalism.\n   fragmentation (str): the scheme to be used for the fragmentation in the\n       case if not provided internally by the logfile.\n       The possible values are ``atomic`` and ``full``, in which case the\n       system as as many fragments as the number of atoms, or only one\n       fragment, respectively.\nReturns:\n    (BigDFT.Systems.System): The instance of the class containing\n    fragments." ;
    :hasDescription "This function returns a :class:`~BigDFT.Fragment.System` class out of a logfile. If the logfile contains information about fragmentation and atomic multipoles, then the system is created accordingly. Otherwise, the fragmentation scheme is determined by the fragmentation variable." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "system_from_log(log, fragmentation=None)" ;
    :hasArgument "log (required)" ;
    :hasArgument "fragmentation=None" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_5fb8fd409fbe> .

:Function_BigDFT_Systems_update_purity_and_bo a :Function ;
    rdfs:label "update_purity_and_bo" ;
    rdfs:comment "When merging fragments together, you will need to update the bond\norders and purity values. This can be done by using\n`run_compute_purity` and `compute_bond_orders`, but this process is\npotentially slow. In this function, we use the old bond orders and\npurity values for update, which is much faster.\n\nArguments:\n    mapping (dict): a dictionary where the keys are the new fragments\n      and the values are a list of old fragments that make up this\n      new fragment.\n    purity (dict): the old purity values of each fragment.\n    bo (dict): the old bond orders of each fragment.\n    charges (dict): the charges of each fragment (the sum of the\n      number of electrons).\n\nReturns:\n    (dict, dict): the new purity and bond order values." ;
    :hasDescription "When merging fragments together, you will need to update the bond orders and purity values. This can be done by using `run_compute_purity` and `compute_bond_orders`, but this process is potentially slow. In this function, we use the old bond orders and purity values for update, which is much faster." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "update_purity_and_bo(mapping, purity, bo, charges)" ;
    :hasArgument "mapping (required)" ;
    :hasArgument "purity (required)" ;
    :hasArgument "bo (required)" ;
    :hasArgument "charges (required)" .

:Function_BigDFT_Systems_validate_dataframe_representation a :Function ;
    rdfs:label "validate_dataframe_representation" ;
    rdfs:comment "Control if the units of the positions in the dataframe are in Bohr.\nUpdate the coordinate values if this is not so.\n\nArgs:\n    sys (BigDFT.System): System which provides the reference positions\n    df (pandas.DataFrame): system's dataframe" ;
    :hasDescription "Control if the units of the positions in the dataframe are in Bohr. Update the coordinate values if this is not so." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "validate_dataframe_representation(sys, df)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "df (required)" .

:Function_BigDFT_UnitCells_UnitCell_get_boundary_condition a :Function ;
    rdfs:label "get_boundary_condition" ;
    rdfs:comment "Get a string description of the boundary condition (i.e. free,\nsurface, wire, periodic)\n\nArgs:\n    units (str): the units to report the cell in.\n\nReturns:\n    (str): a string description of the boundary condition." ;
