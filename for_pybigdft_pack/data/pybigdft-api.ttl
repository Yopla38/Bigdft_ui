    :hasDescription "Function get_threshold of BigDFT.LRTDDFT (no docstring)." ;
    :definedIn :Module_BigDFT_LRTDDFT ;
    :hasSignature "get_threshold(pProj, th_energies, th_levels, tol)" ;
    :hasArgument "pProj (required)" ;
    :hasArgument "th_energies (required)" ;
