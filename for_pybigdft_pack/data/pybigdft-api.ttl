:Function_BigDFT_IO_read_mol2 a :Function ;
    rdfs:label "read_mol2" ;
    rdfs:comment "Read a system from a mol2 file.\n\nArgs:\n  ifile (TextIOBase): the file to read from.\n  disable_warnings (bool): whether to print warnings about possible file\n    issues.\n\nReturns:\n  (BigDFT.Systems.System): the system file." ;
    :hasDescription "Read a system from a mol2 file." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "read_mol2(ifile, disable_warnings=False)" ;
    :hasArgument "ifile (required)" ;
    :hasArgument "disable_warnings=False" .

:Function_BigDFT_IO_read_pdb a :Function ;
    rdfs:label "read_pdb" ;
    rdfs:comment "Read a system from a PDB file.\n\nArgs:\n  ifile (TextIOBase): the file to read from.\n  disable_warnings (bool): whether to print warnings about possible file\n      issues.\n  include_chain (bool): include the chain id if True\n  ignore_connectivity (bool): if True do not store the information about\n      the connectivity matrix.\n  ignore_unit_cell (bool): assumes free boundary conditions if true.\n\nWarning:\n   This will read in the connectivity information from the pdb as well.\n   However, a pdb file does not provide any information about the bond\n   order. Thus, the bond order of each bond will be set to one.\n\nReturns:\n  (BigDFT.Systems.System): the system file." ;
    :hasDescription "Read a system from a PDB file." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "read_pdb(ifile, include_chain=False, disable_warnings=False, ignore_connectivity=False, ignore_unit_cell=False)" ;
    :hasArgument "ifile (required)" ;
    :hasArgument "include_chain=False" ;
    :hasArgument "disable_warnings=False" ;
    :hasArgument "ignore_connectivity=False" ;
    :hasArgument "ignore_unit_cell=False" .

:Function_BigDFT_IO_read_xyz a :Function ;
    rdfs:label "read_xyz" ;
    rdfs:comment "Read a system from an xyz file. XYZ files do not contain any information\nabout fragments, so this routine will make each atom its own fragment.\n\nArgs:\n  ifile (TextIOBase): the file to read from.\n  fragmentation (str): either \"atomic\" or \"single\".\n\nReturns:\n  (BigDFT.Systems.System): the system file." ;
    :hasDescription "Read a system from an xyz file. XYZ files do not contain any information about fragments, so this routine will make each atom its own fragment." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "read_xyz(ifile, fragmentation='atomic')" ;
    :hasArgument "ifile (required)" ;
    :hasArgument "fragmentation='atomic'" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d37a38e696cf> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_e0ace20bb262> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_eec49a6c03fb> .

:Function_BigDFT_IO_reorder_fragments a :Function ;
    rdfs:label "reorder_fragments" ;
    :hasDescription "Function reorder_fragments of BigDFT.IO (no docstring)." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "reorder_fragments(frags)" ;
    :hasArgument "frags (required)" .

:Function_BigDFT_IO_write_mol2 a :Function ;
    rdfs:label "write_mol2" ;
    rdfs:comment "Write out a system to a string in the mol2 format.\n\nArgs:\n  system (BigDFT.Systems.System): the system to write.\n  ofile (TextIOBase): the output stream to write to.\nReturns:\n  (str): a string representation of the file." ;
    :hasDescription "Write out a system to a string in the mol2 format." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "write_mol2(system, ofile)" ;
    :hasArgument "system (required)" ;
    :hasArgument "ofile (required)" .

:Function_BigDFT_IO_write_pdb a :Function ;
    rdfs:label "write_pdb" ;
    rdfs:comment "Write out a system to a string in the pdb format.\n\nArgs:\n  system (BigDFT.Systems.System): the system to write.\n  ofile (TextIOBase): the output stream to write to." ;
    :hasDescription "Write out a system to a string in the pdb format." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "write_pdb(system, ofile)" ;
    :hasArgument "system (required)" ;
    :hasArgument "ofile (required)" .

:Function_BigDFT_IO_write_xyz a :Function ;
    rdfs:label "write_xyz" ;
    rdfs:comment "Write out a system to a file in the xyz format.\n\nArgs:\n  system (BigDFT.Systems.System): the system to write.\n  ofile (TextIOBase): the output stream to write to.\n  cell (list): the unit cell." ;
    :hasDescription "Write out a system to a file in the xyz format." ;
    :definedIn :Module_BigDFT_IO ;
    :hasSignature "write_xyz(system, ofile)" ;
    :hasArgument "system (required)" ;
    :hasArgument "ofile (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d37a38e696cf> .

:Function_BigDFT_InputActions_add_cdft_constraint a :Function ;
    rdfs:label "add_cdft_constraint" ;
    rdfs:comment "Include a cdft constraint into the SCF cycle.\n\nUseful for Linear scaling formalism.\n\nArgs:\n    constraint (BigDFT.CDFT.CDFTConstraint): the instantiated constraint\n    homo_per_fragment (dict):\n        integer representing the orbital id of the homo of any of the\n        fragments included in the constraint." ;
    :hasDescription "Include a cdft constraint into the SCF cycle." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "add_cdft_constraint(constraint=None, homo_per_fragment={})" ;
    :hasArgument "constraint=None" ;
    :hasArgument "homo_per_fragment={}" ;
    :calledAs "inp.add_cdft_constraint(...)" .

:Function_BigDFT_InputActions_add_empty_scf_orbitals a :Function ;
    rdfs:label "add_empty_scf_orbitals" ;
    rdfs:comment "Insert ``norbs`` empty orbitals in the scf procedure\n\nArgs:\n   norbs (int): Number of empty orbitals\n\nWarning:\n   In linear scaling case, this is only meaningful for the direct\n   minimization approach." ;
    :hasDescription "Insert ``norbs`` empty orbitals in the scf procedure" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "add_empty_scf_orbitals(norbs=10)" ;
    :hasArgument "norbs=10 → lin_general.extra_states, mix.norbsempty" ;
    :calledAs "inp.add_empty_scf_orbitals(norbs=10)" ;
    :writesInput "lin_general.extra_states = 10" ;
    :setsParameter :Parameter_lin_general_extra_states ;
    :writesInput "mix.norbsempty = 10" ;
    :setsParameter :Parameter_mix_norbsempty .

:Function_BigDFT_InputActions_apply_electric_field a :Function ;
    rdfs:label "apply_electric_field" ;
    rdfs:comment "Apply an external electric field on the system\n\nArgs:\n   electric (list, float): Values of the Electric Field in the three\n     directions. Might also be a scalar." ;
    :hasDescription "Apply an external electric field on the system" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "apply_electric_field(elecfield=[0, 0, 0.001])" ;
    :hasArgument "elecfield=[0, 0, 0.001] → dft.elecfield" ;
    :calledAs "inp.apply_electric_field(elecfield=[0, 0, 0.001])" ;
    :writesInput "dft.elecfield = [0, 0, 0.001]" ;
    :setsParameter :Parameter_dft_elecfield ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0d92b27b3bc7> .

:Function_BigDFT_InputActions_calculate_dipole a :Function ;
    rdfs:label "calculate_dipole" ;
    rdfs:comment "Extract the dipole moment from the total charge density.\n\nNote:\n  This function is useful for the linear scaling setup as the cubic\n  scaling approach always calculates the charge density multipoles." ;
    :hasDescription "Extract the dipole moment from the total charge density." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "calculate_dipole()" ;
    :calledAs "inp.calculate_dipole()" ;
    :writesInput "lin_general.calc_dipole = true" ;
    :setsParameter :Parameter_lin_general_calc_dipole .

:Function_BigDFT_InputActions_calculate_multipoles a :Function ;
    rdfs:label "calculate_multipoles" ;
    rdfs:comment "Calculate the multipoles on the atoms based on SF.\n\nArgs:\n    yes (bool): switch off the calculation if False." ;
    :hasDescription "Calculate the multipoles on the atoms based on SF." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "calculate_multipoles(yes=True)" ;
    :hasArgument "yes=True → lin_general.charge_multipoles (computed from it)" ;
    :calledAs "inp.calculate_multipoles(yes=True)" ;
    :writesInput "lin_general.charge_multipoles = 11" ;
    :setsParameter :Parameter_lin_general_charge_multipoles .

:Function_BigDFT_InputActions_calculate_pdos a :Function ;
    rdfs:label "calculate_pdos" ;
    rdfs:comment "Calculate the Partial Density of states.\n\nCalculate the data needed for Projected DoS on the set of\nLCAO input wavefunction in\nthe case of the Cubic-Scaling algorithm and onto the Support Functions\nin the case of the linear scaling." ;
    :hasDescription "Calculate the Partial Density of states." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "calculate_pdos()" ;
    :calledAs "inp.calculate_pdos()" ;
    :writesInput "dft.inputpsiid = 10" ;
    :setsParameter :Parameter_dft_inputpsiid .

:Function_BigDFT_InputActions_calculate_tddft_coupling_matrix a :Function ;
    rdfs:label "calculate_tddft_coupling_matrix" ;
    rdfs:comment "Perform a Casida TDDFT coupling matrix extraction.\n\nArgs:\n   tda (bool): when ``True``, Tamm-Dancoff approximation is used for the\n     extraction of the coupling matrix\n   rpa (bool): when ``False``, the calculation of the RPA term (the linear\n     response of the hartree potential) is switched off\n   fxc (bool): when ``False``, the calculation of the fxc term (the linear\n     response of the XC operator) is switched off.\n\nNote:\n   The arguments ``fxc`` and ``rpa`` should not be simultaneously\n   ``False``.\n\nWarning:\n   Presently the LR-TDDFT casida fxc is only available for LDA\n   functionals in ABINIT flavour." ;
    :hasDescription "Perform a Casida TDDFT coupling matrix extraction." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "calculate_tddft_coupling_matrix(tda=False, rpa=True, fxc=True)" ;
    :hasArgument "tda=False → tddft.tddft_approach (computed from it)" ;
    :hasArgument "rpa=True → output.coupling_matrix (computed from it)" ;
    :hasArgument "fxc=True → output.coupling_matrix (computed from it)" ;
    :calledAs "inp.calculate_tddft_coupling_matrix(tda=False, rpa=True, fxc=True)" ;
    :writesInput "output.coupling_matrix = \"complete\"" ;
    :setsParameter :Parameter_output_coupling_matrix ;
    :writesInput "tddft.tddft_approach = \"full\"" ;
    :setsParameter :Parameter_tddft_tddft_approach .

:Function_BigDFT_InputActions_change_data_directory a :Function ;
    rdfs:label "change_data_directory" ;
    rdfs:comment "Modify the name of the ``data-`` directory.\nUseful to grab the orbitals from another directory than the run name\n\nArgs:\n   name (str): the name of the run" ;
    :hasDescription "Modify the name of the ``data-`` directory. Useful to grab the orbitals from another directory than the run name" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "change_data_directory(name='')" ;
    :hasArgument "name='' → radical" ;
    :calledAs "inp.change_data_directory(name='')" ;
    :writesInput "radical = \"\"" ;
    :setsParameter :Parameter_radical .

:Function_BigDFT_InputActions_charge a :Function ;
    rdfs:label "charge" ;
    rdfs:comment "Charge the system\n\nArguments:\n    charge (int,float): value of the charge in units of *e* (the electron\n      has charge -1). Also accept floating point numbers." ;
    :hasDescription "Charge the system" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "charge(charge=-1)" ;
    :hasArgument "charge=-1 → dft.qcharge" ;
    :calledAs "inp.charge(charge=-1)" ;
    :writesInput "dft.qcharge = -1" ;
    :setsParameter :Parameter_dft_qcharge ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_3632e96e2724> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8e63561339da> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_f12ccdac8f92> .

:Function_BigDFT_InputActions_charge_and_polarize a :Function ;
    rdfs:label "charge_and_polarize" ;
    rdfs:comment "Charge the system by removing one electron. Assume that the original\n  system is closed shell, thus polarize." ;
    :hasDescription "Charge the system by removing one electron. Assume that the original system is closed shell, thus polarize." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "charge_and_polarize()" ;
    :calledAs "inp.charge_and_polarize()" ;
    :writesInput "dft.mpol = 1" ;
    :setsParameter :Parameter_dft_mpol ;
    :writesInput "dft.nspin = 2" ;
    :setsParameter :Parameter_dft_nspin ;
    :writesInput "dft.qcharge = 1" ;
    :setsParameter :Parameter_dft_qcharge .

:Function_BigDFT_InputActions_connect_run_data a :Function ;
    rdfs:label "connect_run_data" ;
    rdfs:comment "Associate the data of the run of a given logfile to the input\nby retrieving the data directory name of the logfile.\n\nArgs:\n   log (Logfile): instance of a Logfile class" ;
    :hasDescription "Associate the data of the run of a given logfile to the input by retrieving the data directory name of the logfile." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "connect_run_data(log=None)" ;
    :hasArgument "log=None" ;
    :calledAs "inp.connect_run_data(...)" .

:Function_BigDFT_InputActions_extract_virtual_states a :Function ;
    rdfs:label "extract_virtual_states" ;
    rdfs:comment "Extract a given number of empty states **after** the scf cycle.\n\nArgs:\n   davidson (bool): If set to ``True`` activates davidson calculation,\n       otherwise Trace Minimization of the Hamiltonian is employed.\n   norbv (int): Defines the total size of the virtual subspace,\n       which may be larger than nvirt." ;
    :hasDescription "Extract a given number of empty states **after** the scf cycle." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "extract_virtual_states(nvirt=8, davidson=False, norbv=None, itermax_virt=150)" ;
    :hasArgument "nvirt=8 → dft.norbv (its opposite), dft.nvirt" ;
    :hasArgument "davidson=False → dft.norbv (computed from it)" ;
    :hasArgument "norbv=None" ;
    :hasArgument "itermax_virt=150 → dft.itermax_virt" ;
    :calledAs "inp.extract_virtual_states(nvirt=8, davidson=False, norbv=None, itermax_virt=150)" ;
    :writesInput "dft.itermax_virt = 150" ;
    :setsParameter :Parameter_dft_itermax_virt ;
    :writesInput "dft.norbv = -8" ;
    :setsParameter :Parameter_dft_norbv ;
    :writesInput "dft.nvirt = 8" ;
    :setsParameter :Parameter_dft_nvirt ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_bf30c1d1507e> .

:Function_BigDFT_InputActions_load a :Function ;
    rdfs:label "load" ;
    rdfs:comment "Load a profile or list of profiles.\n\nArgs:\n   profile (str): profile to be loaded, if a single profile is employed.\n   profiles (list): profiles list to be loaded in subsequent order." ;
    :hasDescription "Load a profile or list of profiles." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "load(profile='', profiles=[])" ;
    :hasArgument "profile=''" ;
    :hasArgument "profiles=[]" ;
    :calledAs "inp.load(...)" .

:Function_BigDFT_InputActions_optimize_coefficients a :Function ;
    rdfs:label "optimize_coefficients" ;
    rdfs:comment "Methods for scf of the kernel coefficients.\n\nArgs:\n    nit (int): number of scf iterations\n    gnrm (float): convergence criterion on the residue" ;
    :hasDescription "Methods for scf of the kernel coefficients." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "optimize_coefficients(nit=1, gnrm=1e-05)" ;
    :hasArgument "nit=1 → lin_kernel.nstep" ;
    :hasArgument "gnrm=1e-05 → lin_kernel.gnrm_cv_coeff" ;
    :calledAs "inp.optimize_coefficients(nit=1, gnrm=1e-05)" ;
    :writesInput "lin_kernel.gnrm_cv_coeff = 1e-05" ;
    :setsParameter :Parameter_lin_kernel_gnrm_cv_coeff ;
    :writesInput "lin_kernel.nstep = 1" ;
    :setsParameter :Parameter_lin_kernel_nstep .

:Function_BigDFT_InputActions_optimize_geometry a :Function ;
    rdfs:label "optimize_geometry" ;
    rdfs:comment "Optimize the geometry of the system\n\nArgs:\n   nsteps (int): maximum number of atomic steps.\n   method (str): Geometry optimizer. Available keys:\n\n      * SDCG:   A combination of Steepest Descent and Conjugate Gradient\n\n      * VSSD:   Variable Stepsize Steepest Descent method\n\n      * LBFGS:  Limited-memory BFGS\n\n      * BFGS:   Broyden-Fletcher-Goldfarb-Shanno\n\n      * PBFGS:  Same as BFGS with an initial Hessian from a force field\n\n      * DIIS:   Direct inversion of iterative subspace\n\n      * FIRE:   Fast Inertial Relaxation Engine, described by Bitzek et al.\n\n      * SQNM:   Stabilized quasi-Newton minimzer\n   betax (float): the step size for the optimization method.\n      This stepsize is system dependent and it has therefore to be\n      determined for each system.\n   frac_fluct (float): Fraction of force fluctuations. Stop if\n      fmax < forces_fluct*frac_fluct.\n   forcemax (float): Max forces criterion when stop." ;
    :hasDescription "Optimize the geometry of the system" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "optimize_geometry(method='FIRE', nsteps=50, betax=4.0, frac_fluct=1.0, forcemax=0)" ;
    :hasArgument "method='FIRE' → geopt.method" ;
    :hasArgument "nsteps=50 → geopt.ncount_cluster_x" ;
    :hasArgument "betax=4.0 → geopt.betax" ;
    :hasArgument "frac_fluct=1.0 → geopt.frac_fluct" ;
    :hasArgument "forcemax=0 → geopt.forcemax" ;
    :calledAs "inp.optimize_geometry(method='FIRE', nsteps=50, betax=4.0, frac_fluct=1.0, forcemax=0)" ;
    :writesInput "geopt.betax = 4.0" ;
    :setsParameter :Parameter_geopt_betax ;
    :writesInput "geopt.forcemax = 0" ;
    :setsParameter :Parameter_geopt_forcemax ;
    :writesInput "geopt.frac_fluct = 1.0" ;
    :setsParameter :Parameter_geopt_frac_fluct ;
    :writesInput "geopt.method = \"FIRE\"" ;
    :setsParameter :Parameter_geopt_method ;
    :writesInput "geopt.ncount_cluster_x = 50" ;
    :setsParameter :Parameter_geopt_ncount_cluster_x ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_78e7e064413d> .

:Function_BigDFT_InputActions_optimize_kernel a :Function ;
    rdfs:label "optimize_kernel" ;
    rdfs:comment "Methods for scf of the density kernel.\n\nStrategies for the optimization of the kernel.\n\nArgs:\n    dynamic_convergence (bool): if False, the threshold for the\n         convergence of the kernel are not dynamically adjusted\n    nit (int): number of scf iterations\n    rpnrm (float): convergence criterion, change in density/potential\n    method (str): optimization method ('DIRMIN', 'DIAG', 'NTPOLY', 'FOE')\n    alphamix (float): mixing parameter" ;
    :hasDescription "Methods for scf of the density kernel." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "optimize_kernel(method='DIAG', dynamic_convergence=True, nit=5, rpnrm=1e-10, alphamix=0.5)" ;
    :hasArgument "method='DIAG' → lin_kernel.linear_method" ;
    :hasArgument "dynamic_convergence=True → lin_kernel.delta_prnm (computed from it), perf.adjust_kernel_iterations, perf.adjust_kernel_threshold" ;
    :hasArgument "nit=5 → lin_kernel.nit" ;
    :hasArgument "rpnrm=1e-10 → lin_kernel.rpnrm_cv" ;
    :hasArgument "alphamix=0.5 → lin_kernel.alphamix" ;
    :calledAs "inp.optimize_kernel(method='DIAG', dynamic_convergence=True, nit=5, rpnrm=1e-10, alphamix=0.5)" ;
    :writesInput "lin_kernel.alphamix = 0.5" ;
    :setsParameter :Parameter_lin_kernel_alphamix ;
    :writesInput "lin_kernel.linear_method = \"DIAG\"" ;
    :setsParameter :Parameter_lin_kernel_linear_method ;
    :writesInput "lin_kernel.nit = 5" ;
    :setsParameter :Parameter_lin_kernel_nit ;
    :writesInput "lin_kernel.rpnrm_cv = 1e-10" ;
    :setsParameter :Parameter_lin_kernel_rpnrm_cv .

:Function_BigDFT_InputActions_optimize_support_functions a :Function ;
    rdfs:label "optimize_support_functions" ;
    rdfs:comment "Methods for scf of the Support functions.\n\nArgs:\n    nit (int): number of scf iterations\n    gnrm (float): convergence criterion on the residue" ;
    :hasDescription "Methods for scf of the Support functions." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "optimize_support_functions(nit=1, gnrm=1e-06, diis_history=0)" ;
    :hasArgument "nit=1 → lin_basis.nit" ;
    :hasArgument "gnrm=1e-06 → lin_basis.gnrm_cv" ;
    :hasArgument "diis_history=0 → lin_basis.idsx" ;
    :calledAs "inp.optimize_support_functions(nit=1, gnrm=1e-06, diis_history=0)" ;
    :writesInput "lin_basis.gnrm_cv = 1e-06" ;
    :setsParameter :Parameter_lin_basis_gnrm_cv ;
    :writesInput "lin_basis.idsx = 0" ;
    :setsParameter :Parameter_lin_basis_idsx ;
    :writesInput "lin_basis.nit = 1" ;
    :setsParameter :Parameter_lin_basis_nit .

:Function_BigDFT_InputActions_read_orbitals_from_disk a :Function ;
    rdfs:label "read_orbitals_from_disk" ;
    rdfs:comment "Read the orbitals from data directory, if available.\n\nArgs:\n    mode (str): can be 'cubic' or 'linear'. In the first case,\n        orbitals are read as KS objects, whereas in the\n        second kernel (or coeffs) and support functions are\n        expressed." ;
    :hasDescription "Read the orbitals from data directory, if available." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "read_orbitals_from_disk(mode='cubic')" ;
    :hasArgument "mode='cubic'" ;
    :calledAs "inp.read_orbitals_from_disk(mode='cubic')" ;
    :writesInput "dft.inputpsiid = 2" ;
    :setsParameter :Parameter_dft_inputpsiid ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_4949e483cb32> .

:Function_BigDFT_InputActions_remove a :Function ;
    rdfs:label "remove" ;
    rdfs:comment "Remove action from the input dictionary.\n\nRemove an action from the input file, thereby restoring the **default**\nvalue, as if the action were not specified.\n\nArgs:\n   inp (dict): dictionary to remove the action from.\n   action (func): one of the actions of this module. It does not need to be\n   specified before, in which case it produces no effect.\n\nExample:\n   >>> from Calculators import SystemCalculator as C\n   >>> code=C()\n   >>> inp={}\n   >>> set_xc(inp,'PBE')\n   >>> write_orbitals_on_disk(inp)\n   >>> log=code.run(input=inp) # perform calculations\n   >>> remove(inp, write_orbitals_on_disk) #remove the action\n   >>> read_orbitals_from_disk(inp)\n   >>> # this will restart the scf from the previous orbitals\n   >>> log2=code.run(input=inp)" ;
    :hasDescription "Remove action from the input dictionary." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "remove(action)" ;
    :hasArgument "action (required)" ;
    :calledAs "inp.remove(...)" .

:Function_BigDFT_InputActions_set_atomic_positions a :Function ;
    rdfs:label "set_atomic_positions" ;
    :hasDescription "Insert the atomic positions as a part of the input dictionary" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_atomic_positions(posinp=None)" ;
    :hasArgument "posinp=None" ;
    :calledAs "inp.set_atomic_positions(posinp=None)" .

:Function_BigDFT_InputActions_set_dispersion_correction a :Function ;
    rdfs:label "set_dispersion_correction" ;
    rdfs:comment "Add Grimme's D3 correction to the energy and the forces\n\nWarning:\n    Only works with Free Boundary conditions" ;
    :hasDescription "Add Grimme's D3 correction to the energy and the forces" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_dispersion_correction()" ;
    :calledAs "inp.set_dispersion_correction()" ;
    :writesInput "dft.dispersion = 5" ;
    :setsParameter :Parameter_dft_dispersion ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0d92b27b3bc7> .

:Function_BigDFT_InputActions_set_electronic_temperature a :Function ;
    rdfs:label "set_electronic_temperature" ;
    :hasDescription "Define the electronic temperature, in AU (``kT``) or K (``T``)" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_electronic_temperature(kT=0.001, T=0)" ;
    :hasArgument "kT=0.001 → mix.tel" ;
    :hasArgument "T=0 → mix.tel (computed from it)" ;
    :calledAs "inp.set_electronic_temperature(kT=0.001, T=0)" ;
    :writesInput "mix.tel = 0.001" ;
    :setsParameter :Parameter_mix_tel ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0d92b27b3bc7> .

:Function_BigDFT_InputActions_set_external_potential a :Function ;
    rdfs:label "set_external_potential" ;
    rdfs:comment "Set the external potential to which the system is submitted outside the QM\nregion\n\nArgs:\n   mm_pot (dict): dictionary of the external potential which contains the\n      information on the counter-ions" ;
    :hasDescription "Set the external potential to which the system is submitted outside the QM region" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_external_potential(mm_pot)" ;
    :hasArgument "mm_pot (required)" ;
    :calledAs "inp.set_external_potential(...)" .

:Function_BigDFT_InputActions_set_hgrid a :Function ;
    rdfs:label "set_hgrid" ;
    rdfs:comment "Set the wavelet grid spacing.\n\nArgs:\n   hgrid (float,list): list of the grid spacings in the three directions.\n   It might also be a scalar, which implies the same spacing" ;
    :hasDescription "Set the wavelet grid spacing." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_hgrid(hgrids=0.4)" ;
    :hasArgument "hgrids=0.4 → dft.hgrids" ;
    :calledAs "inp.set_hgrid(hgrids=0.4)" ;
    :writesInput "dft.hgrids = 0.4" ;
    :setsParameter :Parameter_dft_hgrids ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0a567087a54d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_182ecc95f18d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_77952689a33e> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8e63561339da> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_b6431fe0ec3f> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d97dd4d90e3a> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_f12ccdac8f92> .

:Function_BigDFT_InputActions_set_implicit_solvent a :Function ;
    rdfs:label "set_implicit_solvent" ;
    rdfs:comment "Add an acqueous implicit solvent around the system with the\n    soft-sphere cavity method\n\nArgs:\n   itermax(int): maximum number of iteration of the\n       Generalized Poisson Solver\n   minres(float): minimum residue of the CG method to achieve\n       GPS convergence" ;
    :hasDescription "Add an acqueous implicit solvent around the system with the soft-sphere cavity method" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_implicit_solvent(itermax=20, minres=0.0001)" ;
    :hasArgument "itermax=20 → psolver.environment.itermax" ;
    :hasArgument "minres=0.0001 → psolver.environment.minres" ;
    :calledAs "inp.set_implicit_solvent(itermax=20, minres=0.0001)" ;
    :writesInput "psolver.environment.cavity = \"soft-sphere\"" ;
    :setsParameter :Parameter_psolver_environment_cavity ;
    :writesInput "psolver.environment.itermax = 20" ;
    :setsParameter :Parameter_psolver_environment_itermax ;
    :writesInput "psolver.environment.minres = 0.0001" ;
    :setsParameter :Parameter_psolver_environment_minres ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_e6334eb746ee> .

:Function_BigDFT_InputActions_set_kernel_guess a :Function ;
    rdfs:label "set_kernel_guess" ;
    rdfs:comment "Method for guessing the kernel at restart.\n\nArgs:\n    mode (str): Guessing method. Can be:\n       * kernel\n       * coefficients\n       * random\n       * diag\n       * weight\n       * ao\n       * full_kernel\n       * full_coefficients" ;
    :hasDescription "Method for guessing the kernel at restart." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_kernel_guess(mode='kernel')" ;
    :hasArgument "mode='kernel' → lin_general.kernel_restart_mode" ;
    :calledAs "inp.set_kernel_guess(mode='kernel')" ;
    :writesInput "lin_general.kernel_restart_mode = \"kernel\"" ;
    :setsParameter :Parameter_lin_general_kernel_restart_mode .

:Function_BigDFT_InputActions_set_linear_scaling a :Function ;
    rdfs:label "set_linear_scaling" ;
    :hasDescription "Activates the linear scaling mode" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_linear_scaling()" ;
    :calledAs "inp.set_linear_scaling()" ;
    :writesInput "dft.inputpsiid = \"linear\"" ;
    :setsParameter :Parameter_dft_inputpsiid ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_940db71e3fce> .

:Function_BigDFT_InputActions_set_mesh_sizes a :Function ;
    rdfs:label "set_mesh_sizes" ;
    rdfs:comment "Constrain the number of grid points in each direction.\nThis is useful when performing periodic system calculations with variable\ncells which need to be compared each other. In this way the number of\ndegrees of freedom is kept constant throughout the various simuilations.\n\nArgs:\n   ngrids (int,list): list of the number of mesh points in each direction.\n     Might be a scalar." ;
    :hasDescription "Constrain the number of grid points in each direction. This is useful when performing periodic system calculations with variable cells which need to be compared each other. In this way the number of degrees of freedom is kept constant throughout the various simuilations." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_mesh_sizes(ngrids=64)" ;
    :hasArgument "ngrids=64 → dft.ngrids" ;
    :calledAs "inp.set_mesh_sizes(ngrids=64)" ;
    :writesInput "dft.ngrids = 64" ;
    :setsParameter :Parameter_dft_ngrids .

:Function_BigDFT_InputActions_set_orbital_occupancy a :Function ;
    rdfs:label "set_orbital_occupancy" ;
    rdfs:comment "Control the occupation number of the KS orbitals.\n\nWith this funtionality one can fix the value of the occupation numbers of\nthe KS orbitals.\n\nArgs:\n   avg (dict): dictionary of the form {i: f} where i is an integer stating\n       the non-default value of the occupation number, for spin averaged\n       occupancy\n   up (dict): same as `avg` but for the up spin channel\n   down (dict): same as `avg` but for the down spin channel\n   kpoint (int): label of the kpoint associated to the occupancy" ;
    :hasDescription "Control the occupation number of the KS orbitals." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_orbital_occupancy(avg={}, up={}, down={}, kpoint=1)" ;
    :hasArgument "avg={}" ;
    :hasArgument "up={}" ;
    :hasArgument "down={}" ;
    :hasArgument "kpoint=1 → occupation (computed from it)" ;
    :calledAs "inp.set_orbital_occupancy(avg={}, up={}, down={}, kpoint=1)" ;
    :writesInput "occupation = \"{'K point 1': {}}\"" .

:Function_BigDFT_InputActions_set_psp_directory a :Function ;
    rdfs:label "set_psp_directory" ;
    rdfs:comment "Employs all the \"psppar.*\" files of the given directory as pseudopotentials\n\nArgs:\n   directory (str): path of the psppar directory" ;
    :hasDescription "Employs all the \"psppar.*\" files of the given directory as pseudopotentials" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_psp_directory(directory='.')" ;
    :hasArgument "directory='.'" ;
    :calledAs "inp.set_psp_directory(...)" .

:Function_BigDFT_InputActions_set_psp_file a :Function ;
    rdfs:label "set_psp_file" ;
    rdfs:comment "Employ the given PSP file for the provided element\n\nArgs:\n   filename (str): the path of the psp file\n   element(str): the element symbol for the PSP.\n       Employs the psp name if absent" ;
    :hasDescription "Employ the given PSP file for the provided element" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_psp_file(filename=None, element=None)" ;
    :hasArgument "filename=None" ;
    :hasArgument "element=None" ;
    :calledAs "inp.set_psp_file(...)" .

:Function_BigDFT_InputActions_set_random_inputguess a :Function ;
    rdfs:label "set_random_inputguess" ;
    :hasDescription "Input orbitals are initialized as random coefficients" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_random_inputguess()" ;
    :calledAs "inp.set_random_inputguess()" ;
    :writesInput "dft.inputpsiid = -2" ;
    :setsParameter :Parameter_dft_inputpsiid .

:Function_BigDFT_InputActions_set_rmult a :Function ;
    rdfs:label "set_rmult" ;
    rdfs:comment "Set the wavelet grid extension by modifying the multiplicative radii.\n\nArgs:\n   rmult (float,list): list of two values that have to be used for the\n     coarse and the fine resolution grid. It may also be a scalar.\n   coarse (float): if the argument ``rmult`` is not provided it sets the\n     coarse radius multiplier\n   fine (float): if the argument ``rmult`` is not provided it sets the fine\n     radius multiplier" ;
    :hasDescription "Set the wavelet grid extension by modifying the multiplicative radii." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_rmult(rmult=None, coarse=5.0, fine=8.0)" ;
    :hasArgument "rmult=None" ;
    :hasArgument "coarse=5.0 → dft.rmult[0]" ;
    :hasArgument "fine=8.0 → dft.rmult[1]" ;
    :calledAs "inp.set_rmult(rmult=None, coarse=5.0, fine=8.0)" ;
    :writesInput "dft.rmult = [5.0, 8.0]" ;
    :setsParameter :Parameter_dft_rmult ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d97dd4d90e3a> .

:Function_BigDFT_InputActions_set_scf_convergence a :Function ;
    rdfs:label "set_scf_convergence" ;
    rdfs:comment "Set the tolerance acceptance level for stopping the self-consistent\niterations. Useful both for LS and CS\n\nArgs:\n   gnrm (float): the tolerance level for the CS inner loop\n   rpnrm (float): residue for the density/or potential norm. Useful both\n       for CS and LS" ;
    :hasDescription "Set the tolerance acceptance level for stopping the self-consistent iterations. Useful both for LS and CS" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_scf_convergence(gnrm='default', rpnrm='default')" ;
    :hasArgument "gnrm='default' → dft.gnrm_cv" ;
    :hasArgument "rpnrm='default' → lin_general.rpnrm_cv, mix.rpnrm_cv" ;
    :calledAs "inp.set_scf_convergence(gnrm='default', rpnrm='default')" ;
    :writesInput "dft.gnrm_cv = \"default\"" ;
    :setsParameter :Parameter_dft_gnrm_cv ;
    :writesInput "lin_general.rpnrm_cv = \"default\"" ;
    :setsParameter :Parameter_lin_general_rpnrm_cv ;
    :writesInput "mix.rpnrm_cv = \"default\"" ;
    :setsParameter :Parameter_mix_rpnrm_cv ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_cdacf269201c> .

:Function_BigDFT_InputActions_set_scf_iterations a :Function ;
    rdfs:label "set_scf_iterations" ;
    rdfs:comment "Set the number of the iteration per loop\n\nArgs:\n   nit (int,list): integer of the number of iterations. Might be a scalar\n        or a list, up to length two. The first element of the list contains\n        the number of iterations of the direct minimization loop. if\n        ``nit`` is a scalar, only this contribution is taken into account.\n        The second element is the number of subspace iterations where the\n        hamiltonian is diagonalized in the subspace. For a LS calculation,\n        the number of iteration correspond to the levels of the outer loop." ;
    :hasDescription "Set the number of the iteration per loop" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_scf_iterations(nit=[50, 1])" ;
    :hasArgument "nit=[50, 1] → dft.itermax (computed from it), dft.nrepmax (computed from it), lin_general.nit" ;
    :calledAs "inp.set_scf_iterations(nit=[50, 1])" ;
    :writesInput "dft.itermax = 50" ;
    :setsParameter :Parameter_dft_itermax ;
    :writesInput "dft.nrepmax = 1" ;
    :setsParameter :Parameter_dft_nrepmax ;
    :writesInput "lin_general.nit = [50, 1]" ;
    :setsParameter :Parameter_lin_general_nit .

:Function_BigDFT_InputActions_set_scf_method a :Function ;
    rdfs:label "set_scf_method" ;
    rdfs:comment "Set the algorithm for scf.\n\nArgs:\n   method (str): The algoritm chosen. Might be different for the cubic (CS)\n     or linear scaling (LS) algorithm.\n     * dirmin: Direct minimization approach (only CS)\n     * mixing: Mixing scheme (only CS)\n     * hybrid: outer loop of the LS mode\n     * two_levels: two level of accuracy in the scf\n\n   mixing_on (str): May be ``\"density\"`` or ``\"potential\"`` in the\n     ``\"mixing\"`` case, decide to which quantity the mixing to be performed\n\n   mixing_scheme (str): May be:\n\n      * Pulay : DIIS mixing on the last 7 iterations\n\n      * Simple: Simple mixing\n\n      * Anderson: Anderson scheme\n\n      * Anderson2: Anderson scheme based on the two pervious iterations\n\n      * CG: Conjugate Gradient based on the minimum of the energy with\n            respect of the potential\n\nWarning:\n   Only the FOE method exhibit asymptotic linear scaling regime.\n\nTodo:\n   Check if the linear scaling case needs another input variable for the\n   mixing of the potential (density)" ;
    :hasDescription "Set the algorithm for scf." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_scf_method(method='dirmin', mixing_on='density', mixing_scheme='Pulay')" ;
    :hasArgument "method='dirmin'" ;
    :hasArgument "mixing_on='density'" ;
    :hasArgument "mixing_scheme='Pulay'" ;
    :calledAs "inp.set_scf_method(method='dirmin', mixing_on='density', mixing_scheme='Pulay')" ;
    :writesInput "nothing when called with its default arguments" .

:Function_BigDFT_InputActions_set_symmetry a :Function ;
    rdfs:label "set_symmetry" ;
    rdfs:comment "Set the symmetry detection for the charge density and the ionic forces and\nstressdef set_symmetry(inp,yes=True):\n\nArgs:\n   yes (bool): If ``False`` the symmetry detection is disabled" ;
    :hasDescription "Set the symmetry detection for the charge density and the ionic forces and stressdef set_symmetry(inp,yes=True):" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_symmetry(yes=True)" ;
    :hasArgument "yes=True → dft.disablesym (computed from it)" ;
    :calledAs "inp.set_symmetry(yes=True)" ;
    :writesInput "dft.disablesym = false" ;
    :setsParameter :Parameter_dft_disablesym .

:Function_BigDFT_InputActions_set_xc a :Function ;
    rdfs:label "set_xc" ;
    rdfs:comment "Set the exchange and correlation approximation\n\nArgs:\n   xc (str): the Acronym of the XC approximation\n\nTodo:\n   Insert the XC codes corresponding to ``libXC`` conventions" ;
    :hasDescription "Set the exchange and correlation approximation" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "set_xc(xc='PBE')" ;
    :hasArgument "xc='PBE' → dft.ixc" ;
    :calledAs "inp.set_xc(xc='PBE')" ;
    :writesInput "dft.ixc = \"PBE\"" ;
    :setsParameter :Parameter_dft_ixc ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0a567087a54d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_182ecc95f18d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_3632e96e2724> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_4949e483cb32> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_4b96ec8088d3> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_77952689a33e> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_78e7e064413d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8732f3f5421d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8e63561339da> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_940db71e3fce> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_b6431fe0ec3f> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_bf30c1d1507e> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d6f6eae07786> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d97dd4d90e3a> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_dd92f39d71c0> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_e6334eb746ee> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_f12ccdac8f92> .

:Function_BigDFT_InputActions_spin_polarize a :Function ;
    rdfs:label "spin_polarize" ;
    rdfs:comment "Add a collinear spin polarization to the system.\n\nArguments:\n   mpol (int): spin polarization in Bohr magneton units." ;
    :hasDescription "Add a collinear spin polarization to the system." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "spin_polarize(mpol=1)" ;
    :hasArgument "mpol=1 → dft.mpol" ;
    :calledAs "inp.spin_polarize(mpol=1)" ;
    :writesInput "dft.mpol = 1" ;
    :setsParameter :Parameter_dft_mpol ;
    :writesInput "dft.nspin = 2" ;
    :setsParameter :Parameter_dft_nspin ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_3632e96e2724> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_b6431fe0ec3f> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_f12ccdac8f92> .

:Function_BigDFT_InputActions_use_gpu_acceleration a :Function ;
    rdfs:label "use_gpu_acceleration" ;
    rdfs:comment "Employ gpu acceleration when available, for convolutions and Fock operator\n\nTodo:\n   Verify what happens when only one of the functionality is enabled at\n   compile-time" ;
    :hasDescription "Employ gpu acceleration when available, for convolutions and Fock operator" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "use_gpu_acceleration()" ;
    :calledAs "inp.use_gpu_acceleration()" ;
    :writesInput "perf.accel = \"OCLGPU\"" ;
    :setsParameter :Parameter_perf_accel ;
    :writesInput "psolver.setup.accel = \"CUDA\"" ;
    :setsParameter :Parameter_psolver_setup_accel .

:Function_BigDFT_InputActions_write_cubefiles_around_fermi_level a :Function ;
    rdfs:label "write_cubefiles_around_fermi_level" ;
    rdfs:comment "Writes the ``nplot`` orbitals around the fermi level in cube format.\n\nArgs:\n  nplot (int): the number of orbitals to print around the fermi level.\n\nWarning:\n   This would work only for the cubic scaling code at present." ;
    :hasDescription "Writes the ``nplot`` orbitals around the fermi level in cube format." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "write_cubefiles_around_fermi_level(nplot=1)" ;
    :hasArgument "nplot=1 → dft.nplot" ;
    :calledAs "inp.write_cubefiles_around_fermi_level(nplot=1)" ;
    :writesInput "dft.nplot = 1" ;
    :setsParameter :Parameter_dft_nplot ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_fbfe5297dec3> .

:Function_BigDFT_InputActions_write_density_on_disk a :Function ;
    rdfs:label "write_density_on_disk" ;
    :hasDescription "Write the charge density on the disk after the last scf convergence" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "write_density_on_disk()" ;
    :calledAs "inp.write_density_on_disk()" ;
    :writesInput "dft.output_denspot = 21" ;
