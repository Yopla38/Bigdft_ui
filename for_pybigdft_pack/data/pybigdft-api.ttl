    :hasSignature "display_cell(cell)" ;
    :hasArgument "cell (required)" .

:Function_BigDFT_Visualization_InlineVisualizer_display_system a :Function ;
    rdfs:label "display_system" ;
    rdfs:comment "Display an animation of a sequence of systems. The colordict can be\nused to color each fragment. When only one system is passed it\nwill remain still.\n\nArgs:\n  syslist (BigDFT.Systems.System): the systems to visualize.\n  colordict (dict): a dictionary from fragment ids to hex colors,\n     can also be a list of dicts (one for each system) if using a grid.\n  field_vals(list): values of the field to decide colors of the keys\n  cartoon (bool): set to True to use the cartoon view. This only works\n    if atom names and residues are properly defined.\n  gridlist (list): if present, defines the row and column indices for\n    visualizing multiple systems on a grid.\n  show (bool): you can explicitly defer showing." ;
    :hasDescription "Display an animation of a sequence of systems. The colordict can be used to color each fragment. When only one system is passed it will remain still." ;
    :methodOf :Class_BigDFT_Visualization_InlineVisualizer ;
    :hasSignature "display_system(*syslist, **kwargs)" ;
    :hasArgument "syslist (required)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_Visualization_VMDGenerator_visualize_fragments a :Function ;
    rdfs:label "visualize_fragments" ;
    rdfs:comment "This generates a script for visualizing the fragmentation of a\nsystem using VMD.\n\nArgs:\n  system (BigDFT.Systems.System): the system to visualize.\n  scriptfile (str): the name of the file to write the vmd script\n    to (usually has extension .tcl)\n  geomfile (str): the filename for where to write an xyz file\n    of the system.\n  fragcolors (dict): optionally, a dictionary from fragment ids to\n    fragment colors. Colors are integers between 0 and 32." ;
    :hasDescription "This generates a script for visualizing the fragmentation of a system using VMD." ;
    :methodOf :Class_BigDFT_Visualization_VMDGenerator ;
    :hasSignature "visualize_fragments(system, scriptfile, geomfile, fragcolors=None)" ;
    :hasArgument "system (required)" ;
    :hasArgument "scriptfile (required)" ;
    :hasArgument "geomfile (required)" ;
    :hasArgument "fragcolors=None" .

