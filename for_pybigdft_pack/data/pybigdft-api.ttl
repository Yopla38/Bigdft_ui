:Function_BigDFT_Calculators_Runner_get_global_option a :Function ;
    rdfs:label "get_global_option" ;
    rdfs:comment "Get one key in global options. The key must exist.\nUseful to force implementation of compulsory options when subclassing.\n\nArgs:\n   key (string): the global option key\n\nReturns:\n    The value of the global options labelled by ``key``" ;
    :hasDescription "Get one key in global options. The key must exist. Useful to force implementation of compulsory options when subclassing." ;
    :methodOf :Class_BigDFT_Calculators_Runner ;
    :hasSignature "get_global_option(key)" ;
    :hasArgument "key (required)" .

