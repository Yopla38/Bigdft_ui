:Function_BigDFT_InputActions_write_orbitals_on_disk a :Function ;
    rdfs:label "write_orbitals_on_disk" ;
    rdfs:comment "Set the code to write the orbitals on disk in the provided format\n\nArgs:\n  format (str): The format to write the orbitals with. Accepts the strings:\n     * 'binary'\n     * 'text'\n     * 'etsf' (requires etsf-io enabled)\n\nTodo:\n  Verify if this option works for a linear scaling calulation." ;
    :hasDescription "Set the code to write the orbitals on disk in the provided format" ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "write_orbitals_on_disk(format='binary')" ;
    :hasArgument "format='binary' → output.orbitals" ;
    :calledAs "inp.write_orbitals_on_disk(format='binary')" ;
    :writesInput "output.orbitals = \"binary\"" ;
    :setsParameter :Parameter_output_orbitals ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_fbfe5297dec3> .

:Function_BigDFT_InputActions_write_support_function_matrices a :Function ;
    rdfs:label "write_support_function_matrices" ;
    rdfs:comment "Write the matrices of the linear scaling formats.\n\nArgs:\n   format (str): The format to write the orbitals with. Accepts the\n     strings:\n      * 'binary'\n      * 'text'\n\nTodo:\n   Verify if the binary format is available and set the appropriate values" ;
    :hasDescription "Write the matrices of the linear scaling formats." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "write_support_function_matrices(format='text')" ;
    :hasArgument "format='text' → lin_general.output_mat (computed from it)" ;
    :calledAs "inp.write_support_function_matrices(format='text')" ;
    :writesInput "lin_general.output_mat = 1" ;
    :setsParameter :Parameter_lin_general_output_mat .

:Function_BigDFT_InputActions_write_support_functions_on_disk a :Function ;
    rdfs:label "write_support_functions_on_disk" ;
    rdfs:comment "Dump the support functions.\n\nWrite the support function which are expressed in wavelet basis in the\ncode as files at the end of the calculation.\n\nArgs:\n    format (str): the format of the data, can be 'text', 'ETSF' or 'binary'\n         or one of the allowed codes of the `output_wf` key." ;
    :hasDescription "Dump the support functions." ;
    :definedIn :Module_BigDFT_InputActions ;
    :hasSignature "write_support_functions_on_disk(format='text')" ;
    :hasArgument "format='text' → lin_general.output_wf" ;
    :calledAs "inp.write_support_functions_on_disk(format='text')" ;
    :writesInput "lin_general.output_wf = \"text\"" ;
    :setsParameter :Parameter_lin_general_output_wf .

:Function_BigDFT_Interop_BabelInterop_compute_fingerprint a :Function ;
    rdfs:label "compute_fingerprint" ;
    rdfs:comment "Computes the fingerprint for a particular fragment.\n\nArgs:\n  sys (BigDFT.Systems.System): the fragment to compute the\n    representation of.\n  fps (str): the type of finger print to compute.\n\nReturn:\n  (openbabel.OBFingerprint): a fingerprint for this fragment." ;
