    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "BioSystemSerialization(biosys, version=None)" ;
    :hasArgument "biosys (required)" ;
    :hasArgument "version=None" .

:Class_BigDFT_BioQM_Graph a :PythonClass ;
    rdfs:label "Graph" ;
    rdfs:comment "A Graph representation of a System or a subportion of it.\n\nIdentify the connectivity of the system given a threshold, possibly\nrestricted to a subset of fragments\nArgs:\n   cutoff (float) : the threshold of the cumulative fragment bond order\n    that is applied to define the connectivity\n   restrict_to (list): list of the fragment id to which calculate\n    the connectivity\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature.\n\nMethods and properties: display." ;
    :hasDescription "A Graph representation of a System or a subportion of it." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "Graph(fragkeys, bond_orders, frag_labels, cutoff=0.01, restrict_to=None)" ;
    :hasArgument "fragkeys (required)" ;
    :hasArgument "bond_orders (required)" ;
    :hasArgument "frag_labels (required)" ;
    :hasArgument "cutoff=0.01" ;
    :hasArgument "restrict_to=None" .

:Class_BigDFT_BioQM_Sequence a :PythonClass ;
