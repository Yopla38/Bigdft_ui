    rdfs:label "interactions" ;
    :hasDescription "Property interactions of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.interactions  (a property: read it, do not call it)" .

