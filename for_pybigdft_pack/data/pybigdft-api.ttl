    rdfs:label "ks_matrix" ;
    :hasDescription "Property ks_matrix of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.ks_matrix  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_labeldict a :Function ;
    rdfs:label "labeldict" ;
    rdfs:comment "Label the fragments with a recognizable string.\n\nThis function returns a dictionary to label the fragments\nof the system in a way that can be employed in plots or graphs.\n\nArgs:\n    shift (dict): dictionary of the shifts to be applied to each chain\n        from the first residue ID, with keys corresponding to the ID of\n        the chain to be shifted. Useful for sequence alignment.\n    mappable (func): function that returns a string from a system's\n        fragment name.\n    labels (dict): dictionary of explicit lables to be given to\n        each fragment. Overrides all the other options for the\n        indicated fragments.\n    view (dict): a System fragments' view. If present, fragment names\n        are concatenated unless specified otherwise in `mappable` and\n        `label`.\n    joinchar (str): character to be used to join labels in case of\n        a view.\n    fmt (list): list indicating the characters that concatenate the\n        residue attributes. The list should indicate \"ch\", \"res\", and\n        \"num\" as the chain, residue name and number, respectively.\n        \"letter\" can also be provided in case this is available.\n\nReturns:\n    dict: A dictionary of the considered fragments with\n        the corresponding names as strings." ;
    :hasDescription "Label the fragments with a recognizable string." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "labeldict(labels={}, shift={}, mappable=None, fmt=['num'], view=None, joinchar='+')" ;
    :hasArgument "labels={}" ;
    :hasArgument "shift={}" ;
    :hasArgument "mappable=None" ;
    :hasArgument "fmt=['num']" ;
    :hasArgument "view=None" ;
    :hasArgument "joinchar='+'" .

:Function_BigDFT_BioQM_BioSystem_override_fragment_association a :Function ;
    rdfs:label "override_fragment_association" ;
    rdfs:comment "Force the association of the fragment provided by the fragment_names\nlist into the data represented by the new_names.\nNew names should be provided as 'Ch-RES:num' where ``Ch`` is the chain,\n``RES`` is the aminoacid residue at the position ``num``.\n\nArgs:\n   fragments_names(list): list of the fragments to be reassociated.\n       Should be present in the unmatched_fragment list.\n   new_names(list): list of the new names to be produced,\n       in fragment_names element order.\n       If absent, the fragment names are employed." ;
    :hasDescription "Force the association of the fragment provided by the fragment_names list into the data represented by the new_names. New names should be provided as 'Ch-RES:num' where ``Ch`` is the chain, ``RES`` is the aminoacid residue at the position ``num``." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "override_fragment_association(fragment_names, new_names=None)" ;
    :hasArgument "fragment_names (required)" ;
    :hasArgument "new_names=None" .

:Function_BigDFT_BioQM_BioSystem_purities a :Function ;
    rdfs:label "purities" ;
    :hasDescription "Property purities of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.purities  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_refragment a :Function ;
    rdfs:label "refragment" ;
    rdfs:comment "Identify the system's fragmentation and represent it in terms of the\nsystems' residues.\nEmploys the user defined cutoff to find the correct fragmentation\n\nArgs:\n    cutoff (float): cutoff employed for the refragmentation\n    view (dict): the view to be imposed as a starting\n        fragmentation in the system" ;
    :hasDescription "Identify the system's fragmentation and represent it in terms of the systems' residues. Employs the user defined cutoff to find the correct fragmentation" ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "refragment(cutoff=0.05, view=None)" ;
    :hasArgument "cutoff=0.05" ;
    :hasArgument "view=None" .

:Function_BigDFT_BioQM_BioSystem_refragmentation_colordict a :Function ;
    rdfs:label "refragmentation_colordict" ;
    rdfs:comment "Define a colordict that associates the fragment which go together\nwith the same color and put to white all the previously pure fragments.\n\nArgs:\n   refrag_keys (list): Keys of the refragmented system\n   **kwargs: keyword arguments of the initial colordict\n\nReturns:\n   dict: the dictionary of the colors (equal color means same fragment)" ;
    :hasDescription "Define a colordict that associates the fragment which go together with the same color and put to white all the previously pure fragments." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "refragmentation_colordict(refrag_keys, **kwargs)" ;
    :hasArgument "refrag_keys (required)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystem_represent a :Function ;
    rdfs:label "represent" ;
    rdfs:comment "Represent all the data of the systems, both in with the sequence\nand with the scatterplot. Useful only when there is data to be\nrepresented.\n\nArgs:\n   with3d (bool): if True represent the 3d vision of the system\n   errors (list): the errors of the field_vals in the order\n       of fragment_names\n   **kwargs: the same arguments of the `py:meth:colordict` method\n\nReturns:\n   list: list fo the axis of the plot" ;
    :hasDescription "Represent all the data of the systems, both in with the sequence and with the scatterplot. Useful only when there is data to be represented." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "represent(errors=None, with3d=False, with_fragment_labels=False, boxcount=None, remove_letters=None, labeldict=None, **kwargs)" ;
    :hasArgument "errors=None" ;
    :hasArgument "with3d=False" ;
    :hasArgument "with_fragment_labels=False" ;
    :hasArgument "boxcount=None" ;
    :hasArgument "remove_letters=None" ;
    :hasArgument "labeldict=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystem_set_archive_name a :Function ;
    rdfs:label "set_archive_name" ;
    rdfs:comment "Original archive name.\n\nSet the name of the original archive from which this biosystem comes\nfrom.\n\nArgs:\n     archive (str): archive name" ;
    :hasDescription "Original archive name." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "set_archive_name(archive)" ;
    :hasArgument "archive (required)" .

:Function_BigDFT_BioQM_BioSystem_set_fragment_quantities a :Function ;
    rdfs:label "set_fragment_quantities" ;
    rdfs:comment "Set fragment quantities to the system.\n\nInclude in the biosystem a set of fragment quantities that are\nassociated to the fragments. Such quantities can then be retrieved\nby the `fragment_values` method.\n\nArgs:\n    name (str): the name of the quantities to invoke\n    data (list, dict): if a list, the quantities in order of\n        `fragment_names`, otherwise a dictionary containing the\n         per-fragment information" ;
    :hasDescription "Set fragment quantities to the system." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "set_fragment_quantities(name, data)" ;
    :hasArgument "name (required)" ;
    :hasArgument "data (required)" .

:Function_BigDFT_BioQM_BioSystem_set_qm_run a :Function ;
    rdfs:label "set_qm_run" ;
    rdfs:comment "Associate the system to a QM run that has been performed by BigDFT.\nSuch run assumes that the positions of the system atoms are consistent\nwith the PDB\n\nArgs:\n   log (Logfiles.Logfile): A Logfile of the BigDFT run" ;
    :hasDescription "Associate the system to a QM run that has been performed by BigDFT. Such run assumes that the positions of the system atoms are consistent with the PDB" ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "set_qm_run(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_BioQM_BioSystem_sinvh_matrix a :Function ;
    rdfs:label "sinvh_matrix" ;
    :hasDescription "Property sinvh_matrix of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.sinvh_matrix  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_system_target_interaction_investigation a :Function ;
    rdfs:label "system_target_interaction_investigation" ;
    rdfs:comment "Identify the different interactions of the system with a target.\n\nArgs:\n    target (list): the list of the fragments defining the target.\n    nthreads (int): number of threads to calculate the vdW correction.\n    **kwargs: arguments of `calculate_contact_regions`" ;
    :hasDescription "Identify the different interactions of the system with a target." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "system_target_interaction_investigation(target, nthreads, **kwargs)" ;
    :hasArgument "target (required)" ;
    :hasArgument "nthreads (required)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystem_unmatched_frag_info a :Function ;
    rdfs:label "unmatched_frag_info" ;
    rdfs:comment "Retrieve the information about the fragments which have not been\nmatched inside the sequence\n\nReturns:\n   dict: a Dictionary of the fragment that have not been recognized" ;
    :hasDescription "Retrieve the information about the fragments which have not been matched inside the sequence" ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "unmatched_frag_info()" .

:Function_BigDFT_BioQM_BioSystemPopulation_bond_orders a :Function ;
    rdfs:label "bond_orders" ;
    :hasDescription "Property bond_orders of BioSystemPopulation (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "BioSystemPopulation.bond_orders  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystemPopulation_colordict a :Function ;
    rdfs:label "colordict" ;
    rdfs:comment "Define the colordict to quantify the fragments\naccording to the method.\n\nArgs:\n   keys (list): keys of the fragment names.\n   color_by (str): can be 'charge', 'dipole', 'purity'.\n   field_vals(list) : values of the field to decide\n         the colors of the keys.\n   colordict (dict) :  the dictionary of the keys,\n         and the corresponding colors. Overrides field_vals if present\n   colorcode (str): the string of the colorcode. can be 'html' or 'rgb'\n        if field_dict is absent, otherwise it represents\n        the colormap of matplotlib.\n        Default is 'seismic' for diverging values\n        (i.e. field_dict has negative data), otherwise 'Reds'.\n    highlight (list) : color in red only the fragments which\n        are indicated in the list.\n    view (dict): the fragmentation of the system to aggregate\n        the field_vals to.\n    highlight_color (matplotlib.colors): color to be employed\n        for highlighting." ;
    :hasDescription "Define the colordict to quantify the fragments according to the method." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "colordict(field_vals=None, **kwargs)" ;
    :hasArgument "field_vals=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystemPopulation_electrostatic_interactions a :Function ;
    rdfs:label "electrostatic_interactions" ;
    rdfs:comment "Dictionary of the Electrostatic interactions between fragments.\n        " ;
    :hasDescription "Dictionary of the Electrostatic interactions between fragments." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "BioSystemPopulation.electrostatic_interactions  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystemPopulation_examine a :Function ;
    rdfs:label "examine" ;
    rdfs:comment "Provide quick overview of the system's quality.\n\nThis routine displays information about the coordination numbers\nand the bond of the system. Useful to understand if some positions\nof the system need optimization.\n\nArgs:\n    axs: list of matplotlib axis in which to plot the information.\n        If the forces are present it should be of size 3.\n    view (dict): a Fragment view of the system in which to represent\n        the fragment forces. If absent, the fragment forces are not\n        represented.\n\nReturns:\n    dict: Dictionary of the information about the system" ;
    :hasDescription "Provide quick overview of the system's quality." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "examine(axs=None, view=None)" ;
    :hasArgument "axs=None" ;
    :hasArgument "view=None" .

:Function_BigDFT_BioQM_BioSystemPopulation_fragment_scatterplot a :Function ;
    rdfs:label "fragment_scatterplot" ;
    rdfs:comment "Defines the scatterplot to have a look to in order to interpret\nsequence data\n\nArgs:\n   errors (list): the errors of the field_vals in the order\n       of fragment_names\n   ax (matplotlib.pyplot.Axes): Axis of the matplotlib instance\n   **kwargs: the same arguments of the `:py:func:colordict` method\n\nReturns:\n   matplotlib.pyplot.Axes: reference to the axis employed for the plot" ;
    :hasDescription "Defines the scatterplot to have a look to in order to interpret sequence data" ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "fragment_scatterplot(field_vals=None, errors=None, **kwargs)" ;
    :hasArgument "field_vals=None" ;
    :hasArgument "errors=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystemPopulation_fragment_values a :Function ;
    rdfs:label "fragment_values" ;
    rdfs:comment "Retrieve the fragment values that are associated to a give criteria.\nThis is a commodity function made to make more intentional some data.\n\nArgs:\n   criteria (str): can can be 'charge', 'dipole', 'purity'\n   view (dict): the dictionary of the fragment view. If present,\n       aggregate the values accordingly.\n\nReturns:\n   list: in order of the fragment names." ;
    :hasDescription "Retrieve the fragment values that are associated to a give criteria. This is a commodity function made to make more intentional some data." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "fragment_values(criteria, view=None)" ;
    :hasArgument "criteria (required)" ;
    :hasArgument "view=None" .

:Function_BigDFT_BioQM_BioSystemPopulation_interactions a :Function ;
    rdfs:label "interactions" ;
    :hasDescription "Property interactions of BioSystemPopulation (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "BioSystemPopulation.interactions  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystemPopulation_load a :Function ;
    rdfs:label "load" ;
    rdfs:comment "Create a BioSystemPopulation instance from a serialized archive.\n\nArgs:\n    archive (str): the path of the archive\n    **kwargs: other arguments that have to be passed to the\n     BioSystemPopulation instantiation\n\nReturns:\n    BioSystemPopulation: a biosystem population instance" ;
    :hasDescription "Create a BioSystemPopulation instance from a serialized archive." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "load(archive, **kwargs)" ;
    :hasArgument "archive (required)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystemPopulation_purities a :Function ;
    rdfs:label "purities" ;
    :hasDescription "Property purities of BioSystemPopulation (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "BioSystemPopulation.purities  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystemPopulation_serialize a :Function ;
    rdfs:label "serialize" ;
    rdfs:comment "Dump the entire population into an archive, containing\nthe representative archive, if it is provided as such\n(otherwise the serialization of the system)\nas well as the numpy files of all the population data.\n\nArgs:\n     archive(str): archive to dump the population to\n     chessboard_dict (dict): optional dictionary of the fragmentation\n         of the population that has been previously found with\n         a chessboard algorithm. If absent, the internal chessboard is\n         employed\n     **kwargs: arguments to be passed to `BioSystemSerialization`\n         instantiation in the case of a system." ;
    :hasDescription "Dump the entire population into an archive, containing the representative archive, if it is provided as such (otherwise the serialization of the system) as well as the numpy files of all the population data." ;
    :methodOf :Class_BigDFT_BioQM_BioSystemPopulation ;
    :hasSignature "serialize(archive, chessboard_dict=None, **kwargs)" ;
    :hasArgument "archive (required)" ;
    :hasArgument "chessboard_dict=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystemSerialization_dump a :Function ;
    rdfs:label "dump" ;
    rdfs:comment "Create an archive with the entire set of information of the\nSerialization. Such a tarfile should be such that the same\nanalysis of the BioSystem is possible" ;
    :hasDescription "Create an archive with the entire set of information of the Serialization. Such a tarfile should be such that the same analysis of the BioSystem is possible" ;
    :methodOf :Class_BigDFT_BioQM_BioSystemSerialization ;
    :hasSignature "dump(archive)" ;
    :hasArgument "archive (required)" .

:Function_BigDFT_BioQM_Graph_display a :Function ;
    rdfs:label "display" ;
    rdfs:comment "Draw the graph in the Kamada Kawai representation.\nEmploy colors if present.\n\nArgs:\n   colors (list): the list of the colors that have to be employed for\n      all the graph nodes. The list has the size of the full keys list.\n      Only target nodes are employed.\n   colorbar_mappable (matplotlib.colors.ScalarMappable): mappable to be\n      employed to draw a colorbar associated to the node colors.\n   colorbar_label(str): label to be associated to the colorbar\n   edge_colors (list): the list of the colors that have to be employed\n      for each of the edges of the node\n   axs (matplotlib.axis): the axis to draw on (optional)\n   edge_labels (dict): a dictionary from tuples of node labels to\n     a given label.\n   node_shapes (list): list indicating the shapes of the nodes,\n       in order of full keys. Only target nodes are used for the shape.\n   node_edge_colors (list): the list of the colors that have to be\n      employed for all the graph node borders. Same specs than the\n      colors argument.\n   kwargs (dict): any other argument you wish to pass to networkx.\n       Those arguments are arranged in keys, among which\n       ``common``, ``nodes``, ``edges``, ``labels``, ``edge_labels``.\n       Each values of the keys correspond to the arguments which\n       should be passed to the corresponding ``draw_networkx_<>``\n       method." ;
    :hasDescription "Draw the graph in the Kamada Kawai representation. Employ colors if present." ;
    :methodOf :Class_BigDFT_BioQM_Graph ;
    :hasSignature "display(colors=None, axs=None, edge_labels=None, node_shapes=None, edge_colors=None, node_edge_colors=None, colorbar_mappable=None, colorbar_label='', **kwargs)" ;
    :hasArgument "colors=None" ;
    :hasArgument "axs=None" ;
    :hasArgument "edge_labels=None" ;
    :hasArgument "node_shapes=None" ;
    :hasArgument "edge_colors=None" ;
    :hasArgument "node_edge_colors=None" ;
    :hasArgument "colorbar_mappable=None" ;
    :hasArgument "colorbar_label=''" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_Sequence_display a :Function ;
    rdfs:label "display" ;
    rdfs:comment "Display the sequence in a easy-to-read form\n\nArgs:\n    boxcount(int): the number of boxes per row\n    remove_letters (list): list of letter positions that will be\n        removed" ;
    :hasDescription "Display the sequence in a easy-to-read form" ;
    :methodOf :Class_BigDFT_BioQM_Sequence ;
    :hasSignature "display(colors=None, labels=None, axs=None, boxcount=None, remove_letters=[])" ;
    :hasArgument "colors=None" ;
    :hasArgument "labels=None" ;
    :hasArgument "axs=None" ;
    :hasArgument "boxcount=None" ;
    :hasArgument "remove_letters=[]" .

:Function_BigDFT_BioQM_biosystem_fragmentation a :Function ;
    rdfs:label "biosystem_fragmentation" ;
    rdfs:comment "Refragment the system names according to the residues name of the\nstructure from the biopython module.\n\nArgs:\n   sys (System): and instance of the BioSystem class, fragmented in a\n   traditional way\n   structure (Bio.Structure): a structure coming from the BioPython module\n\nReturns:\n   System: a system with a fragmentation that is dependent of the\n      chain of the molecules" ;
    :hasDescription "Refragment the system names according to the residues name of the structure from the biopython module." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "biosystem_fragmentation(sys, structure)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "structure (required)" .

:Function_BigDFT_BioQM_chains_to_sequences a :Function ;
    rdfs:label "chains_to_sequences" ;
    :hasDescription "Function chains_to_sequences of BigDFT.BioQM (no docstring)." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "chains_to_sequences(chlett)" ;
    :hasArgument "chlett (required)" .

:Function_BigDFT_BioQM_clean_view a :Function ;
    rdfs:label "clean_view" ;
    rdfs:comment "Define a view of the system that comes from a view of another one.\nSuperunits are cleaned in such a way that no inconsistencies are present\nin the new view.\n\nArgs:\n   view_orig (dict): the original view we would like to clean\n   superunits (list): list of the new system's superunits\nReturns:\n   dict: the new view of the system, where combined superunits are\n       joined with the '+' symbol" ;
    :hasDescription "Define a view of the system that comes from a view of another one. Superunits are cleaned in such a way that no inconsistencies are present in the new view." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "clean_view(view_orig, superunits)" ;
    :hasArgument "view_orig (required)" ;
    :hasArgument "superunits (required)" .

:Function_BigDFT_BioQM_construct_frag_tuple a :Function ;
    rdfs:label "construct_frag_tuple" ;
    rdfs:comment "Build the fragment tuple given the fragment name.\n\nArgs:\n    frag (str): the fragment name\n\nReturns:\n    tuple: the (chain,fragname,fragno) tuple name" ;
    :hasDescription "Build the fragment tuple given the fragment name." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "construct_frag_tuple(frag)" ;
    :hasArgument "frag (required)" .

:Function_BigDFT_BioQM_construct_res_tuple a :Function ;
    rdfs:label "construct_res_tuple" ;
    rdfs:comment "Build the BigDFT fragment tuple given the residue of the structure\n\nArgs:\n   res(Residue): A residue Class on the Biopython package\n\nReturns:\n   tuple: the (chain,fragname,fragno) tuple" ;
    :hasDescription "Build the BigDFT fragment tuple given the residue of the structure" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "construct_res_tuple(res)" ;
    :hasArgument "res (required)" .

:Function_BigDFT_BioQM_find_relevant_fragments a :Function ;
    rdfs:label "find_relevant_fragments" ;
    rdfs:comment "Identify the fragments of the system that fulfill the criteria\nprovided by the function in argument\n\nArgs:\n    sys (BigDFT.System): the System to identify\n    data (array, Dataframe, dict): data to take care of. If ana array,\n        it is considered in order of fragment_names.\n        If it is a dataframe or a dict, the name of fragments are the keys.\n    criteria (func): function that can be applied to the data items.\n        The function is applied to each of the data elements and the\n        criteria is assumed to be satisfied\n        if any of the element fulfill the criteria\n    columns (list): the fragment to focus the search to.\n        Useful in the case of a dictionary\nReturns:\n    list: fragments that fulfill the criteria" ;
    :hasDescription "Identify the fragments of the system that fulfill the criteria provided by the function in argument" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "find_relevant_fragments(sys, data, criteria, columns=None)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "data (required)" ;
    :hasArgument "criteria (required)" ;
    :hasArgument "columns=None" .

:Function_BigDFT_BioQM_fragment_letters a :Function ;
    rdfs:label "fragment_letters" ;
    rdfs:comment "Give a list of the fragments in terms of their letter\n\nArgs:\n    fragnames (list): list of the names of the fragments\n    residue_list (list): The fragments of the `system` in the order\n          of the residues of the structure\n    sequences_to residues (list): strings of the protein sequence\n          in the FASTA sequence order\n    sequences(list): Sequences of the system\nReturns:\n    list: the labels of the fragments as letters. the label is set to 'X'\n       if the letter is not recognized" ;
    :hasDescription "Give a list of the fragments in terms of their letter" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "fragment_letters(fragnames, sequences, residue_list, sequences_to_residues)" ;
    :hasArgument "fragnames (required)" ;
    :hasArgument "sequences (required)" ;
    :hasArgument "residue_list (required)" ;
    :hasArgument "sequences_to_residues (required)" .

:Function_BigDFT_BioQM_get_BO_network a :Function ;
    rdfs:label "get_BO_network" ;
    rdfs:comment "Defines the connectivity matrix of the fragments\nArgs:\n   connectivity_matrix (matrix-like): matrix of the connnectivities of\n       the system\n   pairwise_bo (dict): list of the fragment BO connections\n\nReturns:\n    tuple: graph,target_nodes,target_edges.\n         Graph to be plotted and the list of target nodes and edges\n         identified by the restriction if present." ;
    :hasDescription "Defines the connectivity matrix of the fragments Args: connectivity_matrix (matrix-like): matrix of the connnectivities of the system pairwise_bo (dict): list of the fragment BO connections" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "get_BO_network(connectivity_matrix)" ;
    :hasArgument "connectivity_matrix (required)" .

:Function_BigDFT_BioQM_graph_bond a :Function ;
    rdfs:label "graph_bond" ;
    rdfs:comment "Defines the connectivity matrix of the fragments\n\nArgs:\n   fraglist (list): the list of the fragment names\n   threshold (float) : the threshold of the cumulative fragment bond order\n        that is applied to define the connectivity\n   pairwise_bo (dict): list of the fragment BO connections\n   restrict_to (list): list of fragments to which the graph has to be\n        restricted\n\nReturns:\n   (matrix) : connectivity matrix of the graph" ;
    :hasDescription "Defines the connectivity matrix of the fragments" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "graph_bond(fraglist, threshold, pairwise_bo, restrict_to=None)" ;
    :hasArgument "fraglist (required)" ;
    :hasArgument "threshold (required)" ;
    :hasArgument "pairwise_bo (required)" ;
    :hasArgument "restrict_to=None" .

:Function_BigDFT_BioQM_interaction_strengths a :Function ;
    rdfs:label "interaction_strengths" ;
    rdfs:comment "Define the interaction strengths of the fragment list with the\nothers with respect to a set of target fragments\n\nArgs:\n    fragments (list) : the name of the fragments of the\n        system in pairwise_bo\n    target_fragments (list) : the fragments constituting the target region\n    pairwise_bo (dict): the bond order between fragments\n\nReturns:\n    array: the  sum of the weigths of the interactions of the fragments\n        in the target region" ;
    :hasDescription "Define the interaction strengths of the fragment list with the others with respect to a set of target fragments" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "interaction_strengths(fragments, target_fragments, pairwise_bo)" ;
    :hasArgument "fragments (required)" ;
    :hasArgument "target_fragments (required)" ;
    :hasArgument "pairwise_bo (required)" .

:Function_BigDFT_BioQM_load a :Function ;
    rdfs:label "load" ;
    rdfs:comment "Create a Biosystem from a serialization archive.\nIt extracts the archive files in a temporary directory\nand loads the related information. Also it deletes the directory\nonce the load is finished.\n\nArgs:\n   archive(path): the path of the serialization archive\n   serialization_version (str): version of the archive.\n       Latest if not specified.\n\nReturns:\n   BioSystem: Instance of the class, loaded from the archive" ;
    :hasDescription "Create a Biosystem from a serialization archive. It extracts the archive files in a temporary directory and loads the related information. Also it deletes the directory once the load is finished." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "load(archive, serialization_version=None, options={})" ;
    :hasArgument "archive (required)" ;
    :hasArgument "serialization_version=None" ;
    :hasArgument "options={}" .

:Function_BigDFT_BioQM_order_chains a :Function ;
    rdfs:label "order_chains" ;
    :hasDescription "Function order_chains of BigDFT.BioQM (no docstring)." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "order_chains(fragments)" ;
    :hasArgument "fragments (required)" .

:Function_BigDFT_BioQM_pdb_sequences a :Function ;
    rdfs:label "pdb_sequences" ;
    rdfs:comment "Sequences of the chains of the proteins, in the order of the residue_list\n\nArgs:\n   filename (str): protein file, in pdb format\n\nReturns:\n   list: strings of the protein sequence in the FASTA sequence order" ;
    :hasDescription "Sequences of the chains of the proteins, in the order of the residue_list" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "pdb_sequences(filename)" ;
    :hasArgument "filename (required)" .

:Function_BigDFT_BioQM_read_structure a :Function ;
    rdfs:label "read_structure" ;
    rdfs:comment "Extract a biological structure from a PDB file. Use the package Bio.PDB\n\nArgs:\n   filename (str): path to the file of the structure\n   name (str): the name of the structure\n\nReturns:\n   (Bio.PDB.Structure) A structure instance" ;
    :hasDescription "Extract a biological structure from a PDB file. Use the package Bio.PDB" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "read_structure(filename, name='protein')" ;
    :hasArgument "filename (required)" ;
    :hasArgument "name='protein'" .

:Function_BigDFT_BioQM_rename_labels a :Function ;
    rdfs:label "rename_labels" ;
    rdfs:comment "Rename the names of the residues of a BioSystem in order\nto be compatible with other naming schemes.\n\nArgs:\n    labels (iterable): contains the list of residue to be renamed\n    as_dict (bool): if True, returns a dictionary as a relabel\n    from_dict (bool): if True assumes that the remapping has to be\n       performed also on the labels values.\n    mappable (func): the function that will be applied for renaming\nReturns:\n    dict, list: dictionary or list of the renamed labels, depending on\n        the arguments." ;
    :hasDescription "Rename the names of the residues of a BioSystem in order to be compatible with other naming schemes." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "rename_labels(labels, as_dict=False, from_dict=False, mappable=<function rename_residue at 0x7fc953160e60>)" ;
    :hasArgument "labels (required)" ;
    :hasArgument "as_dict=False" ;
    :hasArgument "from_dict=False" ;
    :hasArgument "mappable=<function rename_residue at 0x7fc953160e60>" .

:Function_BigDFT_BioQM_rename_residue a :Function ;
    rdfs:label "rename_residue" ;
    rdfs:comment "Rename the residue of the system such that alphabetical order\ncorresponds to sequence order\n\nArgs:\n    res (str): residue of the system, in form \"chain-resname:pos\"\nReturns:\n    str: residue in the form \"chain-pos:letter\"\nWarning:\n    Only put letters to residues which have letter associated" ;
    :hasDescription "Rename the residue of the system such that alphabetical order corresponds to sequence order" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "rename_residue(res)" ;
    :hasArgument "res (required)" .

:Function_BigDFT_BioQM_reorder a :Function ;
    rdfs:label "reorder" ;
    rdfs:comment "Reorder an array of data of systems in such a way that it can be applied\nto characterize another one.\n\nArgs:\n    array (array-like, dict): data in the order of `of.fragment_names`.\n        in case of a dictionary, it is assumed that it contains the data\n        coming from interactions or bond orders.\n    of (BioSystem): the system associated to the original data\n    with_respect_to (BioSystem): the system to which reorder the data\n    switch_chains (dict): mapping of the chains of the old system with\n       respect to the new.\n    mapping (dict): dictionary of the view that decomposes the fragments of\n       ``with_respect_to`` in terms of the fragment of ``of`` in case of\n       multiple elements in the values, an aggregation is considered.\n       If mapping is present, there should not be undefined fragments\n       in their values\n\nReturns:\n    numpy.array: data in the new order. It contains `numpy.nan` for the\n        fragments which are not present in the new system." ;
    :hasDescription "Reorder an array of data of systems in such a way that it can be applied to characterize another one." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "reorder(array, of, with_respect_to, switch_chains=None, mapping=None)" ;
    :hasArgument "array (required)" ;
    :hasArgument "of (required)" ;
    :hasArgument "with_respect_to (required)" ;
    :hasArgument "switch_chains=None" ;
    :hasArgument "mapping=None" .

:Function_BigDFT_BioQM_residue_letter a :Function ;
    rdfs:label "residue_letter" ;
    rdfs:comment "Find the letter associated with the residue\n\nArgs:\n    ires (int): id of the residue\n    sequences(list): Sequences of the system\n    sequences_to residues (list): strings of the protein sequence\n          in the FASTA sequence order\n\nReturns:\n    str: letter of the residue" ;
    :hasDescription "Find the letter associated with the residue" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "residue_letter(ires, sequences, sequences_to_residues)" ;
    :hasArgument "ires (required)" ;
    :hasArgument "sequences (required)" ;
    :hasArgument "sequences_to_residues (required)" .

:Function_BigDFT_BioQM_residue_list a :Function ;
    rdfs:label "residue_list" ;
    rdfs:comment "Identify the residues of the sequence in the fragment of the system\n\nArgs:\n   structure (structure): A structure read from the PDB parser of Bio.PDB\n   system (BigDFT.Systems.System): a system coming from BigDFT package\n   strict (bool): define if the identification has to be performend via\n      centroids control or just by the residue name\n\nReturns:\n   tuple: tuple of list the fragments of the `system` in the order of the\n       residues of the structure. Some of the fragments may be missing as\n       they may have been merged of not associated to elements of the\n       sequence. The second list is the list of the ordered residues." ;
    :hasDescription "Identify the residues of the sequence in the fragment of the system" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "residue_list(structure, system, strict=True)" ;
    :hasArgument "structure (required)" ;
    :hasArgument "system (required)" ;
    :hasArgument "strict=True" .

:Function_BigDFT_BioQM_residue_name a :Function ;
    rdfs:label "residue_name" ;
    rdfs:comment "Name of the residue in the fragment specification of PyBigDFT\n\nArgs:\n   res(Residue): A residue Class on the Biopython package\nReturns:\n   str: name of the fragment" ;
    :hasDescription "Name of the residue in the fragment specification of PyBigDFT" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "residue_name(res)" ;
    :hasArgument "res (required)" .

:Function_BigDFT_BioQM_residue_to_chains a :Function ;
    rdfs:label "residue_to_chains" ;
    :hasDescription "Function residue_to_chains of BigDFT.BioQM (no docstring)." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "residue_to_chains(chdict, residues)" ;
    :hasArgument "chdict (required)" ;
    :hasArgument "residues (required)" .

:Function_BigDFT_BioQM_sequences_to_fragments a :Function ;
    rdfs:label "sequences_to_fragments" ;
    rdfs:comment "Defines the lookup array of the sequences to the fragments\n\nArgs:\n   chains_to_residues(list): lookup of the chains to the list of recogized\n         residues\n   frag_to_residues (list): name of the associated fragments in the order\n         of residues list\n\nReturns:\n   list: array of the name of the fragments in the same representation of\n       chain_to_residues" ;
    :hasDescription "Defines the lookup array of the sequences to the fragments" ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "sequences_to_fragments(chains_to_residues, frag_to_residues)" ;
    :hasArgument "chains_to_residues (required)" ;
    :hasArgument "frag_to_residues (required)" .

:Function_BigDFT_BioQM_sequences_to_residues a :Function ;
    rdfs:label "sequences_to_residues" ;
    rdfs:comment "Identify for each element of the chains which are the residues that may be\nassociated to them.\n\nArgs:\n   reslist(list): the list of all the residues of the system\n   chains (list): a list containing the sequences of the system\n\nReturns:\n   list: a list of length of the chains indicating the lookup array for the\n       sequence" ;
    :hasDescription "Identify for each element of the chains which are the residues that may be associated to them." ;
    :definedIn :Module_BigDFT_BioQM ;
    :hasSignature "sequences_to_residues(reslist, chains)" ;
    :hasArgument "reslist (required)" ;
    :hasArgument "chains (required)" .

:Function_BigDFT_BioQM_serialize_biosystem a :Function ;
    rdfs:label "serialize_biosystem" ;
    rdfs:comment "Serialize the biosystem associated to the provided files\n\nArgs:\n   archive (path): name of the archive to be employed for dumping\n   posinp (path): pdbfile of the structure\n   logfile (path): logfile of the structure\n   version(str): version of the serialization\n   ** kwargs: Arguments to be passed to BioSystem instantiation" ;
