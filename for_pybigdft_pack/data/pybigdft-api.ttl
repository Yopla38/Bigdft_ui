:Function_BigDFT_Systems_System_reform_superunits a :Function ;
    rdfs:label "reform_superunits" ;
    rdfs:comment "Creates a new system from the provided mapping\n\nArgs:\n    mapping(dict): dictionary of the form {newfrag: [frag1,frag2]}\n        defining the mapping between the old fragments and the new\n\nReturns:\n    BigDFT.Systems.System: a new system from the remapping" ;
    :hasDescription "Creates a new system from the provided mapping" ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "reform_superunits(mapping)" ;
    :hasArgument "mapping (required)" .

:Function_BigDFT_Systems_System_rename_fragments a :Function ;
    rdfs:label "rename_fragments" ;
    rdfs:comment "This procedure automatically names the fragments in a system.\n\nArgs:\n   fragment_mapping (dict) : Dictionary containing list\n         of fragments that are additionally added to each\n         of the original system's fragments.\n\nReturns:\n  BigDFT.Systems.System: the same system, with the automatic naming\n  scheme." ;
    :hasDescription "This procedure automatically names the fragments in a system." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "rename_fragments(fragment_mapping=None)" ;
    :hasArgument "fragment_mapping=None" .

:Function_BigDFT_Systems_System_serialize a :Function ;
    rdfs:label "serialize" ;
    rdfs:comment "Transform the system in a list that can be employed for\nthe construction of dataframes or pandas series.\nArgs:\n    order (list): list of fragments to serialize in order\n    units (str): the units for the positions\nReturns:\n    list: the serialized system as well as a lookup dictionary\n        that contains the order of the fragment atoms in the series" ;
    :hasDescription "Transform the system in a list that can be employed for the construction of dataframes or pandas series. Args: order (list): list of fragments to serialize in order units (str): the units for the positions Returns: list: the serialized system as well as a lookup dictionary that contains the order of the fragment atoms in the series" ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "serialize(order=None, units='bohr')" ;
    :hasArgument "order=None" ;
    :hasArgument "units='bohr'" .

:Function_BigDFT_Systems_System_set_atom_forces a :Function ;
    rdfs:label "set_atom_forces" ;
    rdfs:comment "After a run is completed, we have the forces on each atom in the\nlogfile. This routine will set those values to each atom in this sytem.\n\nArgs:\n  logfile (Logfiles.Logfile): logfile with the forces." ;
    :hasDescription "After a run is completed, we have the forces on each atom in the logfile. This routine will set those values to each atom in this sytem." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "set_atom_forces(logfile)" ;
    :hasArgument "logfile (required)" .

:Function_BigDFT_Systems_System_set_atom_multipoles a :Function ;
    rdfs:label "set_atom_multipoles" ;
    rdfs:comment "After a run is completed, we have a set of multipoles defined on\neach atom. This routine will set those values on to each atom\nin the system.\n\nArgs:\n  logfile (Logfiles.Logfile): logfile with the multipole values.\n  correct_charge (bool): currently there is an inconsistency in\n    terms of gross charge, and this corrects it." ;
    :hasDescription "After a run is completed, we have a set of multipoles defined on each atom. This routine will set those values on to each atom in the system." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "set_atom_multipoles(logfile, correct_charge=True)" ;
    :hasArgument "logfile (required)" ;
    :hasArgument "correct_charge=True" .

:Function_BigDFT_Systems_System_set_electrons_from_log a :Function ;
    rdfs:label "set_electrons_from_log" ;
    rdfs:comment "BigDFT uses pseudopotentials, so this will extract from a logfile\nthe number of actual electrons modelled for each atom in the system.\n\nArgs:\n   log (Logfiles.Logfile) : A BigDFT run logfile." ;
    :hasDescription "BigDFT uses pseudopotentials, so this will extract from a logfile the number of actual electrons modelled for each atom in the system." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "set_electrons_from_log(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_Systems_System_set_logfile_info a :Function ;
    rdfs:label "set_logfile_info" ;
    rdfs:comment "Include the information of the logfile in the fragment quantities.\n\nArgs:\n   log (Logfiles.Logfile) : A BigDFT run logfile." ;
    :hasDescription "Include the information of the logfile in the fragment quantities." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "set_logfile_info(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_Systems_System_subsystem a :Function ;
    rdfs:label "subsystem" ;
    rdfs:comment "Extract a subsystem.\n\nCreate a subsystem from a collection of fragments.\n\nArgs:\n    fragments (list): the list of the original fragments which have\n        to be inserted in the new system\nReturns:\n    System: a new System class instance. The reference fragments are\n        shallow-copied." ;
    :hasDescription "Extract a subsystem." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "subsystem(fragments)" ;
    :hasArgument "fragments (required)" .

:Function_BigDFT_Systems_System_to_dataframe a :Function ;
    rdfs:label "to_dataframe" ;
    rdfs:comment "Convert the system into a dataframe, from the\n`py:meth:~System.serialize` method.\n\nArgs:\n    **kwargs: arguments to be passed to\n        `py:meth:System.serialize` method" ;
    :hasDescription "Convert the system into a dataframe, from the `py:meth:~System.serialize` method." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "to_dataframe(**kwargs)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_Systems_System_update_positions_from_dict a :Function ;
    rdfs:label "update_positions_from_dict" ;
    rdfs:comment "Update the atomic positions of a system from a posinp dictionary.\n\nThis method only works if the order of atoms match.\n\nArgs:\n    posinp (dict): a posinp dictionary." ;
    :hasDescription "Update the atomic positions of a system from a posinp dictionary." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "update_positions_from_dict(posinp)" ;
    :hasArgument "posinp (required)" .

