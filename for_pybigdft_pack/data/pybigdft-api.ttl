    :hasArgument "posinp (required)" ;
    :hasArgument "logfile (required)" ;
    :hasArgument "version=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_update_fragmentation a :Function ;
    rdfs:label "update_fragmentation" ;
    rdfs:comment "Update the fragmentation views starting from the last element of\na list of views\n\nArgs:\n     cutoff (float): the cutoff to employ for the fragmentation\n     view_old (dict): previous view of the system\n     sys (BioSystem): the system employed to update the frament list\nReturns:\n     dict: new view of the system" ;
