    :hasDescription "Dictionary of the Electrostatic interactions between fragments." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "System.electrostatic_interactions  (a property: read it, do not call it)" .

:Function_BigDFT_Systems_System_examine a :Function ;
    rdfs:label "examine" ;
    rdfs:comment "Provide quick overview of the system's quality.\n\nThis routine displays information about the coordination numbers\nand the bond of the system. Useful to understand if some positions\nof the system need optimization.\n\nArgs:\n    axs: list of matplotlib axis in which to plot the information.\n        If the forces are present it should be of size 3.\n    view (dict): a Fragment view of the system in which to represent\n        the fragment forces. If absent, the fragment forces are not\n        represented.\n\nReturns:\n    dict: Dictionary of the information about the system" ;
    :hasDescription "Provide quick overview of the system's quality." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "examine(axs=None, view=None)" ;
    :hasArgument "axs=None" ;
    :hasArgument "view=None" .

:Function_BigDFT_Systems_System_get_external_potential a :Function ;
    rdfs:label "get_external_potential" ;
    rdfs:comment "Transform the system information into a dictionary ready to be\nput as an external potential.\n\nArgs:\n  units (str): the units of the external potential.\n  charge_offset (bool): by default the external potential ignores the\n    counter charge from the protons. Setting this to true adds the\n    positive charge to the potential." ;
    :hasDescription "Transform the system information into a dictionary ready to be put as an external potential." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "get_external_potential(units='bohr', charge_offset=False)" ;
    :hasArgument "units='bohr'" ;
    :hasArgument "charge_offset=False" .

:Function_BigDFT_Systems_System_get_k_nearest_fragments a :Function ;
    rdfs:label "get_k_nearest_fragments" ;
    rdfs:comment "Given a fragment id in a system, this computes the nearest fragment.\n\nArgs:\n  target (str): the fragment to find the nearest neighbor of.\n  k (int): the number of fragments to look for.\n  cutoff (float): will only return fragments with a certain cutoff.\n  return_type (str): 'list' or 'dict'\nReturns:\n  (list, dict): the ids of the nearest fragments, or their distances\n      as values in the case in which 'dict' is provided in the\n      `return_type` argument" ;
    :hasDescription "Given a fragment id in a system, this computes the nearest fragment." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "get_k_nearest_fragments(target, k, cutoff=None, return_type='list')" ;
    :hasArgument "target (required)" ;
    :hasArgument "k (required)" ;
    :hasArgument "cutoff=None" ;
    :hasArgument "return_type='list'" .

:Function_BigDFT_Systems_System_get_nearest_fragment a :Function ;
    rdfs:label "get_nearest_fragment" ;
    rdfs:comment "Given a fragment id in a system, this computes the nearest fragment.\n\nArgs:\n  target (str): the fragment to find the nearest neighbor of.\n\nReturns:\n  (str): the id of the nearest fragment." ;
    :hasDescription "Given a fragment id in a system, this computes the nearest fragment." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "get_nearest_fragment(target)" ;
    :hasArgument "target (required)" .

:Function_BigDFT_Systems_System_get_net_force a :Function ;
    rdfs:label "get_net_force" ;
    rdfs:comment "Returns the net force on a system in Ha/Bohr.\n\nReturns:\n  (list): Three values which describe the net force." ;
    :hasDescription "Returns the net force on a system in Ha/Bohr." ;
    :methodOf :Class_BigDFT_Systems_System ;
    :hasSignature "get_net_force()" .

:Function_BigDFT_Systems_System_get_posinp a :Function ;
    rdfs:label "get_posinp" ;
    rdfs:comment "Provide the dictionary which has to be passed to the ``posinp`` value\nof the :meth:`run` method of  the\n:class:`~BigDFT.Calculators.SystemCalculator` class instance.\n\nArgs:\n   units (str): The units of the file." ;
    :hasDescription "Provide the dictionary which has to be passed to the ``posinp`` value of the :meth:`run` method of the :class:`~BigDFT.Calculators.SystemCalculator` class instance." ;
