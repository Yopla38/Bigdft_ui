    :hasSignature "IsReduced(units)" ;
    :hasArgument "units (required)" .

:Function_BigDFT_Atoms_atomic_number a :Function ;
    rdfs:label "atomic_number" ;
    rdfs:comment "Returns the atomic number associated with the given symbol.\n\nArgs:\n  sym (str): the atomic symbol of this atom.\n\nReturns:\n  (int): the atomic number" ;
