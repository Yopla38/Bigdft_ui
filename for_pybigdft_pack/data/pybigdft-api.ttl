:Function_BigDFT_Interop_BabelInterop_molecular_dynamics a :Function ;
    rdfs:label "molecular_dynamics" ;
    rdfs:comment "Run molecular dynamics on a given fragment..\n\nArgs:\n  sys (BigDFT.Systemtems.System): the system to run.\n  steps (int): the number of MD steps to take.\n  temperature (float): temperature in K.\n  timestep (float): time step in picoseconds.\n  forcefield (str): the type of forcefield to use.\n  constraints (list): for each atom, list whether it if frozen or not.\n  verbose (bool): if True, the openbabel output will be printed.\n\nReturns:\n  (BigDFT.Systems.System): a new system with the optimized positions." ;
    :hasDescription "Run molecular dynamics on a given fragment.." ;
    :definedIn :Module_BigDFT_Interop_BabelInterop ;
    :hasSignature "molecular_dynamics(sys, steps, temperature, forcefield='MMFF94', timestep=0.001, verbose=False)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "steps (required)" ;
    :hasArgument "temperature (required)" ;
    :hasArgument "forcefield='MMFF94'" ;
    :hasArgument "timestep=0.001" ;
    :hasArgument "verbose=False" .

:Function_BigDFT_Interop_BabelInterop_optimize_system a :Function ;
    rdfs:label "optimize_system" ;
    rdfs:comment "Optimize the geometry of a given fragment.\n\nArgs:\n  sys (BigDFT.Systems.System): the fragment to optimize.\n  forcefield (str): the type of forcefield to use.\n  verbose (bool): if True, the openbabel output will be printed.\n\nReturns:\n  (BigDFT.Fragments.Fragment): a new fragment with the optimized positions." ;
    :hasDescription "Optimize the geometry of a given fragment." ;
    :definedIn :Module_BigDFT_Interop_BabelInterop ;
    :hasSignature "optimize_system(sys, forcefield='MMFF94', method='SteepestDescent', steps=1000, econv=1e-06, verbose=False)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "forcefield='MMFF94'" ;
    :hasArgument "method='SteepestDescent'" ;
    :hasArgument "steps=1000" ;
    :hasArgument "econv=1e-06" ;
    :hasArgument "verbose=False" .

