    rdfs:label "GIBinding" ;
    rdfs:comment "Calculator for BigDFT from Gobject Introspection bindings.\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature.\n\nMethods and properties: run, set, update." ;
