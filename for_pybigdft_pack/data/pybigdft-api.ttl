    rdfs:label "receive_files" ;
    :hasDescription "Method receive_files of RemoteFunction (no docstring)." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "receive_files(files)" ;
    :hasArgument "files (required)" .

:Function_BigDFT_RemoteRunners_RemoteFunction_send_files a :Function ;
    rdfs:label "send_files" ;
    rdfs:comment "Send files to the remote filesystem to which the class should run.\n\nWith this function, the relevant serialized files should be sent,\nvia the rsync protocol (or equivalent) into the remote directory\nwhich will then be employed to run the function.\n\nArgs:\n    files(dict): source and destination files to be sent,\n        organized as items of a dictionary.\n    url (str): the remote url to connect to.\n    rsync (str): rsync command to synchronize the serialized result." ;
    :hasDescription "Send files to the remote filesystem to which the class should run." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "send_files(files, url='localhost', rsync='rsync -auv')" ;
    :hasArgument "files (required)" ;
    :hasArgument "url='localhost'" ;
    :hasArgument "rsync='rsync -auv'" .

:Function_BigDFT_RemoteRunners_RemoteFunction_send_to a :Function ;
    rdfs:label "send_to" ;
    rdfs:comment "Assign the remote filesystem to which the class should run.\n\nWith this function, the relevant serialized files should be sent,\nvia the rsync protocol (or equivalent) into the remote directory\nwhich will then be employed to run the function.\n\nArgs:\n    dest (str): remote_directory of the destination filesystem.\n        The directory should exist and write permission should\n        be granted.\n    src (str): local directory to prepare the IO files to send.\n        The directory should exist and write permission should\n        be granted.\n    url (str): the remote url to connect to.\n    rsync (str): rsync command to synchronize the serialized result." ;
    :hasDescription "Assign the remote filesystem to which the class should run." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "send_to(dest='.', src='/tmp/', url='localhost', rsync='rsync -auv')" ;
    :hasArgument "dest='.'" ;
    :hasArgument "src='/tmp/'" ;
    :hasArgument "url='localhost'" ;
    :hasArgument "rsync='rsync -auv'" .

:Function_BigDFT_RemoteRunners_RemoteFunction_setup a :Function ;
    rdfs:label "setup" ;
    rdfs:comment "Create and list the files which have to be sent remotely.\n\nArgs:\n    dest (str): remote_directory of the destination filesystem.\n        The directory should exist and write permission should\n        be granted.\n    src (str): local directory to prepare the IO files to send.\n        The directory should exist and write permission should\n        be granted.\n\nReturns:\n    dict: dictionary of {src: dest} files" ;
    :hasDescription "Create and list the files which have to be sent remotely." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "setup(dest='.', src='/tmp/')" ;
    :hasArgument "dest='.'" ;
    :hasArgument "src='/tmp/'" .

:Function_BigDFT_RemoteRunners_RemoteJSONFunction_append_function a :Function ;
    rdfs:label "append_function" ;
