    :hasDescription "Read a CCS matrix from file into a scipy csc matrix." ;
    :definedIn :Module_BigDFT_Spillage ;
    :hasSignature "read_ccs(fname)" ;
    :hasArgument "fname (required)" .

:Function_BigDFT_Spillage_serial_compute_puritybase a :Function ;
    rdfs:label "serial_compute_puritybase" ;
    rdfs:comment "This routine computes the matrix K*S using python.\n\nYou will need this for computing the purity values.\n\nArgs:\n sfile (str): the file name of the overlap matrix.\n     Must be in ccs of mtx format.\n dfile (str): the file name of the density kernel.\n     Must be in ccs of mtx format.\n\nReturns:\n  (scipy.sparse.csc, scipy.sparse.csc): K*S" ;
    :hasDescription "This routine computes the matrix K*S using python." ;
    :definedIn :Module_BigDFT_Spillage ;
    :hasSignature "serial_compute_puritybase(sfile, dfile)" ;
    :hasArgument "sfile (required)" ;
    :hasArgument "dfile (required)" .

:Function_BigDFT_Spillage_serial_compute_spillagebase a :Function ;
    rdfs:label "serial_compute_spillagebase" ;
    rdfs:comment "This routine computes the matrix S^{-1}*H using python.\n\nYou will need this for computing the spillage values.\n\nArgs:\n sfile (str): the file name of the overlap matrix.\n     Must be in ccs of mtx format.\n hfile (str): the file name of the hamiltonian.\n     Must be in ccs of mtx format.\n\nReturns:\n  (scipy.sparse.csc, scipy.sparse.csc): Sinverse * H" ;
    :hasDescription "This routine computes the matrix S^{-1}*H using python." ;
    :definedIn :Module_BigDFT_Spillage ;
    :hasSignature "serial_compute_spillagebase(sfile, hfile)" ;
    :hasArgument "sfile (required)" ;
    :hasArgument "hfile (required)" .

