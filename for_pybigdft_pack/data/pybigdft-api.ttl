:Function_BigDFT_Calculators_Runner_post_processing a :Function ;
    rdfs:label "post_processing" ;
    rdfs:comment "Post-processing, take the arguments as they are provided by the update\nof :meth:`process_run` and :meth:`pre_processing` methods.\n\nReturns:\n   The final object that each call to the :meth:`run` method is\n   supposed to provide." ;
    :hasDescription "Post-processing, take the arguments as they are provided by the update of :meth:`process_run` and :meth:`pre_processing` methods." ;
    :methodOf :Class_BigDFT_Calculators_Runner ;
    :hasSignature "post_processing(**kwargs)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_Calculators_Runner_pre_processing a :Function ;
    rdfs:label "pre_processing" ;
    rdfs:comment "Pre-treat the keyword arguments and the options, if needed.\n\nReturns:\n   :py:class:`dict`: dictionary of the pre-treated keyword arguments\n   that have to be actually considered by process_run." ;
    :hasDescription "Pre-treat the keyword arguments and the options, if needed." ;
    :methodOf :Class_BigDFT_Calculators_Runner ;
    :hasSignature "pre_processing()" .

:Function_BigDFT_Calculators_Runner_process_run a :Function ;
    rdfs:label "process_run" ;
    rdfs:comment "Main item of the runner, defines the information that have to be\npost_processed by post_processing.\n\nArgs:\n  **kwargs (:py:class:`dict`): keyword arguments as returned from the\n    :meth:`pre_processing` method.\n\nReturns:\n  :py:class:`dict`:\n       dictionary objects to be passed to post_processing, once the\n       dictionary returned by :meth:`pre_processing` has been updated" ;
    :hasDescription "Main item of the runner, defines the information that have to be post_processed by post_processing." ;
    :methodOf :Class_BigDFT_Calculators_Runner ;
    :hasSignature "process_run(**kwargs)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_Calculators_Runner_run a :Function ;
    rdfs:label "run" ;
    rdfs:comment "Run method of the class. It performs the following actions:\n\n * Constructs the local dictionary to be passed as ``**kwargs`` to the\n   `process_run` function;\n * Calls the :meth:`pre_processing` method (intended to prepare some\n   actions associated to the :meth:`process_run` method);\n * Calls :meth:`process_run` with the dictionary returned by\n   :meth:`pre_processing` as  `**kwargs`;\n * Update such dictionary with the results returned by\n   :meth:`process_run` and call :meth:`post_processing`;\n * Returns the object passed by the call to :meth:`post_processing`\n   class method\n\nDevelopers are therefore expected to override :meth:`pre_processing`\n:meth:`process_run` and :meth:`post_processing`,\nwhen subclassing :class:`Runner`." ;
    :hasDescription "Run method of the class. It performs the following actions:" ;
    :methodOf :Class_BigDFT_Calculators_Runner ;
    :hasSignature "run(**kwargs)" ;
    :hasArgument "kwargs (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0a567087a54d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_0de5af033369> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_182ecc95f18d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_3632e96e2724> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_4949e483cb32> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_4b96ec8088d3> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_7543fdcf37ae> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_77952689a33e> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_78e7e064413d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8732f3f5421d> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8e63561339da> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_940db71e3fce> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_ab6f691cfd10> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_bf30c1d1507e> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_d6f6eae07786> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_dd92f39d71c0> ;
