    :methodOf :Class_BigDFT_UnitCells_UnitCell ;
    :hasSignature "get_boundary_condition(units='bohr')" ;
    :hasArgument "units='bohr'" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_8732f3f5421d> .

