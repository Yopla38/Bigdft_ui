:Function_BigDFT_LRTDDFT_identify_contributions a :Function ;
    rdfs:label "identify_contributions" ;
    :hasDescription "Function identify_contributions of BigDFT.LRTDDFT (no docstring)." ;
    :definedIn :Module_BigDFT_LRTDDFT ;
    :hasSignature "identify_contributions(numOrb, na, exc, C_E2)" ;
    :hasArgument "numOrb (required)" ;
    :hasArgument "na (required)" ;
    :hasArgument "exc (required)" ;
    :hasArgument "C_E2 (required)" .

:Function_BigDFT_LRTDDFT_transition_indexes a :Function ;
    rdfs:label "transition_indexes" ;
    rdfs:comment "Returns the list of the indices in the bigdft convention that correspond\nto the couple iorb-ialpha with given spin.\n\nArgs:\n    np (tuple): (norbu,norbd) occupied orbitals: when of length 1 assumed\n      spin averaged\n    nalpha (tuple): (norbu, norbd)virtual orbitals: when of length 1\n      assumed spin averaged\n    indexes (list): list of tuples of (iorb,ialpha,ispin) desired indices\n      in python convention (start from 0)" ;
    :hasDescription "Returns the list of the indices in the bigdft convention that correspond to the couple iorb-ialpha with given spin." ;
    :definedIn :Module_BigDFT_LRTDDFT ;
    :hasSignature "transition_indexes(np, nalpha, indexes)" ;
    :hasArgument "np (required)" ;
    :hasArgument "nalpha (required)" ;
    :hasArgument "indexes (required)" .

:Function_BigDFT_Logfiles_Energies_to_dict a :Function ;
    rdfs:label "to_dict" ;
    :hasDescription "Property to_dict of Energies (no docstring)." ;
    :methodOf :Class_BigDFT_Logfiles_Energies ;
    :hasSignature "Energies.to_dict  (a property: read it, do not call it)" .

:Function_BigDFT_Logfiles_Logfile_geopt_plot a :Function ;
    rdfs:label "geopt_plot" ;
    rdfs:comment "For a set of logfiles construct the convergence plot if available.\nPlot the Maximum value of the forces against the difference between\nthe minimum value of the energy and the energy of the iteration.\nAlso an errorbar is given indicating the noise on the forces for a\ngiven point. Show the plot as per plt.show() with matplotlib.pyplots as\nplt\n\n:Example:\n   >>> tt=Logfile('log-with-geometry-optimization.yaml')\n   >>> tt.geopt_plot()" ;
    :hasDescription "For a set of logfiles construct the convergence plot if available. Plot the Maximum value of the forces against the difference between the minimum value of the energy and the energy of the iteration. Also an errorbar is given indicating the noise on the forces for a given point. Show the plot as per plt.show() with matplotlib.pyplots as plt" ;
    :methodOf :Class_BigDFT_Logfiles_Logfile ;
    :hasSignature "geopt_plot()" .

:Function_BigDFT_Logfiles_Logfile_get_brillouin_zone a :Function ;
    rdfs:label "get_brillouin_zone" ;
    rdfs:comment "Return an instance of the BrillouinZone class, useful for band\nstructure.\n:returns: Brillouin Zone of the logfile\n:rtype: :class:`BigDFT.BZ.BrillouinZone`" ;
    :hasDescription "Return an instance of the BrillouinZone class, useful for band structure. :returns: Brillouin Zone of the logfile :rtype: :class:`BigDFT.BZ.BrillouinZone`" ;
    :methodOf :Class_BigDFT_Logfiles_Logfile ;
    :hasSignature "get_brillouin_zone()" .

:Function_BigDFT_Logfiles_Logfile_get_dos a :Function ;
    rdfs:label "get_dos" ;
    rdfs:comment "Get the density of states from the logfile.\n\nFill a `py:class:~BigDFT.DoS.DoS` class object with the information\nwhich is stored in this logfile.\n\nArgs:\n    **kwargs: Keyword Arguments of the `py:class:~BigDFT.DoS.DoS`\n        class.\n\nReturns:\n    BigDFT.DoS.DoS: class instance. Filled with bandarrays and\n       fermi_level." ;
    :hasDescription "Get the density of states from the logfile." ;
    :methodOf :Class_BigDFT_Logfiles_Logfile ;
    :hasSignature "get_dos(**kwargs)" ;
    :hasArgument "kwargs (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_47fc2d353eb4> .

:Function_BigDFT_Logfiles_Logfile_wfn_plot a :Function ;
    rdfs:label "wfn_plot" ;
    rdfs:comment "Plot the wavefunction convergence.\n:Example:\n   >>> tt=Logfile('log-with-wfn-optimization.yaml',label='a label')\n   >>> tt.wfn_plot()" ;
    :hasDescription "Plot the wavefunction convergence. :Example: >>> tt=Logfile('log-with-wfn-optimization.yaml',label='a label') >>> tt.wfn_plot()" ;
    :methodOf :Class_BigDFT_Logfiles_Logfile ;
    :hasSignature "wfn_plot()" .

:Function_BigDFT_Logfiles_document_quantities a :Function ;
    rdfs:label "document_quantities" ;
    rdfs:comment "Extract information from the runs.\n\n.. warning::\n    This routine was designed for the previous parse_log.py script and it\n    is here only for backward compatibility purposes." ;
    :hasDescription "Extract information from the runs." ;
    :definedIn :Module_BigDFT_Logfiles ;
    :hasSignature "document_quantities(doc, to_extract)" ;
    :hasArgument "doc (required)" ;
    :hasArgument "to_extract (required)" .

:Function_BigDFT_Logfiles_find_iterations a :Function ;
    rdfs:label "find_iterations" ;
    rdfs:comment "Identify the different block of the iterations of the wavefunctions\noptimization.\n\n.. todo::\n   Should be generalized and checked for mixing calculation and O(N)\n   logfiles\n\n:param log: logfile load\n:type log: dictionary\n:returns: wavefunction residue per iterations, per each subspace\n  diagonalization\n:rtype: numpy array of rank two" ;
    :hasDescription "Identify the different block of the iterations of the wavefunctions optimization." ;
    :definedIn :Module_BigDFT_Logfiles ;
    :hasSignature "find_iterations(log)" ;
    :hasArgument "log (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_16dc4c2b2af1> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_494dcb5bb347> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_e8020e9c619c> .

:Function_BigDFT_Logfiles_get_logs a :Function ;
    rdfs:label "get_logs" ;
    rdfs:comment "Return a list of loaded logfiles from files, which is a list\nof paths leading to logfiles.\n\nArgs:\n\n:param files: List of filenames indicating the logfiles\n:returns: List of Logfile instances associated to filename" ;
    :hasDescription "Return a list of loaded logfiles from files, which is a list of paths leading to logfiles." ;
    :definedIn :Module_BigDFT_Logfiles ;
    :hasSignature "get_logs(files)" ;
    :hasArgument "files (required)" .

:Function_BigDFT_Logfiles_perform_operations a :Function ;
    rdfs:label "perform_operations" ;
    rdfs:comment "Perform operations given by 'ops'.\n'variables' is a dictionary of variables i.e. key=value.\n\n.. warning::\n   This routine was designed for the previous parse_log.py script and it is\n   here only for backward compatibility purposes." ;
    :hasDescription "Perform operations given by 'ops'. 'variables' is a dictionary of variables i.e. key=value." ;
    :definedIn :Module_BigDFT_Logfiles ;
    :hasSignature "perform_operations(variables, ops, debug=False)" ;
    :hasArgument "variables (required)" ;
    :hasArgument "ops (required)" ;
    :hasArgument "debug=False" .

:Function_BigDFT_Logfiles_plot_wfn_convergence a :Function ;
    rdfs:label "plot_wfn_convergence" ;
    rdfs:comment "Plot the convergence of the wavefunction coming from the find_iterations\nfunction. Cumulates the plot in matplotlib.pyplot module\n\n:param wfn_it: list coming from :func:`find_iterations`\n:param gnrm_cv: convergence criterion for the residue of the wfn_it list\n:param label: label for the given plot" ;
    :hasDescription "Plot the convergence of the wavefunction coming from the find_iterations function. Cumulates the plot in matplotlib.pyplot module" ;
    :definedIn :Module_BigDFT_Logfiles ;
    :hasSignature "plot_wfn_convergence(wfn_it, gnrm_cv, label=None)" ;
    :hasArgument "wfn_it (required)" ;
    :hasArgument "gnrm_cv (required)" ;
    :hasArgument "label=None" .

