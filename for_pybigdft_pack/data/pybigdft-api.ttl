    rdfs:label "frag_indices" ;
    :hasDescription "Property frag_indices of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.frag_indices  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_fragment_distances a :Function ;
    rdfs:label "fragment_distances" ;
    rdfs:comment "Calculate the distance between each of the fragment and\na list of target fragments.\n\nArgs:\n    target_fragments (list): Id of the fragments to focus on\n\nReturns:\n    array-like: list of the distances in the order of fragment_names" ;
    :hasDescription "Calculate the distance between each of the fragment and a list of target fragments." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "fragment_distances(target_fragments)" ;
    :hasArgument "target_fragments (required)" .

:Function_BigDFT_BioQM_BioSystem_fragment_ids a :Function ;
    rdfs:label "fragment_ids" ;
    :hasDescription "Property fragment_ids of BioSystem (no docstring)." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.fragment_ids  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_fragment_interaction_and_feedback a :Function ;
    rdfs:label "fragment_interaction_and_feedback" ;
    rdfs:comment "Provides interaction with a target and its feedback.\n\nThis method calculates the fragment interactions between a target\nand completes the result with the feedback of such interaction that\nan environmental region provides on such target.\n\nArgs:\n   target (list): Id of the fragments to focus on\n   criteria (str): may be 'hamiltonian', 'electrostatic',\n       or 'bond_order'\n   environment (list): environmental region, separated from the\n       target. If absent, the complementary region of the target is\n       considered.\n\nReturns:\n   array-like: list of the strengths of the interactions of the\n        fragments wrt to the target fragments. The order of the list\n        is provided in terms of the `fragment_names`.\n        The values of target fragments are associated to the feedback\n        interaction with the environment" ;
    :hasDescription "Provides interaction with a target and its feedback." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "fragment_interaction_and_feedback(target, criteria, environment=None)" ;
    :hasArgument "target (required)" ;
    :hasArgument "criteria (required)" ;
    :hasArgument "environment=None" .

:Function_BigDFT_BioQM_BioSystem_fragment_interaction_strengths a :Function ;
    rdfs:label "fragment_interaction_strengths" ;
    rdfs:comment "Fragment Bond Order between the different fragments of the system,\npossibly specified on target regions.\n\nArgs:\n   target_fragments (list): Id of the fragments to focus on\n   criteria (str): may be 'hamiltonian', 'electrostatic',\n       or 'bond_order'\n\nReturns:\n   array-like: list of the strengths of the interactions of the\n        fragments wrt to the target fragments.\n        The interaction of the target fragments with themselves is put\n        to the maximum value of the other interactions in order\n        to avoid scale misbehaviour" ;
    :hasDescription "Fragment Bond Order between the different fragments of the system, possibly specified on target regions." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "fragment_interaction_strengths(target_fragments, criteria='hamiltonian')" ;
    :hasArgument "target_fragments (required)" ;
    :hasArgument "criteria='hamiltonian'" .

:Function_BigDFT_BioQM_BioSystem_fragment_purities a :Function ;
    rdfs:label "fragment_purities" ;
    :hasDescription "Define the quality of the fragmentation that is provided in the system" ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "BioSystem.fragment_purities  (a property: read it, do not call it)" .

:Function_BigDFT_BioQM_BioSystem_fragment_scatterplot a :Function ;
    rdfs:label "fragment_scatterplot" ;
    rdfs:comment "Defines the scatterplot to have a look to in order to interpret\nsequence data\n\nArgs:\n   errors (list): the errors of the field_vals in the order\n       of fragment_names\n   ax (matplotlib.pyplot.Axes): Axis of the matplotlib instance\n   **kwargs: the same arguments of the `:py:func:colordict` method\n\nReturns:\n   matplotlib.pyplot.Axes: reference to the axis employed for the plot" ;
    :hasDescription "Defines the scatterplot to have a look to in order to interpret sequence data" ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "fragment_scatterplot(errors=None, ax=None, **kwargs)" ;
    :hasArgument "errors=None" ;
    :hasArgument "ax=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystem_fragment_values a :Function ;
    rdfs:label "fragment_values" ;
    rdfs:comment "Retrieve the fragment values that are associated to a give criteria.\nThis is a commodity function made to make more intentional some data.\n\nArgs:\n   criteria (str): can can be 'charge', 'dipole', 'purity'\n   view (dict): the dictionary of the fragment view. If present,\n       aggregate the values accordingly.\n\nReturns:\n   list: in order of the fragment names." ;
    :hasDescription "Retrieve the fragment values that are associated to a give criteria. This is a commodity function made to make more intentional some data." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "fragment_values(criteria=None, view=None)" ;
    :hasArgument "criteria=None" ;
    :hasArgument "view=None" .

:Function_BigDFT_BioQM_BioSystem_from_sys a :Function ;
    rdfs:label "from_sys" ;
    rdfs:comment "Create a BioSystem instance from a previously existing system.\n\nArgs:\n    system (System): the system instance.\n    **kwargs: other arguments that have to be passed to the\n     BioSystem instantiation.\n\nReturns:\n    BioSystem: a System population instance" ;
    :hasDescription "Create a BioSystem instance from a previously existing system." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "from_sys(system, **kwargs)" ;
    :hasArgument "system (required)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_BioQM_BioSystem_identify_contact_region a :Function ;
    rdfs:label "identify_contact_region" ;
    rdfs:comment "Identify the contact with a target.\n\nSingle out the portion of the target fragments\nthat interacts with the rest of the system.\n\nArgs:\n    target (list): fragments of the target region.\n    cutoff_bo (float): the value of the Fragment Bond Order\n        above which the fragments are considered to be\n        interacting. Typical values range between 0.01 and 1.e-3.\n    cutoff_el (float): cutoff for the electrostatic value (Ha).\n        Fragments whose interaction is larger than such value are also\n        included in the contact region.\nReturns:\n    tuple: the list of the contact region as well as the value of the\n        bond order" ;
    :hasDescription "Identify the contact with a target." ;
    :methodOf :Class_BigDFT_BioQM_BioSystem ;
    :hasSignature "identify_contact_region(target, cutoff_bo=0.001, cutoff_el=10000000000.0)" ;
    :hasArgument "target (required)" ;
    :hasArgument "cutoff_bo=0.001" ;
    :hasArgument "cutoff_el=10000000000.0" .

