:Function_BigDFT_LRTDDFT_Excitations_dos_dict a :Function ;
    rdfs:label "dos_dict" ;
    rdfs:comment "Dictionary for DoS creation.\n\nCreates the keyword arguments that have to be passed to the\n`meth:BigDFT.DoS.append` method of the `DoS` class\n\nArgs:\n   group (str): see :meth:`lookup`\n\nReturns:\n    :py:class:`dict`: kewyord arguments that can be passed to the\n    `meth:BigDFT.DoS.append` method of the :class:`DoS.DoS` class" ;
    :hasDescription "Dictionary for DoS creation." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "dos_dict(group='all')" ;
    :hasArgument "group='all'" .

:Function_BigDFT_LRTDDFT_Excitations_identify_singlet_and_triplets a :Function ;
    rdfs:label "identify_singlet_and_triplets" ;
    rdfs:comment "Find the lookup tables that select the singlets and the triplets among\n  the excitations\n\nArgs:\n   tol (float): tolerance to be applied to recognise the spin character" ;
    :hasDescription "Find the lookup tables that select the singlets and the triplets among the excitations" ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "identify_singlet_and_triplets(tol=1e-05)" ;
    :hasArgument "tol=1e-05" .

:Function_BigDFT_LRTDDFT_Excitations_identify_thresholds a :Function ;
    rdfs:label "identify_thresholds" ;
    rdfs:comment "Identify the thresholds per excitation.\n\nFor each of the first ``nexc`` excitations, identify the energy value\nof its corresponding threshold. This value is determined by projecting\nthe excitation components on the occupied states and verifying that\ntheir norm for the highest energy level is below a given tolerance.\n\nArgs:\n   occ_energies (tuple of array-like): contains the list of the\n     energies of the occupied states per spin channel\n   tol (float): tolerance for determining the threshold\n   nexc (int): number of excitations to be analyzed" ;
    :hasDescription "Identify the thresholds per excitation." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "identify_thresholds(occ_energies, tol, nexc)" ;
    :hasArgument "occ_energies (required)" ;
    :hasArgument "tol (required)" ;
    :hasArgument "nexc (required)" .

:Function_BigDFT_LRTDDFT_Excitations_lookup a :Function ;
    rdfs:label "lookup" ;
    rdfs:comment "Identify the group of the excitations according to the argument\n\nArgs:\n    group (str):\n       A string chosen between\n\n       * ``\"all\"`` : provides the entire set of excitations\n         (:py:class:`None` instead of the lookup array)\n\n       * ``\"bt\"`` : provides only the excitations below threshold\n\n       * ``\"at\"`` : provides only the excitations above threshold\n\n       * ``\"singlets\"`` : provides the index of the excitations that\n         have a singlet character\n\n       * ``\"triplets\"`` : provides the index of the excitations that\n         have a triplet character" ;
    :hasDescription "Identify the group of the excitations according to the argument" ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "lookup(group)" ;
    :hasArgument "group (required)" .

:Function_BigDFT_LRTDDFT_Excitations_plot_Sminustwo a :Function ;
    rdfs:label "plot_Sminustwo" ;
    rdfs:comment "Inspect S-2 sum rule.\n\nProvides an handle to the plotting of the $S^{-2}$ sum rule, which\nshould provide reference values for the static polarizability tensor.\n\nArgs:\n    coord (str): the coordinate used for inspection. May be ``'x'``,\n      ``'y'`` or ``'z'``.\n    alpha_ref (list): diagonal of the reference static polarizability\n       tensor (for instance calculated via finite differences).\n       If present the repartition of the contribution of the various\n       groups of excitations is plotted.\n    group (str): see :meth:`lookup`\n\nReturns:\n    reference to :mod:`matplotlib.pyplot` module." ;
    :hasDescription "Inspect S-2 sum rule." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "plot_Sminustwo(coord, alpha_ref=None, group='all')" ;
    :hasArgument "coord (required)" ;
    :hasArgument "alpha_ref=None" ;
    :hasArgument "group='all'" .

:Function_BigDFT_LRTDDFT_Excitations_plot_alpha a :Function ;
    rdfs:label "plot_alpha" ;
    rdfs:comment "Plot the imaginary part.\n\nPlot the real or imaginary part of the dynamical polarizability.\n\nKeyword Arguments:\n   real (bool): True if real part has to be plotted. The imaginary\n     part is plotted otherwise\n   eta (float): Value of the complex imaginary part. Defaults to 1.e-2.\n   group (str): see :meth:`lookup`\n\n   **kwargs:\n       other arguments that might be passed to the :meth:`plot` method\n       of the :mod:`matplotlib.pyplot` module.\n\nReturns:\n     :mod:`matplotlib.pyplot`: the reference to\n     :mod:`matplotlib.pyplot` module." ;
    :hasDescription "Plot the imaginary part." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "plot_alpha(**kwargs)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_LRTDDFT_Excitations_plot_excitation_landscape a :Function ;
    rdfs:label "plot_excitation_landscape" ;
    rdfs:comment "Represent the excitation landscape as splitted in the excitations class\n\nArgs:\n    **kwargs:\n       keyword arguments to be passed to the `pyplot` instance.\n       The ``xlabel``, ``ylabel`` as well as ``xlim`` are already set.\n\nReturns:\n    :mod:`matplotlib.pyplot`: the reference to :mod:`matplotlib.pyplot`\n      module.\n\nExample:\n   >>> ex=Excitations(cm,tm)\n   >>> ex.split_excitations(evals=...,tol=1.e-4,nexc=...)\n   >>> ex.plot_excitation_landscape(title='Excitation landscape')" ;
    :hasDescription "Represent the excitation landscape as splitted in the excitations class" ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "plot_excitation_landscape(**kwargs)" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_LRTDDFT_Excitations_project_on_spin a :Function ;
    rdfs:label "project_on_spin" ;
    rdfs:comment "Control if an excitation has a Singlet or Triplet character\n\nArgs:\n    exc (int): index of the excitation to be controlled\n\nReturns:\n    tuple (bool,bool): couple of booleans indicating if the excitation\n    is a singlet or a triplet respectively" ;
    :hasDescription "Control if an excitation has a Singlet or Triplet character" ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "project_on_spin(exc, tol=1e-08)" ;
    :hasArgument "exc (required)" ;
    :hasArgument "tol=1e-08" .

:Function_BigDFT_LRTDDFT_Excitations_spectrum_curves a :Function ;
    rdfs:label "spectrum_curves" ;
    rdfs:comment "Calculate spectrum curves.\n\nProvide the set of the curves associated to the weights. The resulting\ncurves might then be used to draw the excitation spectra.\n\nArgs:\n    omega (array): the linspace used for the plotting, of shape\n      ``(n,)``. Must be provided in Atomic Units\n    slice (array): the lookup array that has to be considered. if Not\n      provided the entire range is assumed\n    weights (array): the set of arrays used to weight the spectra. Must\n      have shape ``(rank,m)``, where ``rank`` is equal to the number\n      of eigenvalues. If m is absent it is assumed to be 1. When not\n      specified, it defaults to the average oscillator strenghts.\n\nReturns:\n    array: a set of spectrum curves, of shape equal to ``(n,m)``,\n    where ``n`` is the shape of ``omega`` and ``m`` the size of the\n    second dimension of ``weights``." ;
    :hasDescription "Calculate spectrum curves." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "spectrum_curves(omega, slice=None, weights=None)" ;
    :hasArgument "omega (required)" ;
    :hasArgument "slice=None" ;
    :hasArgument "weights=None" .

:Function_BigDFT_LRTDDFT_Excitations_split_excitations a :Function ;
    rdfs:label "split_excitations" ;
    rdfs:comment "Separate the excitations in channels.\n\nThis methods classify the excitations according to the channel they\nbelong, and determine if a given excitation might be considered as a\nbelonging to a discrete part of the spectrum or not.\n\nArgs:\n    evals (BandArray): the eigenvalues as they are provided\n      (for instance) from a `Logfile` class instance.\n    tol (float): tolerance for determining the threshold\n    nexc (int,str): number of excitations to be analyzed.\n        If ``'all'`` then the entire set of excitations are analyzed." ;
    :hasDescription "Separate the excitations in channels." ;
    :methodOf :Class_BigDFT_LRTDDFT_Excitations ;
    :hasSignature "split_excitations(evals, tol, nexc='all')" ;
    :hasArgument "evals (required)" ;
    :hasArgument "tol (required)" ;
    :hasArgument "nexc='all'" .

:Function_BigDFT_LRTDDFT_TransitionDipoles_get_transitions a :Function ;
    rdfs:label "get_transitions" ;
    rdfs:comment "Get the transition quantities as the dimensional objects which should\ncontribute to the oscillator strengths.\n\nReturns:\n    numpy.array: Transition quantities multiplied by the square root of\n    the unperturbed transition energy" ;
    :hasDescription "Get the transition quantities as the dimensional objects which should contribute to the oscillator strengths." ;
    :methodOf :Class_BigDFT_LRTDDFT_TransitionDipoles ;
    :hasSignature "get_transitions()" .

:Function_BigDFT_LRTDDFT_TransitionMultipoles_get_transitions a :Function ;
    rdfs:label "get_transitions" ;
    rdfs:comment "Get the transition quantities as the dimensional objects which should\ncontribute to the oscillator strengths.\n\nReturns:\n    numpy.array: Transition quantities multiplied by the square root of\n    the unperturbed transition energy" ;
    :hasDescription "Get the transition quantities as the dimensional objects which should contribute to the oscillator strengths." ;
    :methodOf :Class_BigDFT_LRTDDFT_TransitionMultipoles ;
    :hasSignature "get_transitions()" .

:Function_BigDFT_LRTDDFT_TransitionMultipoles_subportion a :Function ;
    rdfs:label "subportion" ;
    rdfs:comment "Extract a subportion of the Transition Multipoles.\n\nReturns a set of transition multipoles which is made by only\nconsidering the first ``norb_occ`` and ``norb_virt`` orbitals\n\nArgs:\n   norb_occ (tuple): new number of occupied orbitals. Must be lower\n     that the instance value\n   norb_virt (tuple): new number of virtual orbitals. Must be lower\n     that the instance value\n\nReturns:\n   TransitionMultipoles: reduced transition multipoles" ;
    :hasDescription "Extract a subportion of the Transition Multipoles." ;
    :methodOf :Class_BigDFT_LRTDDFT_TransitionMultipoles ;
    :hasSignature "subportion(norb_occ, norb_virt)" ;
    :hasArgument "norb_occ (required)" ;
    :hasArgument "norb_virt (required)" .

:Function_BigDFT_LRTDDFT_get_alpha_energy a :Function ;
    rdfs:label "get_alpha_energy" ;
    :hasDescription "Function get_alpha_energy of BigDFT.LRTDDFT (no docstring)." ;
    :definedIn :Module_BigDFT_LRTDDFT ;
    :hasSignature "get_alpha_energy(log, norb, nalpha)" ;
    :hasArgument "log (required)" ;
    :hasArgument "norb (required)" ;
    :hasArgument "nalpha (required)" .

:Function_BigDFT_LRTDDFT_get_p_energy a :Function ;
    rdfs:label "get_p_energy" ;
    :hasDescription "Function get_p_energy of BigDFT.LRTDDFT (no docstring)." ;
    :definedIn :Module_BigDFT_LRTDDFT ;
    :hasSignature "get_p_energy(log, norb)" ;
    :hasArgument "log (required)" ;
    :hasArgument "norb (required)" .

:Function_BigDFT_LRTDDFT_get_threshold a :Function ;
