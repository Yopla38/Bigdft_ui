:Function_BigDFT_PointParticles_distance_matrix a :Function ;
    rdfs:label "distance_matrix" ;
    rdfs:comment "Extract the distance matrix of a array of positions with euclidean\nmetric.\n\nArgs:\n    X (array): array of the positions of the system\n\nReturns:\n    matrix-like: matrix of distances in squareform\n\nWarning:\n    The distance provided here is meaningful only in isolated boundary\n    conditions" ;
    :hasDescription "Extract the distance matrix of a array of positions with euclidean metric." ;
    :definedIn :Module_BigDFT_PointParticles ;
    :hasSignature "distance_matrix(X)" ;
    :hasArgument "X (required)" .

:Function_BigDFT_PointParticles_electrostatic_energies_matrix a :Function ;
    rdfs:label "electrostatic_energies_matrix" ;
    rdfs:comment "Extract the matrix of the electrostatic energies of atoms described\nBy their positions, charges and dipoles\n\nArgs:\n     X (array): the array of the atom positions\n     Q (array): charge monopoles of the atoms (total)\n     P (array): array of the dipoles, in Px,Py,Pz convention\n     Rm1 (matrix): inverse distance matrix of the positions\n\nReturns:\n     matrix: matrix of the electrostatic energies per atom pair\n\nWarning:\n     This energy is meaningful only for isolated boundary conditions" ;
    :hasDescription "Extract the matrix of the electrostatic energies of atoms described By their positions, charges and dipoles" ;
    :definedIn :Module_BigDFT_PointParticles ;
    :hasSignature "electrostatic_energies_matrix(X, Rm1, Q, P)" ;
    :hasArgument "X (required)" ;
    :hasArgument "Rm1 (required)" ;
    :hasArgument "Q (required)" ;
    :hasArgument "P (required)" .

:Function_BigDFT_PointParticles_electrostatic_energy_dict a :Function ;
    rdfs:label "electrostatic_energy_dict" ;
    rdfs:comment "Dictionary of the electrostatic energies starting from a slicing\ndefining the blocks of atom to be considered\n\nArgs:\n    E (matrix): electrostatic_energies_matrix of the atoms\n    slicing (dict): slicing of the fragments, given for example\n        by `py:meth:~BigDFT.Systems.System.dataframe_slicing`\nReturns:\n    dict: dictionary of the electrostatic interaction per blocks" ;
    :hasDescription "Dictionary of the electrostatic energies starting from a slicing defining the blocks of atom to be considered" ;
    :definedIn :Module_BigDFT_PointParticles ;
    :hasSignature "electrostatic_energy_dict(E, slicing)" ;
    :hasArgument "E (required)" ;
    :hasArgument "slicing (required)" .

:Function_BigDFT_PointParticles_inverse_distance_matrix a :Function ;
    rdfs:label "inverse_distance_matrix" ;
    rdfs:comment "Calculate the inverse distance matrix, with zeros on the diagonal\n\nArgs:\n     Rab (matrix-like): matrix of the atomic distances in squareform\nReturns:\n     matrix-like: inverse distance matrix, with diagonal values set to 0" ;
    :hasDescription "Calculate the inverse distance matrix, with zeros on the diagonal" ;
    :definedIn :Module_BigDFT_PointParticles ;
    :hasSignature "inverse_distance_matrix(Rab)" ;
    :hasArgument "Rab (required)" .

:Function_BigDFT_PointParticles_long_range_energy_matrix a :Function ;
    rdfs:label "long_range_energy_matrix" ;
    rdfs:comment "Extract the matrix of the electrostatic energies of atoms described\nBy their positions, charges and dipoles\n\nArgs:\n     X (array): the array of the atom positions\n     Q (array): charge monopoles of the electrons\n     Z (array): charge monopole of the ions\n     P (array): array of the dipoles, in Px,Py,Pz convention\n     Rm1 (matrix): inverse distance matrix of the positions\n\nReturns:\n     matrix: matrix of the electrostatic energies per atom pair\n\nWarning:\n     This energy is meaningful only for isolated boundary conditions" ;
    :hasDescription "Extract the matrix of the electrostatic energies of atoms described By their positions, charges and dipoles" ;
    :definedIn :Module_BigDFT_PointParticles ;
    :hasSignature "long_range_energy_matrix(X, Rm1, Z, Q, P)" ;
    :hasArgument "X (required)" ;
    :hasArgument "Rm1 (required)" ;
    :hasArgument "Z (required)" ;
    :hasArgument "Q (required)" ;
    :hasArgument "P (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_auto_fragment a :Function ;
    rdfs:label "auto_fragment" ;
    rdfs:comment "Refragment a system based on the results of a previous calculation.\n\nThe auto fragment protocol performs a greedy optimization using either\nthe bond order or the distance between fragments as a guide. The\npurity values and the fragment bond orders are essential quantities\nfor this calculation, so they can be passed if they are already\ncached.\n\nBy using the `rand` keyword, you can trigger a stochastic\nrefragmentation process. If this process is repeated many times, you\nmay find a result that improves upon the greedy optimization approach.\n\nArgs:\n  system (BigDFT.Systems.System): the system to fragment.\n  view (BigDFT.Systems.System): a view of the system.\n  cutoff (float): the termination criteria. When the worst fragment is\n    more pure than this cutoff, the calculation stops.\n  verbose (bool): whether to print out as it proceeds.\n  rand (bool): whether to activate the stochastic approach.\n  criteria (string): either distance or bondorder.\n\nReturns:\n  dict: a mapping from the old system to the new system where each\n  fragment fullfills the purity criteria." ;
    :hasDescription "Refragment a system based on the results of a previous calculation." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "auto_fragment(system, view, cutoff, verbose=False, rand=False, criteria='bondorder')" ;
    :hasArgument "system (required)" ;
    :hasArgument "view (required)" ;
    :hasArgument "cutoff (required)" ;
    :hasArgument "verbose=False" ;
    :hasArgument "rand=False" ;
    :hasArgument "criteria='bondorder'" .

:Function_BigDFT_PostProcessing_BigDFTool_ccs_node a :Function ;
    rdfs:label "ccs_node" ;
    rdfs:comment "Defines the  protocol to validate the ccs matrix file" ;
    :hasDescription "Defines the protocol to validate the ccs matrix file" ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "ccs_node(log, matrixname)" ;
    :hasArgument "log (required)" ;
    :hasArgument "matrixname (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_compute_fragment_dos a :Function ;
    rdfs:label "compute_fragment_dos" ;
    rdfs:comment "Compute the partial density of states projected onto a given\nfragment.\n\nArgs:\n    sys (BigDFT.Fragments.Fragment): the fragment to project on to.\n    log (BigDFT.Logfiles.Logfile): the log of the calculation.\n    ks_coeff (scipy.sparse.csc_matrix): the matrix of eigenvectors.\n    eigvals (list): a list of eigenvalues.\n    frag_indices (list): list of indices associated with this\n      fragment.\n    smat (scipy.sparse.csc_matrix): the overlap matrix.\n    assume_pure (bool): an optimization can be performed if we assume\n      the target is pure.\n    kwargs (dict): any extra options to pass to the DoS constructor.\nReturns:\n  (BigDFT.DoS.DoS): a density of states object built using the partial\n  density of states." ;
    :hasDescription "Compute the partial density of states projected onto a given fragment." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "compute_fragment_dos(frag, log, ks_coeff, eigvals, frag_indices=None, smat=None, assume_pure=False, **kwargs)" ;
    :hasArgument "frag (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "ks_coeff (required)" ;
    :hasArgument "eigvals (required)" ;
    :hasArgument "frag_indices=None" ;
    :hasArgument "smat=None" ;
    :hasArgument "assume_pure=False" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_create_layered_qmmm_system a :Function ;
    rdfs:label "create_layered_qmmm_system" ;
    rdfs:comment "Creates a multilayered system suitable for QM/MM calculations.\nFor each layer, a suitable QM region is built around it.\n\nArgs:\n  system (BigDFT.Systems.System): a System class, already broken up\n    into fragments.\n  pairwise_bo (dict): pairwise bond order values between all fragments\n    in the system.\n  target (str): the name of the fragment to treat as the target of\n    the qm/mm run.\n  cutoffs (list): a list of cutoff value for fragment interactions.\n    The number of layers is equal to the number of cutoffs.\n  criteria (str): how to determine which atoms are included in the\n    QM region. Valid choices are \"bondorder\" and \"distance\".\n  link_atoms (bool): whether to generate link atoms.\n\nReturns:\n  (list): a list of Systems, one for each QM layer.\n  (System): the MM region." ;
    :hasDescription "Creates a multilayered system suitable for QM/MM calculations. For each layer, a suitable QM region is built around it." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "create_layered_qmmm_system(system, target, pairwise_bo, cutoffs, criteria='bondorder', link_atoms=False)" ;
    :hasArgument "system (required)" ;
    :hasArgument "target (required)" ;
    :hasArgument "pairwise_bo (required)" ;
    :hasArgument "cutoffs (required)" ;
    :hasArgument "criteria='bondorder'" ;
    :hasArgument "link_atoms=False" .

:Function_BigDFT_PostProcessing_BigDFTool_create_qmmm_system a :Function ;
    rdfs:label "create_qmmm_system" ;
    rdfs:comment "Creates a system suitable for QM/MM calculations.\n\nArgs:\n  system (System): a System class, already broken up into fragments.\n  target (str): the name of the fragment to treat as the target of\n    the qm/mm run.\n  bond_order (dict): bond order values between the target fragment and\n    all other fragments in the system.\n  cutoff (float): a cutoff value for fragment interactions.\n  criteria (str): how to determine which atoms are included in the\n    QM region. Valid choices are \"bondorder\" and \"distance\".\n  link_atoms (bool): whether to generate link atoms.\n\nReturns:\n  (System): the QM region.\n  (System): the MM region." ;
    :hasDescription "Creates a system suitable for QM/MM calculations." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "create_qmmm_system(system, target, bond_order, cutoff, criteria='bondorder', link_atoms=False)" ;
    :hasArgument "system (required)" ;
    :hasArgument "target (required)" ;
    :hasArgument "bond_order (required)" ;
    :hasArgument "cutoff (required)" ;
    :hasArgument "criteria='bondorder'" ;
    :hasArgument "link_atoms=False" .

:Function_BigDFT_PostProcessing_BigDFTool_derived_quantity a :Function ;
    rdfs:label "derived_quantity" ;
    rdfs:comment "Defines a quantity that can be derived from the ccs files\nin the files list. Requires the generator function." ;
    :hasDescription "Defines a quantity that can be derived from the ccs files in the files list. Requires the generator function." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "derived_quantity(name, log, files, generator)" ;
    :hasArgument "name (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "files (required)" ;
    :hasArgument "generator (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_fragment_bond_order a :Function ;
    rdfs:label "fragment_bond_order" ;
    rdfs:comment "Computes \"bond order\" between two sets of fragments using the method of\nMayer. For two atomic fragments, this would describe the bond\nmultiplicity of the covalent bond.\n\nArgs:\n  sys (BigDFT.Systems.System): the system containing the fragments\n    of interest\n  fraglist1 (list): a list of fragments to compute the bond order\n    of.\n  fraglist2 (list): a list of fragments to compute the bond order\n    between.\n  log (BigDFT.Logfiles.Logfile): the log describing a calculation.\n  kxs (scipy.sparse.csc_matrix): the matrix K*S, which might be already\n    computed to reduce I/O time.\n  frag_indices (dict): the matrix indices associated with each\n    fragment.\n\nReturn:\n  (dict): a dictionary of dictionaries, mapping the bond order of each\n  fragment in fraglist1 to each fragment in fraglist2." ;
    :hasDescription "Computes \"bond order\" between two sets of fragments using the method of Mayer. For two atomic fragments, this would describe the bond multiplicity of the covalent bond." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "fragment_bond_order(sys, fraglist1, fraglist2, log, kxs=None, frag_indices=None)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "fraglist1 (required)" ;
    :hasArgument "fraglist2 (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "kxs=None" ;
    :hasArgument "frag_indices=None" .

:Function_BigDFT_PostProcessing_BigDFTool_fragment_interaction_energy a :Function ;
    rdfs:label "fragment_interaction_energy" ;
    rdfs:comment "Compute the interaction energies between two sets of fragments.\n\nArgs:\n  fraglist1 (list): a list of fragments to compute the interaction\n    energy of.\n  fraglist2 (list): a list of fragments to compute the interaction\n    energy between.\n  log (BigDFT.Logfiles.Logfile): the log describing a calculation.\n  frag_indices (dict): the matrix indices associated with each\n    fragment.\n  sinvh (scipy.sparse.csc_matrix): the matrix S^{-1}*H, which might be\n    already computed to reduce I/O time.\n  kxs (scipy.sparse.csc_matrix): the matrix K*S, which might be already\n    computed to reduce I/O time.\n\nReturns:\n  (float): the projected energy." ;
    :hasDescription "Compute the interaction energies between two sets of fragments." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "fragment_interaction_energy(sys, fraglist1, fraglist2, log, frag_indices=None, sinvh=None, kxs=None)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "fraglist1 (required)" ;
    :hasArgument "fraglist2 (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "frag_indices=None" ;
    :hasArgument "sinvh=None" ;
    :hasArgument "kxs=None" .

:Function_BigDFT_PostProcessing_BigDFTool_fragment_mask_matrix a :Function ;
    rdfs:label "fragment_mask_matrix" ;
    rdfs:comment "Sometimes we don't want to store an entire matrix, just the parts\nrelated to some fragments of interest. This routine will mask out a\nmatrix, keeping entries only related to the list of fragments\nprovided.\n\nArgs:\n  sys (BigDFT.Systems.System): the system associated with the matrix.\n  mat (scipy.sparse.csr_matrix): the matrix to mask.\n  fragments (list): a list of fragment ids to keep.\n  log (BigDFT.Logfiles.Logfile): the logfile associated with this\n    matrix's calculation.\nReturns:\n  (scipy.sparse.csr_matrix): the masked matrix." ;
    :hasDescription "Sometimes we don't want to store an entire matrix, just the parts related to some fragments of interest. This routine will mask out a matrix, keeping entries only related to the list of fragments provided." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "fragment_mask_matrix(sys, mat, fragments, log)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "mat (required)" ;
    :hasArgument "fragments (required)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_fragment_population a :Function ;
    rdfs:label "fragment_population" ;
    rdfs:comment "Performs Mulliken population analysis on a fragment, in case charges\nhaven't been computed by doing a multipole analysis.\n\nArgs:\n  sys (BigDFT.Systems.System): the system to compute the population of.\n  log (BigDFT.Logfiles.Logfile): the log describing a calculation.\n  frag_indices (dict): the matrix indices associated with each\n    fragment.\n  kxs (scipy.sparse.csc_matrix): the matrix K*S, which might be already\n    computed to reduce I/O time.\n\nReturn:\n  (dict): a mapping from fragment ids to charges." ;
    :hasDescription "Performs Mulliken population analysis on a fragment, in case charges haven't been computed by doing a multipole analysis." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "fragment_population(sys, log, frag_indices=None, kxs=None)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "frag_indices=None" ;
    :hasArgument "kxs=None" .

:Function_BigDFT_PostProcessing_BigDFTool_generate_link_atoms a :Function ;
    rdfs:label "generate_link_atoms" ;
    rdfs:comment "This routine adds link atoms to a subsystem based on the bond\norder of a full system. Link atom positions are automatically adjusted\nbased on the length of some standard bonds.\n\nArgs:\n  fullsys (BigDFT.Systems.System): the full system that the subsystem\n    is embedded into.\n  subsys (BigDFT.Systems.System): the embedded system which needs\n    link atoms.\n  distcut (float): this cutoff is the largest distance value we expect\n    allow a bond to be.\n\nReturns:\n  (BigDFT.Systems.System): the subsystem with link atoms added.\n  (BigDFT.Systems.System): a system which has the atoms that were\n    removed and replaced with link atoms." ;
    :hasDescription "This routine adds link atoms to a subsystem based on the bond order of a full system. Link atom positions are automatically adjusted based on the length of some standard bonds." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "generate_link_atoms(fullsys, subsys, distcut=6.0)" ;
    :hasArgument "fullsys (required)" ;
    :hasArgument "subsys (required)" ;
    :hasArgument "distcut=6.0" .

:Function_BigDFT_PostProcessing_BigDFTool_get_frag_indices a :Function ;
    rdfs:label "get_frag_indices" ;
    rdfs:comment "Compute a lookup table of matrix indices for each fragment in a\nsystem.\n\nArgs:\n  system (System): instance of a System class, which defines the\n    fragmentation.\n  log (Logfile): logfile from the run computed on this system.\n\nReturns:\n  (dict): a mapping of fragment ids to lists of indices" ;
    :hasDescription "Compute a lookup table of matrix indices for each fragment in a system." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_frag_indices(sys, log)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_ks_coeff a :Function ;
    rdfs:label "get_ks_coeff" ;
    rdfs:comment "Retrieve the Kohn-Sham coefficients and the eigenvalues in matrix\nform.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix of coefficients\n  (list): list of eigenvalues." ;
    :hasDescription "Retrieve the Kohn-Sham coefficients and the eigenvalues in matrix form." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_ks_coeff(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_matrix_h a :Function ;
    rdfs:label "get_matrix_h" ;
    rdfs:comment "Read the hamiltonian matrix into memory.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix H" ;
    :hasDescription "Read the hamiltonian matrix into memory." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_matrix_h(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_matrix_k a :Function ;
    rdfs:label "get_matrix_k" ;
    rdfs:comment "Read the density matrix into memory.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix K" ;
    :hasDescription "Read the density matrix into memory." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_matrix_k(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_matrix_kxs a :Function ;
    rdfs:label "get_matrix_kxs" ;
    rdfs:comment "Computes the matrix K*S, the mulliken version of the density matrix,\nand loads it into memory.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix K*S" ;
    :hasDescription "Computes the matrix K*S, the mulliken version of the density matrix, and loads it into memory." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_matrix_kxs(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_matrix_s a :Function ;
    rdfs:label "get_matrix_s" ;
    rdfs:comment "Read the overlap matrix into memory.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix S" ;
    :hasDescription "Read the overlap matrix into memory." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_matrix_s(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_get_matrix_sinvh a :Function ;
    rdfs:label "get_matrix_sinvh" ;
    rdfs:comment "Computes the matrix S^{-1}*H, the mulliken version of the spillage\nmatrix, and loads it into memory.\n\nlog (Logfile): instance of a Logfile class\n\nReturns:\n  (scipy.sparse.csc_matrix): the matrix S^{-1}*H" ;
    :hasDescription "Computes the matrix S^{-1}*H, the mulliken version of the spillage matrix, and loads it into memory." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "get_matrix_sinvh(log)" ;
    :hasArgument "log (required)" .

:Function_BigDFT_PostProcessing_BigDFTool_run_compute_purity a :Function ;
    rdfs:label "run_compute_purity" ;
    rdfs:comment "Compute the purity values of the different system fragments.\n\nNote that this can also be computed using the fragment multipoles,\nbut this provides an implementation for when you don't need those\nvalues.\n\nArgs:\n  system (System): instance of a System class, which defines the\n    fragmentation.\n  log (Logfile): logfile from the run computed on this system.\n  kxs (scipy.sparse.csc_matrix): the matrix K*S, which might be already\n    computed to reduce I/O time.\n  frag_list (list): we can also only compute the purity values of some\n    select fragments.\n  frag_indices (list): the indices of the matrix associated with each\n    fragment. This can be precomputed and passed.\n\nReturns:\n  (dict): for each fragment id, what is the purity value." ;
    :hasDescription "Compute the purity values of the different system fragments." ;
    :methodOf :Class_BigDFT_PostProcessing_BigDFTool ;
    :hasSignature "run_compute_purity(system, log, kxs=None, frag_list=None, frag_indices=None)" ;
    :hasArgument "system (required)" ;
    :hasArgument "log (required)" ;
    :hasArgument "kxs=None" ;
    :hasArgument "frag_list=None" ;
    :hasArgument "frag_indices=None" .

:Function_BigDFT_PostProcessing_file_dependency_queue a :Function ;
    rdfs:label "file_dependency_queue" ;
    :hasDescription "Function file_dependency_queue of BigDFT.PostProcessing (no docstring)." ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "file_dependency_queue(btool, ccsfile, txtfile, mpifile=None)" ;
    :hasArgument "btool (required)" ;
    :hasArgument "ccsfile (required)" ;
    :hasArgument "txtfile (required)" ;
    :hasArgument "mpifile=None" .

:Function_BigDFT_PostProcessing_superunits_purities a :Function ;
    rdfs:label "superunits_purities" ;
    rdfs:comment "Compute the purity values of the superunits described as a unification of\nthe units\n\nArgs:\n   bo (matrix-like): Fragment Bond Orders of the Units\n   pv (array-like): Purity values of the Units\n   superunits (dict): lookup dictionary containing the list\n     of units per superunit\n   q_units (array-like): charges of the units\n   q_superunits (array-like): charges of the superunits\n\nReturns:\n   dict: purities of the superunits" ;
    :hasDescription "Compute the purity values of the superunits described as a unification of the units" ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "superunits_purities(bo, pv, q_units, superunits, q_superunits)" ;
    :hasArgument "bo (required)" ;
    :hasArgument "pv (required)" ;
    :hasArgument "q_units (required)" ;
    :hasArgument "superunits (required)" ;
    :hasArgument "q_superunits (required)" .

:Function_BigDFT_PostProcessing_superunits_quadratic_quantities a :Function ;
    rdfs:label "superunits_quadratic_quantities" ;
    rdfs:comment "Compute quantities that transforms like the bond orders of the superunits\ndescribed as a unification of the units\n\nArgs:\n   bo (matrix-like): Quantities like Fragment Bond Orders of the Units\n   superunits (dict): lookup dictionary containing the list\n     of units per superunit\n\nReturns:\n   dict: quantities of the superunits" ;
    :hasDescription "Compute quantities that transforms like the bond orders of the superunits described as a unification of the units" ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "superunits_quadratic_quantities(bo, superunits)" ;
    :hasArgument "bo (required)" ;
    :hasArgument "superunits (required)" .

:Function_BigDFT_PostProcessing_system_violinplot a :Function ;
    rdfs:label "system_violinplot" ;
    rdfs:comment "Represent a violinplot from a dictionary of values.\n\nArgs:\n    system_dict (dict): dictionary mapping the labels\n         to plot with their values.\n    ax (matplotlib.pyplot.axis): the axis to plot on.\n    **kwargs: any other argument to be passed to the violinplot\nReturns:\n    tuple: the axis of the plot and the object returned from\n        the violinplot." ;
    :hasDescription "Represent a violinplot from a dictionary of values." ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "system_violinplot(system_dict, ax=None, **kwargs)" ;
    :hasArgument "system_dict (required)" ;
    :hasArgument "ax=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_PostProcessing_systems_heatmap a :Function ;
    rdfs:label "systems_heatmap" ;
    rdfs:comment "Create a heatmap for a set of systems.\n\nArgs:\n    data (dict): a dictionary mapping system names to another dictionary\n      which maps fragment ids to property values.\n    restrict_to (list): a list of lists saying what fragments we should\n      draw. It is a list of lists instead of just a list because this\n      way we can put a separator between values (for example, when making\n      a jump in the sequence).\n    axs (matplotlib.axis): the axis to draw on.\n    columns (list): the order of the columns on the x axis\n    kwargs (dict): any extra argument you wish to pass to matplotlib's\n      imshow command.\n\nReturns:\n    a reference to the imshow value." ;
    :hasDescription "Create a heatmap for a set of systems." ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "systems_heatmap(data, restrict_to=None, axs=None, columns=None, **kwargs)" ;
    :hasArgument "data (required)" ;
    :hasArgument "restrict_to=None" ;
    :hasArgument "axs=None" ;
    :hasArgument "columns=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_PostProcessing_units_quadratic_traces a :Function ;
    rdfs:label "units_quadratic_traces" ;
    :hasDescription "Function units_quadratic_traces of BigDFT.PostProcessing (no docstring)." ;
    :definedIn :Module_BigDFT_PostProcessing ;
    :hasSignature "units_quadratic_traces(unitlist1, unitlist2, frag_indices, mat1, mat2, a1=1.0, a2=1.0)" ;
    :hasArgument "unitlist1 (required)" ;
    :hasArgument "unitlist2 (required)" ;
    :hasArgument "frag_indices (required)" ;
    :hasArgument "mat1 (required)" ;
    :hasArgument "mat2 (required)" ;
    :hasArgument "a1=1.0" ;
    :hasArgument "a2=1.0" .

:Function_BigDFT_RemoteRunners_RemoteDataset_append_run a :Function ;
    rdfs:label "append_run" ;
    rdfs:comment "Add a remote run into the dataset.\n\nAppend to the list of runs to be performed the corresponding runner and\n   the arguments which are associated to it.\n\nArgs:\n  id (dict): the id of the run, useful to identify the run in the\n     dataset. It has to be a dictionary as it may contain\n     different keyword. For example a run might be classified as\n     ``id = {'hgrid':0.35, 'crmult': 5}``.\n  remote_runner (RemoteRunner): a instance of a remote runner that will\n      be employed.\n  **kwargs: arguments required for the creation of the corresponding\n      remote runner. If remote_runner is provided, these arguments will\n      be They will be combined with the global arguments.\n\nRaises:\n  ValueError: if the provided id is identical to another previously\n     appended run." ;
    :hasDescription "Add a remote run into the dataset." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteDataset ;
    :hasSignature "append_run(id, remote_runner=None, **kwargs)" ;
    :hasArgument "id (required)" ;
    :hasArgument "remote_runner=None" ;
    :hasArgument "kwargs (required)" .

:Function_BigDFT_RemoteRunners_RemoteDataset_pre_processing a :Function ;
    rdfs:label "pre_processing" ;
    rdfs:comment "Pre-treat the keyword arguments and the options, if needed.\n\nReturns:\n   :py:class:`dict`: dictionary of the pre-treated keyword arguments\n   that have to be actually considered by process_run." ;
    :hasDescription "Pre-treat the keyword arguments and the options, if needed." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteDataset ;
    :hasSignature "pre_processing()" .

:Function_BigDFT_RemoteRunners_RemoteDataset_process_run a :Function ;
    rdfs:label "process_run" ;
    rdfs:comment "Run the dataset, by performing explicit run of each of the item of the\n   runs_list." ;
    :hasDescription "Run the dataset, by performing explicit run of each of the item of the runs_list." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteDataset ;
    :hasSignature "process_run()" .

:Function_BigDFT_RemoteRunners_RemoteDillFunction_append_function a :Function ;
    rdfs:label "append_function" ;
    rdfs:comment "Include the call to another function in the main runfile.\n\nWith this method another remote function can be called in the same\ncontext of the remote call.\nSuch remote function will be called from within the same remote\ndirectory of the overall function.\nThe result of the remote function will then be the result provided\nfrom the last of the appended functions.\n\nArgs:\n    extra_function (RemoteFunction): the remote function to append." ;
    :hasDescription "Include the call to another function in the main runfile." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteDillFunction ;
    :hasSignature "append_function(extra_function)" ;
    :hasArgument "extra_function (required)" .

:Function_BigDFT_RemoteRunners_RemoteFunction_append_function a :Function ;
    rdfs:label "append_function" ;
    rdfs:comment "Include the call to another function in the main runfile.\n\nWith this method another remote function can be called in the same\ncontext of the remote call.\nSuch remote function will be called from within the same remote\ndirectory of the overall function.\nThe result of the remote function will then be the result provided\nfrom the last of the appended functions.\n\nArgs:\n    extra_function (RemoteFunction): the remote function to append." ;
    :hasDescription "Include the call to another function in the main runfile." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "append_function(extra_function)" ;
    :hasArgument "extra_function (required)" .

:Function_BigDFT_RemoteRunners_RemoteFunction_call a :Function ;
    rdfs:label "call" ;
    rdfs:comment "Provides the command to execute the function.\n\nArgs:\n    remotely (bool): invoke the function from local machine.\n        employ ssh protocol to perform the call.\n    remote_cwd (bool): True if our CWD is already the remote_dir to\n        which the function has been sent. False otherwise.\n        Always assumed as False if remotely is True.\n    ssh (str): the ssh interpreter to be employed.\n\nReturns:\n    str: the string command to be executed." ;
    :hasDescription "Provides the command to execute the function." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "call(remotely=True, remote_cwd=False, ssh='ssh')" ;
    :hasArgument "remotely=True" ;
    :hasArgument "remote_cwd=False" ;
    :hasArgument "ssh='ssh'" .

:Function_BigDFT_RemoteRunners_RemoteFunction_fetch_result a :Function ;
    rdfs:label "fetch_result" ;
    rdfs:comment "Get the results of a calculation locally.\n\nArgs:\n    remotely (bool): control the presence of the result on the remote\n        filesystem\n\nReturns:\n    The object returned by the original function" ;
    :hasDescription "Get the results of a calculation locally." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "fetch_result(remotely=True)" ;
    :hasArgument "remotely=True" .

:Function_BigDFT_RemoteRunners_RemoteFunction_files_received a :Function ;
    rdfs:label "files_received" ;
    rdfs:comment "Mark the relevant files as received.\n\nArgs:\n    yes (bool): True if the files have been already received in the\n        remote directory" ;
    :hasDescription "Mark the relevant files as received." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "files_received(yes)" ;
    :hasArgument "yes (required)" .

:Function_BigDFT_RemoteRunners_RemoteFunction_files_sent a :Function ;
    rdfs:label "files_sent" ;
    rdfs:comment "Mark the relevant files as sent.\n\nArgs:\n    yes (bool): True if the files have been already sent to the\n        remote directory" ;
    :hasDescription "Mark the relevant files as sent." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "files_sent(yes)" ;
    :hasArgument "yes (required)" .

:Function_BigDFT_RemoteRunners_RemoteFunction_is_finished a :Function ;
    rdfs:label "is_finished" ;
    rdfs:comment "Check if the function has been executed.\nThis is controlled by the presence of the resultfile of the\nlast of the functions dependencies.\n\nArgs:\n    remotely (bool): control the presence of the result on the remote\n        filesystem\n    ssh (str): the ssh interpreter to be employed. Use internal value\n        if not provided. Only meaningful if remotely is True.\nReturn:\n    bool: True if ready, False otherwise." ;
    :hasDescription "Check if the function has been executed. This is controlled by the presence of the resultfile of the last of the functions dependencies." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "is_finished(remotely=True, ssh='ssh')" ;
    :hasArgument "remotely=True" ;
    :hasArgument "ssh='ssh'" .

:Function_BigDFT_RemoteRunners_RemoteFunction_prepare_files_to_receive a :Function ;
    rdfs:label "prepare_files_to_receive" ;
    rdfs:comment "List of files that will have to be received.\n\nThis function defines the files which requires to be get from the url\nin order to execute remotely the python function.\n\nReturns:\n    dict: files which will be received" ;
    :hasDescription "List of files that will have to be received." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "prepare_files_to_receive()" .

:Function_BigDFT_RemoteRunners_RemoteFunction_prepare_files_to_send a :Function ;
    rdfs:label "prepare_files_to_send" ;
    rdfs:comment "List of files that will have to be sent.\n\nThis function defines the files which requires to be sent over\nin order to execute remotely the python function.\nAlso set the main file to be called and the resultfile.\n\nReturns:\n    dict: files which will be sent" ;
    :hasDescription "List of files that will have to be sent." ;
    :methodOf :Class_BigDFT_RemoteRunners_RemoteFunction ;
    :hasSignature "prepare_files_to_send()" .

