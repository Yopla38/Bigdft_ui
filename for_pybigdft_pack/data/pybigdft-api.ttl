    :hasDescription "Hash the id into a list of run names to search with the function id_in_names and add the separator ',' to have the proper value of a key (to avoid 0.3 in 0.39)" ;
    :definedIn :Module_BigDFT_Datasets ;
    :hasSignature "names_from_id(id)" ;
    :hasArgument "id (required)" .

:Function_BigDFT_DoS_DiracSuperposition_curve a :Function ;
    rdfs:label "curve" ;
    rdfs:comment "Output the quantities to be plotted.\n\nReturns the x,y arrays that can be passed to plotting programs to\nrepresent the DoS.\n\nArgs:\n    xs (list): xrange of the output.\n    sigma (float): smearing of the energies, as returned by\n        :py:meth:`peaks`.\n    wgts (list): array of further weights to be applied, if needed\n\nReturns:\n    collections.NamedTuple: x,y numpy arrays of the curve in the\n        specified range." ;
    :hasDescription "Output the quantities to be plotted." ;
    :methodOf :Class_BigDFT_DoS_DiracSuperposition ;
    :hasSignature "curve(xs, sigma, wgts=None)" ;
    :hasArgument "xs (required)" ;
    :hasArgument "sigma (required)" ;
    :hasArgument "wgts=None" .

:Function_BigDFT_DoS_DiracSuperposition_peak a :Function ;
    rdfs:label "peak" ;
    rdfs:comment "Define if a peak is a Gaussian or a Lorenzian (temporarily only the\ngaussian is defined)" ;
    :hasDescription "Define if a peak is a Gaussian or a Lorenzian (temporarily only the gaussian is defined)" ;
    :methodOf :Class_BigDFT_DoS_DiracSuperposition ;
    :hasSignature "peak(omega, e, sigma)" ;
    :hasArgument "omega (required)" ;
    :hasArgument "e (required)" ;
    :hasArgument "sigma (required)" .

:Function_BigDFT_DoS_DiracSuperposition_peaks a :Function ;
    rdfs:label "peaks" ;
    :hasDescription "Return the array of the whole set of peaks" ;
    :methodOf :Class_BigDFT_DoS_DiracSuperposition ;
    :hasSignature "peaks(xs, dos, norms, sigma)" ;
    :hasArgument "xs (required)" ;
    :hasArgument "dos (required)" ;
    :hasArgument "norms (required)" ;
    :hasArgument "sigma (required)" .

:Function_BigDFT_DoS_DoS_append a :Function ;
    rdfs:label "append" ;
    rdfs:comment "Include other DoS inside the instance.\n\nArgs:\n    energies (list): energies of the superpsition.\n    label (str): id of the DoS.\n    units (str): units of the energies. Can be AU or eV.\n    norm (float, list): weights of the density of states." ;
    :hasDescription "Include other DoS inside the instance." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "append(energies, label=None, units='eV', norm=1.0)" ;
    :hasArgument "energies (required)" ;
    :hasArgument "label=None" ;
    :hasArgument "units='eV'" ;
    :hasArgument "norm=1.0" .

:Function_BigDFT_DoS_DoS_append_from_bandarray a :Function ;
    rdfs:label "append_from_bandarray" ;
    rdfs:comment "Add a new band array to the previous DoS.\n\nThis method can be called to include in the DoS the energies which\ncome from another run.\n\nArgs:\n    bandarrays (BigDFT.BZ.BandArray): a instance of the eigenvalues\n        which come from a logfile. Can be retrieved by the\n        `BigDFT.Logfiles.Logfile.evals` attribute of the class.\n    label (str): id of the run." ;
    :hasDescription "Add a new band array to the previous DoS." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "append_from_bandarray(bandarrays, label)" ;
    :hasArgument "bandarrays (required)" ;
    :hasArgument "label (required)" .

:Function_BigDFT_DoS_DoS_append_from_dict a :Function ;
    rdfs:label "append_from_dict" ;
    :hasDescription "Get the energies from the different flavours given by the dict." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "append_from_dict(evals, label)" ;
    :hasArgument "evals (required)" ;
    :hasArgument "label (required)" .

:Function_BigDFT_DoS_DoS_dump a :Function ;
    rdfs:label "dump" ;
    rdfs:comment "Represent the dta to be plotted as a table.\n\nThis is a commodity function that can be used to redirect the output\nof the DoS into a file.\n\nArgs:\n    **kwargs: the arguments of the :py:meth:`get_curves` method.\n\nReturns:\n    (str): serialized DoS, gnuplot-friendly, can be written in a file." ;
    :hasDescription "Represent the dta to be plotted as a table." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "dump(**kwargs)" ;
    :hasArgument "kwargs (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_47fc2d353eb4> .

:Function_BigDFT_DoS_DoS_fermi_level a :Function ;
    rdfs:label "fermi_level" ;
    rdfs:comment "Set the fermi level of the DoS.\n\nArgs:\n    fermi_level (float): the value of the chemical potential.\n    units (str): the units of this value. can be `AU` or `eV`." ;
    :hasDescription "Set the fermi level of the DoS." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "fermi_level(fermi_level, units='eV')" ;
    :hasArgument "fermi_level (required)" ;
    :hasArgument "units='eV'" .

:Function_BigDFT_DoS_DoS_get_curves a :Function ;
    rdfs:label "get_curves" ;
    rdfs:comment "Get the curves of the DoS instance, ready for plotting.\n\nThis function provides a dictionary of data for each of the curves\nwhich can be plots by the :py:meth:`plot` method. They can be retrieved\nalso to be plotted with other plotting tools.\n\nArgs:\n    range (array): the xrange to be employed for the curves.\n        If not provided, use the :py:attr:`range` attribute of\n        the instance.\n    sigma (float): the smearing of the dos. If not provided, use the\n        :py:attr:`sigma` attribute of the instance.\n\nReturns:\n    collections.OrderedDict: a dicitonary of a `label: (x,y)` items,\n        where x,y are the data to be plotted. (x,y) is a\n        `py:class:~collections.namedtuple` class instance,\n        as returned from `DiracSuperposition`." ;
    :hasDescription "Get the curves of the DoS instance, ready for plotting." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "get_curves(range=None, sigma=None)" ;
    :hasArgument "range=None" ;
    :hasArgument "sigma=None" .

:Function_BigDFT_DoS_DoS_plot a :Function ;
    rdfs:label "plot" ;
    rdfs:comment "Commodity Function to plot the DoS.\n\nPlot the curves which are available.\n\nArgs:\n    sigma(float): smearing of the curves\n    ax (matplotlib.pyplot.axis): matplotlib axis instance.\n        Created if not given.\n    smearing_slider (bool): If True, a slider\n        is drawn to control the semaring manually.\n        Useful when outside the jupyter inline visualization.\nReturns:\n    matplotlib.pyplot.axis: The axis instance used for the plot.\n        This is also present in the `ax1` attribute of the class." ;
    :hasDescription "Commodity Function to plot the DoS." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "plot(sigma=None, ax=None, smearing_slider=False)" ;
    :hasArgument "sigma=None" ;
    :hasArgument "ax=None" ;
    :hasArgument "smearing_slider=False" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_47fc2d353eb4> .

:Function_BigDFT_DoS_DoS_set_range a :Function ;
    rdfs:label "set_range" ;
    rdfs:comment "Adjust the range of the curves to be plotted/represented.\n\nThis function can be called if it is necessary to adjust the range\nof the curves.\n\nArgs:\n    npts (int): minimum number of points of the curves.\n    deltae (float): minimum resolution of the x range. Always in eV.\n    e_min (float): Minimum value of the energy. Always in eV.\n    e_max (float): Maximum value of the energy. Always in eV." ;
    :hasDescription "Adjust the range of the curves to be plotted/represented." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "set_range(npts=None, e_min=None, e_max=None, deltae=None)" ;
    :hasArgument "npts=None" ;
    :hasArgument "e_min=None" ;
    :hasArgument "e_max=None" ;
    :hasArgument "deltae=None" .

:Function_BigDFT_DoS_DoS_shift_curves a :Function ;
    rdfs:label "shift_curves" ;
    rdfs:comment "Shift the curves.\n\nApply a constant or a per-curve shift on the data.\n\nArgs:\n    shift (float, list, dict): the shift to be implemented.\n        If it is a constant, it is performed on all the curves.\n        If it is a list, the shif is performed on all the DoS,\n        in appending order. Should have the same length of the labels.\n        If is is a dict, it assumes the shift per label.\n        Only the indicated DoS will be shifted.\n        The units of the shift are always in eV." ;
    :hasDescription "Shift the curves." ;
    :methodOf :Class_BigDFT_DoS_DoS ;
    :hasSignature "shift_curves(shift)" ;
    :hasArgument "shift (required)" .

