:Function_BigDFT_Systems_copy_bonding_information a :Function ;
    rdfs:label "copy_bonding_information" ;
    rdfs:comment "This routine will take the bonding information of sys1 and copy it\nover to sys2. This routine requires that both systems have the exact\nsame atoms in them. This is useful if you refragment a system and\nwant to fix the bonding information.\n\nArgs:\n  sys1 (BigDFT.Systems.System): the system to copy bonding information\n    from.\n  sys2 (BigDFT.Systems.System): the system to copy information to." ;
    :hasDescription "This routine will take the bonding information of sys1 and copy it over to sys2. This routine requires that both systems have the exact same atoms in them. This is useful if you refragment a system and want to fix the bonding information." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "copy_bonding_information(sys1, sys2)" ;
    :hasArgument "sys1 (required)" ;
    :hasArgument "sys2 (required)" .

:Function_BigDFT_Systems_df_fragment_forces a :Function ;
    rdfs:label "df_fragment_forces" ;
    :hasDescription "Function df_fragment_forces of BigDFT.Systems (no docstring)." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "df_fragment_forces(df)" ;
    :hasArgument "df (required)" .

