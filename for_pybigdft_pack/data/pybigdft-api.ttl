:Class_BigDFT_Systems_System a :PythonClass ;
    rdfs:label "System" ;
    rdfs:comment "A system is defined as a named collection of fragments. You can manipulate\na system as if it were a standard python dictionary, however it also has\nhelper routines for performing operations on the full system.\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature.\n\nMethods and properties: PointParticles, ase_potential_energy, central_fragment, centroid, compute_matching, dataframe_slicing, df, dict, display, distances_from_target, electrostatic_interactions, examine, get_external_potential, get_k_nearest_fragments, get_nearest_fragment, get_net_force, get_posinp, q0, qcharge, reform_superunits, rename_fragments, serialize, set_atom_forces, set_atom_multipoles, set_electrons_from_log, set_logfile_info, subsystem, to_dataframe, update_positions_from_dict." ;
    :hasDescription "A system is defined as a named collection of fragments. You can manipulate a system as if it were a standard python dictionary, however it also has helper routines for performing operations on the full system." ;
    :definedIn :Module_BigDFT_Systems ;
    :hasSignature "System(*args, **kwargs)" ;
    :hasArgument "args (required)" ;
    :hasArgument "kwargs (required)" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_76397a6ec4c2> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_eec49a6c03fb> .

