:Function_BigDFT_Spillage_invert_ccs a :Function ;
    rdfs:label "invert_ccs" ;
    rdfs:comment "Invert a CSC matrix and restore a sparsity pattern such as it can be\nwritten without the need for large files.\n\nArgs:\n   mat (csc_matrix): the sparese matrix to invert\n\nReturns:\n   csc_matrix: the inverse" ;
    :hasDescription "Invert a CSC matrix and restore a sparsity pattern such as it can be written without the need for large files." ;
    :definedIn :Module_BigDFT_Spillage ;
    :hasSignature "invert_ccs(mat)" ;
    :hasArgument "mat (required)" .

:Function_BigDFT_Spillage_read_ccs a :Function ;
    rdfs:label "read_ccs" ;
