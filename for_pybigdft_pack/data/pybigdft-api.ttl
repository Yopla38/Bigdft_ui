    rdfs:comment "Hash the id into a run name\nConstruct the name of the run from the id dictionary\n\nArgs:\n    id (dict): id associated to the run\n\nReturns:\n   str: name of the run associated to the dictionary ``id``" ;
    :hasDescription "Hash the id into a run name Construct the name of the run from the id dictionary" ;
