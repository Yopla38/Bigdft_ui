:Function_BigDFT_Visualization_contrasting_text_color a :Function ;
    rdfs:label "contrasting_text_color" ;
    rdfs:comment "Input a string without hash sign of RGB hex digits to compute\ncomplementary contrasting color such as for fonts.\nFunction borrowed from\nhttps://stackoverflow.com/questions/1855884/        determine-font-color-based-on-background-color\n\nArgs:\n    hex_str (str): the color string in hex.\nReturns:\n    str: string of the contrasting color, black or white." ;
    :hasDescription "Input a string without hash sign of RGB hex digits to compute complementary contrasting color such as for fonts. Function borrowed from https://stackoverflow.com/questions/1855884/ determine-font-color-based-on-background-color" ;
    :definedIn :Module_BigDFT_Visualization ;
    :hasSignature "contrasting_text_color(hex_str)" ;
    :hasArgument "hex_str (required)" .

:Function_BigDFT_Visualization_get_colordict a :Function ;
    rdfs:label "get_colordict" ;
    rdfs:comment "Build a dictionary of colors for each of the keys.\nIf the field_dict is provided, order the colors of the keys in terms\nof the sorting of the filed values\n\nArgs:\n    keys (list): keys of the color dictionary\n    field_vals(list) : values of the field to decide the colors of the keys\n    vmin (float): minimum value of the colors.\n        Useful to extend the range below the minimum of field_vals.\n    vmax (float): maximum value of the colors.\n        Useful to extend the range below the maximum of field_vals.\n    colorcode (str): the string of the colorcode.\n         Can be 'html' or 'rgb' if field_dict is absent,\n         otherwise it represent the colormap of matplotlib.\n         Default is 'seismic' for diverging values\n         (field_dict has negative data), otherwise 'Reds'\nReturns:\n    dict: the dictionary of the keys, and the corresponding colors.\n        The dictionary contains also special keys arguments\n        to be passed to the `colorbar` method of matplotlib:\n\n           * '__mappable__', which\n             is associated the reference to the matplotlib.ScalarMappable\n             instance that is associated to the colordict. This instance\n             can be useful to draw colorbars associated to such a\n             colordict." ;
    :hasDescription "Build a dictionary of colors for each of the keys. If the field_dict is provided, order the colors of the keys in terms of the sorting of the filed values" ;
    :definedIn :Module_BigDFT_Visualization ;
    :hasSignature "get_colordict(keys, field_vals=None, vmin=None, vmax=None, colorcode='html')" ;
    :hasArgument "keys (required)" ;
    :hasArgument "field_vals=None" ;
    :hasArgument "vmin=None" ;
    :hasArgument "vmax=None" ;
    :hasArgument "colorcode='html'" .

:Function_BigDFT_Visualization_get_distinct_colors a :Function ;
    rdfs:label "get_distinct_colors" ;
    rdfs:comment "This generates a dictionary of distinct colors based on a matplotlib\ncolormap.\n\nArgs:\n    keys (list): a list of keys.\n    name (str): the name of the matplotlib colormap to use.\n    fuzz (bool): some color maps (included tab20) only have a distinct\n        set of colors. The fuzz option adds increased randomness to make\n        up for this.\n\nReturns:\n    (dict): a dictionary mapping matplotlib keys to RGB colors." ;
    :hasDescription "This generates a dictionary of distinct colors based on a matplotlib colormap." ;
    :definedIn :Module_BigDFT_Visualization ;
    :hasSignature "get_distinct_colors(keys, name='tab20', fuzz=True)" ;
    :hasArgument "keys (required)" ;
    :hasArgument "name='tab20'" ;
    :hasArgument "fuzz=True" .

:Function_BigDFT_Visualization_truncate_colormap a :Function ;
    rdfs:label "truncate_colormap" ;
    rdfs:comment "Truncate a colormap from a given cmap. Taken from\nhttps://stackoverflow.com/questions/40929467/\nhow-to-use-and-plot-only-a-part-of-a-colorbar-in-matplotlib." ;
    :hasDescription "Truncate a colormap from a given cmap. Taken from https://stackoverflow.com/questions/40929467/ how-to-use-and-plot-only-a-part-of-a-colorbar-in-matplotlib." ;
    :definedIn :Module_BigDFT_Visualization ;
    :hasSignature "truncate_colormap(cmap, compressed_values=None, vmin=0.0, vmax=1.0, N=-1)" ;
    :hasArgument "cmap (required)" ;
    :hasArgument "compressed_values=None" ;
    :hasArgument "vmin=0.0" ;
    :hasArgument "vmax=1.0" ;
    :hasArgument "N=-1" .

