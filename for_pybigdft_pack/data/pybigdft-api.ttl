:Function_BigDFT_scripts_InputGenerator_set_restart a :Function ;
    rdfs:label "set_restart" ;
    :hasDescription "Function set_restart of BigDFT.scripts.InputGenerator (no docstring)." ;
    :definedIn :Module_BigDFT_scripts_InputGenerator ;
    :hasSignature "set_restart()" .

:Function_BigDFT_scripts_InputGenerator_set_spin a :Function ;
    rdfs:label "set_spin" ;
    :hasDescription "Define the spin in function of the nature of the atoms" ;
    :definedIn :Module_BigDFT_scripts_InputGenerator ;
    :hasSignature "set_spin(name, nat)" ;
    :hasArgument "name (required)" ;
    :hasArgument "nat (required)" .

:Function_BigDFT_scripts_InputGenerator_set_strain a :Function ;
    rdfs:label "set_strain" ;
    :hasDescription "Function set_strain of BigDFT.scripts.InputGenerator (no docstring)." ;
    :definedIn :Module_BigDFT_scripts_InputGenerator ;
    :hasSignature "set_strain(strain, ngrids, dico)" ;
    :hasArgument "strain (required)" ;
    :hasArgument "ngrids (required)" ;
    :hasArgument "dico (required)" .

:Function_BigDFT_scripts_InputGenerator_transform_to_orthorombic a :Function ;
    rdfs:label "transform_to_orthorombic" ;
    :hasDescription "Function transform_to_orthorombic of BigDFT.scripts.InputGenerator (no docstring)." ;
    :definedIn :Module_BigDFT_scripts_InputGenerator ;
    :hasSignature "transform_to_orthorombic(dico)" ;
    :hasArgument "dico (required)" .

:Function_BigDFT_wahba_apply_R a :Function ;
    rdfs:label "apply_R" ;
    rdfs:comment "Apply the rotation on the set of vectors A.\n\nArgs:\n  R (numpy.matrix): a rotation matrix.\n  A (numpy.matrix): the set of vectors to rotate.\n\nReturns:\n  (numpy.matrix): the set of vectors, rotated by the matrix." ;
    :hasDescription "Apply the rotation on the set of vectors A." ;
    :definedIn :Module_BigDFT_wahba ;
    :hasSignature "apply_R(R, A)" ;
    :hasArgument "R (required)" ;
    :hasArgument "A (required)" .

:Function_BigDFT_wahba_apply_Rt a :Function ;
    rdfs:label "apply_Rt" ;
    rdfs:comment "Rotate the element and apply the translation on the rotated vector.\n\nArgs:\n  R (numpy.matrix): a rotation matrix.\n  t (numpy.matrix): a translation matrix.\n  A (numpy.matrix): the set of vectors to translate.\n\nReturns:\n  (numpy.matrix): the set of vectors, rototranslated." ;
    :hasDescription "Rotate the element and apply the translation on the rotated vector." ;
    :definedIn :Module_BigDFT_wahba ;
    :hasSignature "apply_Rt(R, t, A)" ;
    :hasArgument "R (required)" ;
    :hasArgument "t (required)" ;
    :hasArgument "A (required)" .

:Function_BigDFT_wahba_apply_t a :Function ;
    rdfs:label "apply_t" ;
    rdfs:comment "Apply a translation on the set of vectors A.\n\nArgs:\n  t (numpy.matrix): a translation matrix.\n  A (numpy.matrix): the set of vectors to translate.\n\nReturns:\n  (numpy.matrix): the set of vectors, translated by the matrix." ;
    :hasDescription "Apply a translation on the set of vectors A." ;
    :definedIn :Module_BigDFT_wahba ;
    :hasSignature "apply_t(t, A)" ;
    :hasArgument "t (required)" ;
    :hasArgument "A (required)" .

:Function_BigDFT_wahba_interpolate_points a :Function ;
    rdfs:label "interpolate_points" ;
    rdfs:comment "Given a set of points A and B, this generates a list of point sets\nthat interpolate between A and B in a specified number of steps.\n\nArgs:\n  A (numpy.matrix): an NX3 matrix of points.\n  B (numpy.matrix): a second NX3 matrix of points.\n  steps (int): the number of steps to take between A and B.\n  extrapolation_steps (int): optionally, we can extrapolate a number of\n    steps beyond B on the same trajectory.\n\nReturns:\n  (list): a list of points interpolating between A and B including\n  A and B." ;
    :hasDescription "Given a set of points A and B, this generates a list of point sets that interpolate between A and B in a specified number of steps." ;
    :definedIn :Module_BigDFT_wahba ;
    :hasSignature "interpolate_points(A, B, steps, extrapolation_steps=0)" ;
    :hasArgument "A (required)" ;
    :hasArgument "B (required)" ;
    :hasArgument "steps (required)" ;
    :hasArgument "extrapolation_steps=0" .

:Function_BigDFT_wahba_rigid_transform_3D a :Function ;
    rdfs:label "rigid_transform_3D" ;
    rdfs:comment "Find the transformation R and t such that R*A + t ~= B, with an error\nquantified by J.\n\nArgs:\n  A (numpy.matrix): an NX3 matrix of points.\n  B (numpy.matrix): a second NX3 matrix of points.\n  verbose (bool): whether to be verbose during the calculation.\n\nReturns:\n  (numpy.matrix): 3x3 rotation matrix/\n  (numpy.matrix): 3X1 column vector representing the translation.\n  (float): a quantification of the error." ;
    :hasDescription "Find the transformation R and t such that R*A + t ~= B, with an error quantified by J." ;
    :definedIn :Module_BigDFT_wahba ;
    :hasSignature "rigid_transform_3D(A, B, verbose=False)" ;
    :hasArgument "A (required)" ;
    :hasArgument "B (required)" ;
    :hasArgument "verbose=False" .

:Parameter_chess_foe_accuracy_entropy a :Parameter ;
    rdfs:label "chess.foe.accuracy_entropy" ;
    :hasDescription "Required accuracy for the Chebyshev fit for the function to calculate the entropy term" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 1e-09 to 0.01" .

:Parameter_chess_foe_accuracy_foe a :Parameter ;
    rdfs:label "chess.foe.accuracy_foe" ;
    :hasDescription "Required accuracy for the Chebyshev fit for FOE" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-5" ;
    :hasRange "from 1e-10 to 0.001" .

:Parameter_chess_foe_accuracy_ice a :Parameter ;
    rdfs:label "chess.foe.accuracy_ice" ;
    :hasDescription "Required accuracy for the Chebyshev fit for ICE (calculation of matrix powers)" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-8" ;
    :hasRange "from 1e-10 to 0.001" .

:Parameter_chess_foe_accuracy_penalty a :Parameter ;
    rdfs:label "chess.foe.accuracy_penalty" ;
    :hasDescription "Required accuracy for the Chebyshev fit for the penalty function" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-5" ;
    :hasRange "from 1e-10 to 0.001" .

:Parameter_chess_foe_adjust_fscale a :Parameter ;
    rdfs:label "chess.foe.adjust_fscale" ;
    :hasDescription "dynamically adjust the value of fscale or not" ;
    :inSection "chess.foe" ;
    :hasDefault "yes" .

:Parameter_chess_foe_betax_foe a :Parameter ;
    rdfs:label "chess.foe.betax_foe" ;
    :hasDescription "the exponent in the exponential penalty function which is used to determine the" ;
    :inSection "chess.foe" ;
    :hasDefault "-1000.0" ;
    :hasRange "from -10000.0 to -10.0" .

:Parameter_chess_foe_betax_ice a :Parameter ;
    rdfs:label "chess.foe.betax_ice" ;
    :hasDescription "the exponent in the exponential penalty function which is used to determine the" ;
    :inSection "chess.foe" ;
    :hasDefault "-1000.0" ;
    :hasRange "from -10000.0 to -10.0" .

:Parameter_chess_foe_ef_interpol_chargediff a :Parameter ;
    rdfs:label "chess.foe.ef_interpol_chargediff" ;
    :hasDescription "FOE max charge difference for interpolation" ;
    :inSection "chess.foe" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.0 to 1000.0" .

:Parameter_chess_foe_ef_interpol_det a :Parameter ;
    rdfs:label "chess.foe.ef_interpol_det" ;
    :hasDescription "FOE max determinant of cubic interpolation matrix" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-12" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_chess_foe_eval_range_foe a :Parameter ;
    rdfs:label "chess.foe.eval_range_foe" ;
    rdfs:comment "Indicates the lower and upper bound of the eigenvalue spectrum which is used for the Fermi Operator Expansion. This spectrum will be adjusted automatically if not chosen appropriately." ;
    :hasDescription "Lower and upper bound of the eigenvalue spectrum, will be adjusted" ;
    :inSection "chess.foe" ;
    :hasDefault "[-0.5, 0.5]" ;
    :hasRange "from -10.0 to 10.0" .

:Parameter_chess_foe_evbounds_nsatur a :Parameter ;
    rdfs:label "chess.foe.evbounds_nsatur" ;
    :hasDescription "Number of FOE cycles before the eigenvalue bounds are shrinked (linear)" ;
    :inSection "chess.foe" ;
    :hasDefault "3" .

:Parameter_chess_foe_evboundsshrink_nsatur a :Parameter ;
    rdfs:label "chess.foe.evboundsshrink_nsatur" ;
    :hasDescription "Maximal number of unsuccessful eigenvalue bounds shrinkings" ;
    :inSection "chess.foe" ;
    :hasDefault "4" .

:Parameter_chess_foe_fscale a :Parameter ;
    rdfs:label "chess.foe.fscale" ;
    rdfs:comment "Indicates the decay length of the error function which is used by the Fermi Operator Expasion to construct the density kernel. This value will be adjusted automatically if not chosen appropriately." ;
    :hasDescription "Initial guess for the error function decay length" ;
    :inSection "chess.foe" ;
    :hasDefault "5.e-2" ;
    :hasRange "from 0.0001 to 0.1" .

:Parameter_chess_foe_fscale_ediff_low a :Parameter ;
    rdfs:label "chess.foe.fscale_ediff_low" ;
    :hasDescription "lower bound for the optimal relative energy difference between the kernel and the" ;
    :inSection "chess.foe" ;
    :hasDefault "5.e-5" ;
    :hasRange "from 1e-07 to 0.001" .

:Parameter_chess_foe_fscale_ediff_up a :Parameter ;
    rdfs:label "chess.foe.fscale_ediff_up" ;
    :hasDescription "upper bound for the optimal relative energy difference between the kernel and the" ;
    :inSection "chess.foe" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 5e-06 to 0.05" .

:Parameter_chess_foe_fscale_lowerbound a :Parameter ;
    rdfs:label "chess.foe.fscale_lowerbound" ;
    :hasDescription "Lower bound for the error function decay length" ;
    :inSection "chess.foe" ;
    :hasDefault "5.e-3" ;
    :hasRange "from 0.0001 to 0.01" .

:Parameter_chess_foe_fscale_upperbound a :Parameter ;
    rdfs:label "chess.foe.fscale_upperbound" ;
    :hasDescription "Upper bound for the error function decay length" ;
    :inSection "chess.foe" ;
    :hasDefault "5.e-2" ;
    :hasRange "from 0.01 to 1.0" .

:Parameter_chess_foe_matmul_optimize_load_balancing a :Parameter ;
    rdfs:label "chess.foe.matmul_optimize_load_balancing" ;
    :hasDescription "optimize the load balancing of the sparse matrix matrix multiplications (at the cost" ;
    :inSection "chess.foe" ;
    :hasDefault "no" .

:Parameter_chess_foe_occupation_function a :Parameter ;
    rdfs:label "chess.foe.occupation_function" ;
    :hasDescription "the function to assign the occupation numbers" ;
    :inSection "chess.foe" ;
    :hasDefault "102" ;
    :hasAllowedValues "{'value': 102, 'label': 'error_function'}, {'value': 106, 'label': 'fermi_function'}" .

:Parameter_chess_lapack_blocksize_pdgemm a :Parameter ;
    rdfs:label "chess.lapack.blocksize_pdgemm" ;
    :hasDescription "SCALAPACK linear scaling blocksize for matrix matrix multiplication" ;
    :inSection "chess.lapack" ;
    :hasDefault "-8" .

:Parameter_chess_lapack_blocksize_pdsyev a :Parameter ;
    rdfs:label "chess.lapack.blocksize_pdsyev" ;
    :hasDescription "SCALAPACK linear scaling blocksize for diagonalization" ;
    :inSection "chess.lapack" ;
    :hasDefault "-8" .

:Parameter_chess_lapack_maxproc_pdgemm a :Parameter ;
    rdfs:label "chess.lapack.maxproc_pdgemm" ;
    :hasDescription "SCALAPACK linear scaling max num procs" ;
    :inSection "chess.lapack" ;
    :hasDefault "4" .

:Parameter_chess_lapack_maxproc_pdsyev a :Parameter ;
    rdfs:label "chess.lapack.maxproc_pdsyev" ;
    :hasDescription "SCALAPACK linear scaling max num procs" ;
    :inSection "chess.lapack" ;
    :hasDefault "4" .

:Parameter_chess_ntpoly_convergence_density a :Parameter ;
    rdfs:label "chess.ntpoly.convergence_density" ;
    :hasDescription "threshold for convergence of ntpoly purification calculation." ;
    :inSection "chess.ntpoly" ;
    :hasDefault "1.e-10" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_chess_ntpoly_convergence_overlap a :Parameter ;
    rdfs:label "chess.ntpoly.convergence_overlap" ;
    :hasDescription "threshold for convergence of ntpoly overlap inverse calculation." ;
    :inSection "chess.ntpoly" ;
    :hasDefault "1.e-10" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_chess_ntpoly_threshold_density a :Parameter ;
    rdfs:label "chess.ntpoly.threshold_density" ;
    :hasDescription "threshold for flushing small matrix values of the density matrix." ;
    :inSection "chess.ntpoly" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_chess_ntpoly_threshold_overlap a :Parameter ;
    rdfs:label "chess.ntpoly.threshold_overlap" ;
    :hasDescription "threshold for flushing small matrix values of the overlap matrix." ;
    :inSection "chess.ntpoly" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_dft_alpha_hf a :Parameter ;
    rdfs:label "dft.alpha_hf" ;
    rdfs:comment "By default .25 for PBE0, and .2 for B3LYP" ;
    :hasDescription "Part of the exact exchange contribution for hybrid functionals" ;
    :inSection "dft" ;
    :hasDefault "-1.0" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_dft_calculate_strten a :Parameter ;
    rdfs:label "dft.calculate_strten" ;
    rdfs:comment "In some cases, for example when doing MD for fixed volume systems, it might be useful to disable the calculation of the stress tensor, to save computational time." ;
    :hasDescription "Boolean to activate the calculation of the stress tensor. Might be set to No for" ;
    :inSection "dft" ;
    :hasDefault "Yes" .

:Parameter_dft_disablesym a :Parameter ;
    rdfs:label "dft.disablesym" ;
    rdfs:comment "Disable the symmetry detection (by default No except for isolated systems). By default symmetries are used to update the density in periodic boundary condition calculations, and surface boundary conditions also." ;
    :hasDescription "Disable the symmetry detection" ;
    :inSection "dft" ;
    :hasDefault "Yes" .

:Parameter_dft_dispersion a :Parameter ;
    rdfs:label "dft.dispersion" ;
    rdfs:comment "A non-zero values activates an empirical add-on treatment of dispersion effects. The values 1, 2 and 3 specify different switching on functions using the convention." ;
    :hasDescription "Dispersion correction potential (values 1,2,3,4,5), 0=none" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 5" .

:Parameter_dft_elecfield a :Parameter ;
    rdfs:label "dft.elecfield" ;
    rdfs:comment "Uniform electric field Ex, Ey, Ez in units of Ha/Bohr. The electric field can not have components in periodic directions, e.g. Ex = Ez = 0 in case surface BC is used." ;
    :hasDescription "Electric field (Ex,Ey,Ez)" ;
    :inSection "dft" ;
    :hasDefault "[0., 0., 0.]" .

:Parameter_dft_external_potential a :Parameter ;
    rdfs:label "dft.external_potential" ;
    rdfs:comment "Give the multipole moments up to quadrupoles" ;
    :hasDescription "Multipole moments of an external potential" ;
    :inSection "dft" ;
    :hasDefault "0.0" .

:Parameter_dft_gnrm_cv a :Parameter ;
    rdfs:label "dft.gnrm_cv" ;
    rdfs:comment "Convergence criterion for the wavefunction optimization (norm of the gradient). Reasonable values are in most cases between 1.d-4 and 1.d-5." ;
    :hasDescription "Convergence criterion gradient" ;
    :inSection "dft" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 1e-20 to 1.0" .

:Parameter_dft_gnrm_cv_virt a :Parameter ;
    rdfs:label "dft.gnrm_cv_virt" ;
    rdfs:comment "Norm of the gradient for virtual orbitals convergence. Calculates the results on the first nvirt orbitals" ;
    :hasDescription "Convergence criterion gradient for virtual orbitals" ;
    :inSection "dft" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 1e-20 to 1.0" .

:Parameter_dft_hgrids a :Parameter ;
    rdfs:label "dft.hgrids" ;
    rdfs:comment "Grid spacing in three directions (Bohr units) of the coarse mesh as [0.5, 0.45, 0.4]. A scalar can also be given as 0.45. The grid spacing of the Cartesian grid, in Bohr. As described in the wavelet formalism section, the nodes of this grid serve as the centers for the scaling function/wavelet basis. Values are in most cases between 0.3 and 0.6 bohr." ;
    :hasDescription "Grid spacing in the three directions (bohr)" ;
    :inSection "dft" ;
    :hasDefault "0.45" ;
    :hasRange "from 0.0 to 4.0" .

:Parameter_dft_idsx a :Parameter ;
    rdfs:label "dft.idsx" ;
    rdfs:comment "idsx gives the history length of the DIIS convergence acceleration in the wavefunction optimization. 6 is usually a good value for fast convergence. In case of convergence problems it can be advantageous to switch off DIIS by setting idsx = 0. The memory requirements grow considerably with large values of idsx. If memory is the limiting factor one has to choose idsx smaller than the value which gives the fastest convergence. The bigdft-tool tool can be used to predict the memory requirements for different choices of idsx." ;
    :hasDescription "Wfn. diis history" ;
    :inSection "dft" ;
    :hasDefault "6" ;
    :hasRange "from 0 to 15" .

:Parameter_dft_inputpsiid a :Parameter ;
    rdfs:label "dft.inputpsiid" ;
    rdfs:comment "Specifies how the input guess wavefunction is generated - -2 Random numbers are used as input guess. his is of course a poor input guess which will need many iterations of the wavefunction optimization and might even lead to divergences. - -1 The input wavefunction is imported from the CP2K code which uses Gaussian functions. The basis set should be contained in a file named gaubasis.dat whereas the coefficients should appear in the gaucoeff.dat file. Both files are the output files of CP2K code. See the H2O-CP2K test for an example. - 0 A subspace diagonalization in a minimal atomic basis set is used. This input guess should be used in general if one starts a new calculation. - 1 The previously calculated wavefunctions (for instance from the previous geometry optimization step) are used as input guess. Setting InputPsiId to this value does only make sense from within a main program where call_cluster() subroutine was called previously. The old wavefunction is passed to the new call via the data structure restart. - 2 The input wavefunction is read from the wavefunction. files which contain all the scaling function and wavelet coefficients. In case some parameters such as hgrids or crmult have changed, compared to the previous run, the wavefunctions will be also transformed to the new parameter set. Use also this value to restart from ETSF file format wavefunction-etsf.nc. - 10 The same as 0 but activates the ’Gaussian help’ after convergence the wavefunctions are projected onto the localised basis set used for the input guess, and Mulliken Charge Population Analysis (MCPA) is performed on this basis. The user has the possibility to perform MCPA with separate basis set (functionality to be added). - 11 Restart with Gaussian approximation contained in the ’restart’ data structure. - 12 The input wavefunction is read from the wavefunctions.gau file, which contains an approximation in a minimal Gaussian basis set of the previously calculated wavefunctions. - 100 Use Linear Atomic Orbitals - 101 Restart for Linear - 102 Linear on disk" ;
    :hasDescription "Input guess wavefunctions" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': -1000, 'label': 'Empty'}, {'value': -2, 'label': 'Random'}, {'value': -1, 'label': 'CP2K'}, {'value': 0, 'label': 'LCAO'}, {'value': 1, 'label': 'Wvl. in memory'}, {'value': 2, 'label': 'Wvl. on disk'}, {'value': 3, 'label': 'Plane-waves on disk'}, {'value': 10, 'label': 'LCAO + gauss.'}, {'value': 11, 'label': 'Gauss. in memory'}, {'value': 12, 'label': 'Gauss. on disk'}, {'value': 100, 'label': 'Linear AO'}, {'value': 101, 'label': 'Linear restart'}, {'value': 102, 'label': 'Linear on disk'}" .

:Parameter_dft_itermax a :Parameter ;
    rdfs:label "dft.itermax" ;
    rdfs:comment "Maximum number of gradient evaluations for a single cycle in a wavefunction optimization and maximum number of cycles. At the end of each cycle a subspace diagonalization is done which helps in cases where one has near degeneracy between the HOMO and LUMO orbitals. 50 are usually sufficient." ;
    :hasDescription "Max. iterations of wfn. opt. steps" ;
    :inSection "dft" ;
    :hasDefault "50" ;
    :hasRange "from 0 to 10000" .

:Parameter_dft_itermax_occ_ctrl a :Parameter ;
    rdfs:label "dft.itermax_occ_ctrl" ;
    :hasDescription "Number of iterations of occupancy control scheme. Should be between itermin and" ;
    :inSection "dft" ;
    :hasDefault "0" .

:Parameter_dft_itermax_virt a :Parameter ;
    rdfs:label "dft.itermax_virt" ;
    rdfs:comment "Maximum number of gradient evaluations for a cycle of a wavefunction optimization for the virtual orbitals." ;
    :hasDescription "Max. iterations of wfn. opt. steps for virtual orbitals" ;
    :inSection "dft" ;
    :hasDefault "50" ;
    :hasRange "from 0 to 10000" .

:Parameter_dft_itermin a :Parameter ;
    rdfs:label "dft.itermin" ;
    :hasDescription "Minimal iterations of wfn. optimized steps" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 10000" .

:Parameter_dft_ixc a :Parameter ;
    rdfs:label "dft.ixc" ;
    rdfs:comment "Determine the exchange-correlation functional. Integer specifying which exchange correlation functional will be used. The Abinit conventions are used and detailed information can be found on the Abinit Web page. Here is only a short summary of some widely used functionals - Pade LDA from Abinit XC library; - PBE from Abinit XC library; - Pade LDA from libXC; - PBE from libXC; - PBEsol from libXC; - PBE0 Hybrid functional (local part from libXC). A positive integer refers to a functional from ABINIT library and a negative one from libXC library. In this case, you concatenate the codes for the exchange part and for the correlation part (see the table of codes)." ;
    :hasDescription "Exchange-correlation parameter (LDA=1,PBE=11)" ;
    :inSection "dft" ;
    :hasDefault "-101130" .

:Parameter_dft_local_potential a :Parameter ;
    rdfs:label "dft.local_potential" ;
    :hasDescription "Path to the local potential" ;
    :inSection "dft" ;
    :hasDefault "\"\"" .

:Parameter_dft_magnetic_torque a :Parameter ;
    rdfs:label "dft.magnetic_torque" ;
    :hasDescription "Boolean to activate the calculation of the direction of the atomic magnetization which lowers the total energy" ;
    :inSection "dft" ;
    :hasDefault "false" .

:Parameter_dft_mpol a :Parameter ;
    rdfs:label "dft.mpol" ;
    rdfs:comment "Total magnetic moment which has to be the same parity as the total number of electrons (nelec_up-nelec_down=mpol). You should also define the keyword 'IGSpin' or add a spin per atom to specify the polarisation for the input guess." ;
    :hasDescription "Total magnetic moment" ;
    :inSection "dft" ;
    :hasDefault "0" .

:Parameter_dft_ncong a :Parameter ;
    rdfs:label "dft.ncong" ;
    rdfs:comment "ncong gives the number of iterations in the solution of the preconditioning equation. For free boundary conditions 5 is a good value whereas for other boundary condition a value from 0 to 2 is in general sufficient. Large values of ncong lead to a smaller number of iterations in the wavefunction optimization and better forces, but each iteration is more costly. So an optimal compromise value has to be found." ;
    :hasDescription "No. of CG it. for preconditioning eq." ;
    :inSection "dft" ;
    :hasDefault "6" ;
    :hasRange "from 0 to 20" .

:Parameter_dft_ncongt a :Parameter ;
    rdfs:label "dft.ncongt" ;
    rdfs:comment "Far reaching tails of the wavefunctions decaying into the vacuum are added in a perturbative treatment if the variable rbuf is set to a strictly positive value. This allows to do a calculation with some moderate value of crmult and then to extrapolate to the limit of large crmult. This procedure is not variational and gives too low energies. The true energy is in between the two energies and in general much closer to the extrapolated energy. This procedure can also be used to judge whether the chosen value of crmult is large enough for a certain required precision. rbuf gives the amount by which the radii for the coarse resolution region are increased in atomic units. ncongt gives the number of iterations used in the perturbation calculation. Reasonable values for ncongt are around 30." ;
    :hasDescription "No. of tail CG iterations" ;
    :inSection "dft" ;
    :hasDefault "30" ;
    :hasRange "from 0 to 50" .

:Parameter_dft_ngrids a :Parameter ;
    rdfs:label "dft.ngrids" ;
    rdfs:comment "Number of grid spacing division in each direction. Values are relevant only for periodic directions. This is convenient to keep the constant the number of wavelets when changing the super-cell dimensions. These values override hgrid ones." ;
    :hasDescription "Number of grid spacing division in each direction" ;
    :inSection "dft" ;
    :hasDefault "[0, 0, 0]" ;
    :hasRange "from 0 to 1000" .

:Parameter_dft_norbv a :Parameter ;
    rdfs:label "dft.norbv" ;
    rdfs:comment "Determine the dimension of the subspace i.e. the number of virtual orbitals to calculate via a Davidson diagonalisation. Usually unoccupied orbitals are not calculated since they are not needed for the total energy and other physical properties of the electronic ground state. Putting norbv to a non-zero value will result in the calculation of norbv virtual orbitals in a postprocessing routine after the occupied orbitals have been calculated, which uses Davidson iterative treatment. nvirt (< norbv) determines to the number of converged orbitals during the convergence process which is taking care of during the Davidson iterations. nplot of these orbitals will be written in the virtual.*.pot files and nplot (if that many exist) of the highest occupied orbitals will be written in the orbital.*.pot file. The Kohn Sham eigenvalues are written in the ordinary output file." ;
    :hasDescription "Davidson subspace dimension (No. virtual orbitals)" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from -9999 to 9999" .

:Parameter_dft_nplot a :Parameter ;
    rdfs:label "dft.nplot" ;
    rdfs:comment "Number of orbitals to be plotted Determine the dimension of the subspace i.e. the number of virtual orbitals to calculate via a Davidson diagonalisation. Usually unoccupied orbitals are not calculated since they are not needed for the total energy and other physical properties of the electronic ground state. Putting norbv to a non-zero value will result in the calculation of norbv virtual orbitals in a postprocessing routine after the occupied orbitals have been calculated, which uses Davidson iterative treatment . nplot of these orbitals will be written in the virtual.*.pot files and nplot (if that many exist) of the highest occupied orbitals will be written in the orbital.*.pot file The Kohn Sham eigenvalues are written in the ordinary output file. nvirt corresponds to the actual number of orbitals the convergence process is taking care of during the Davidson iterations." ;
    :hasDescription "No. of plotted orbs" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 9999" .

:Parameter_dft_nrepmax a :Parameter ;
    rdfs:label "dft.nrepmax" ;
    rdfs:comment "Maximum number of gradient evaluations for a single cycle in a wavefunction optimization and maximum number of cycles. At the end of each cycle a subspace diagonalization is done which helps in cases where one has near degeneracy between the HOMO and LUMO orbitals. 50 are usually sufficient." ;
    :hasDescription "Max. number of re-diag. runs" ;
    :inSection "dft" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 1000" .

:Parameter_dft_nrepmax_occ_ctrl a :Parameter ;
    rdfs:label "dft.nrepmax_occ_ctrl" ;
    :hasDescription "Number of re-diagonalizations of occupancy control scheme." ;
    :inSection "dft" ;
    :hasDefault "1" .

:Parameter_dft_nspin a :Parameter ;
    rdfs:label "dft.nspin" ;
    rdfs:comment "Spin polarization treatment; 1 no spin (as LDA), 2 spin-polarisation (LSD or collinear) and 4 non-collinear i.e. two components per electron." ;
    :hasDescription "Spin polarization treatment" ;
    :inSection "dft" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 1, 'label': 'No spin'}, {'value': 2, 'label': 'Collinear'}, {'value': 4, 'label': 'Non-collinear'}" .

:Parameter_dft_nvirt a :Parameter ;
    rdfs:label "dft.nvirt" ;
    rdfs:comment "Determine the dimension of the subspace i.e. the number of virtual orbitals to be converged via a Davidson diagonalisation. (should be < norbv) Usually unoccupied orbitals are not calculated since they are not needed for the total energy and other physical properties of the electronic ground state. Putting norbv to a non-zero value will result in the calculation of norbv virtual orbitals in a postprocessing routine after the occupied orbitals have been calculated, which uses Davidson iterative treatment. nvirt (< norbv) determines to the number of converged orbitals during the convergence process which is taking care of during the Davidson iterations. nplot of these orbitals will be written in the virtual.*.pot files and nplot (if that many exist) of the highest occupied orbitals will be written in the orbital.*.pot file. The Kohn Sham eigenvalues are written in the ordinary output file." ;
    :hasDescription "No. of converged virtual orbs (< norbv)" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 9999" .

:Parameter_dft_occupancy_control a :Parameter ;
    rdfs:label "dft.occupancy_control" ;
    rdfs:comment "The atomic species or the atoms written as Atom No are specified, followed by a dictionary of the shells for which the density matrix can be controlled. The Value of the matrix can be specified either as a trace or as explicit matrix elements." ;
    :hasDescription "Dictionary of the atomic matrices to be applied for a given iteration number" ;
    :inSection "dft" ;
    :hasDefault "None" .

:Parameter_dft_output_denspot a :Parameter ;
    rdfs:label "dft.output_denspot" ;
    rdfs:comment "controls the output of density and pontentials on disk at the end of the calculation - output_denspot = 0, No output density is written. - output_denspot = 1, Output electronic density is written in the .pot format of V_Sim into the file electronic_density.pot (deprecated, use 11 instead). - output_denspot = 2, In addition to the electronic density, the potential (local_potential.pot) and its components (external_potential.pot and Hartree_potential.pot) are also output in plain text .pot files (deprecated, use 12 instead). - output_denspot = 11, Same as output_denspot = 1, but files are written in ETSF file format (portable binary format based on NetCDF). - output_denspot = 12, Same as output_denspot = 2, but files are written in ETSF file format (portable binary format based on NetCDF). - output_denspot = 21, Same as output_denspot = 1, but files are written in .cube file format (plain text). - output_denspot = 22, Same as output_denspot = 2, but files are written in .cube file format (plain text)." ;
    :hasDescription "Output of the density or the potential" ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'None'}, {'value': 1, 'label': 'Density in plain text'}, {'value': 2, 'label': 'Density and potentials in plain text'}, {'value': 11, 'label': 'Density in ETSF file format'}, {'value': 12, 'label': 'Density and potentials in ETSF file format'}, {'value': 21, 'label': 'Density in cube file format'}, {'value': 22, 'label': 'Density and potentials in cube file format'}" .

:Parameter_dft_plot_mppot_axes a :Parameter ;
    rdfs:label "dft.plot_mppot_axes" ;
    rdfs:comment "If present, the potential generated by the multipoles will be written in the .cube format and also be plotted along axes through the specified point. If no plot is desired, the values should be negative." ;
    :hasDescription "Plot the potential generated by the multipoles along axes through this" ;
    :inSection "dft" ;
    :hasDefault "[-1, -1, -1]" .

:Parameter_dft_plot_pot_axes a :Parameter ;
    rdfs:label "dft.plot_pot_axes" ;
    rdfs:comment "If present and the chosen plotting format is .cube, the potential will be written in the .cube format and also be plotted along axes through the specified point. If no plot is desired, the values should be negative." ;
    :hasDescription "Plot the potential along axes through this point. Negative values mean" ;
    :inSection "dft" ;
    :hasDefault "[-1, -1, -1]" .

:Parameter_dft_projection a :Parameter ;
    rdfs:label "dft.projection" ;
    rdfs:comment "Specifies how the projectors are expressed in Daubechies from atomic description" ;
    :hasDescription "Projector construction method" ;
    :inSection "dft" ;
    :hasDefault "gaussian" ;
    :hasAllowedValues "{'value': 'gaussian', 'label': 'tensor product of 1D separable gaussians'}, {'value': 'radial', 'label': 'real space collocation of radial functions'}, {'value': 'radial+mp', 'label': 'as radial, but using multipole preserving techniques'}" .

:Parameter_dft_qcharge a :Parameter ;
    rdfs:label "dft.qcharge" ;
    rdfs:comment "Total charge of the system. A positive qcharge means that electrons are taken away and a negative one means that extra electrons are added." ;
    :hasDescription "Charge of the system. Can be integer or real." ;
    :inSection "dft" ;
    :hasDefault "0" ;
    :hasRange "from -500.0 to 500.0" .

:Parameter_dft_rbuf a :Parameter ;
    rdfs:label "dft.rbuf" ;
    :hasDescription "Length of the tail (AU)" ;
    :inSection "dft" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_dft_rmult a :Parameter ;
    rdfs:label "dft.rmult" ;
    rdfs:comment "Coarse and fine multiplier as [4.0, 8.0]. These numbers determine the extension of the coarse and fine region respectively." ;
    :hasDescription "c(f)rmult*radii_cf(:,1(2))=coarse(fine) atom-based radius" ;
    :inSection "dft" ;
    :hasDefault "[5.0, 8.0]" ;
    :hasRange "from 0.0 to 20.0" .

:Parameter_dft_spin_dynamics a :Parameter ;
    rdfs:label "dft.spin_dynamics" ;
    :hasDescription "Boolean to activate the calculation of the direction of the atomic magnetization which lowers the total energy" ;
    :inSection "dft" ;
    :hasDefault "false" .

:Parameter_geopt_beta_stretchx a :Parameter ;
    rdfs:label "geopt.beta_stretchx" ;
    :hasDescription "Stepsize for steepest descent in stretching mode direction (only if in biomode)" ;
    :inSection "geopt" ;
    :hasDefault "5e-1" ;
    :hasRange "from 0.0 to 100.0" .

:Parameter_geopt_betax a :Parameter ;
    rdfs:label "geopt.betax" ;
    rdfs:comment "This is the stepsize for the geometry optimization. This stepsize is system dependent and it has therefore to be determined for each system. If the VSSD method is used one can start with a small stepsize of around 1 and VSSD will suggest then a better value for {betax} in the last line of the data/geopt.mon file. Whether the stepsize is correct can also be seen from the data/geopt.mon output of the SDCG method. In this case the average stepsize in terms of betax should be around 4 (after a brief initial period where it is around 8). In contrast to the SDCG method, the BFGS method is not very sensitive to the correct stepsize but nevertheless one should try to find reasonable values also in this case. SQNM: For many systems 1 is a good stepsize. Some systems can be minimized more efficiently with a larger stepsize." ;
    :hasDescription "Stepsize for the geometry optimization" ;
    :inSection "geopt" ;
    :hasDefault "4." ;
    :hasRange "from 0.0 to 100.0" .

:Parameter_geopt_biomode a :Parameter ;
    rdfs:label "geopt.biomode" ;
    :hasDescription "Enable mode for biomolecules." ;
    :inSection "geopt" ;
    :hasDefault "false" .

:Parameter_geopt_bmass a :Parameter ;
    rdfs:label "geopt.bmass" ;
    :hasDescription "Barostat masses (isothermal/isenthalpic ensemble)" ;
    :inSection "geopt" ;
    :hasDefault "10.0" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_geopt_climbing a :Parameter ;
    rdfs:label "geopt.climbing" ;
    :hasDescription "Make the highest energy image to climb along the path" ;
    :inSection "geopt" ;
    :hasDefault "false" .

:Parameter_geopt_cutoffratio a :Parameter ;
    rdfs:label "geopt.cutoffratio" ;
    :hasDescription "If ratio of eigenvalues of displacement overlapmatrix is smaller than cutoffratio, the corresponding directions are not used" ;
    :inSection "geopt" ;
    :hasDefault "0.0001" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_geopt_damp a :Parameter ;
    rdfs:label "geopt.damp" ;
    :hasDescription "Damping factor" ;
    :inSection "geopt" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.0 to 1000.0" .

:Parameter_geopt_dtinit a :Parameter ;
    rdfs:label "geopt.dtinit" ;
    :hasDescription "Initial time step for the FIRE method" ;
    :inSection "geopt" ;
    :hasDefault "0.75" ;
    :hasRange "from 0 to 10000.0" .

:Parameter_geopt_dtion a :Parameter ;
    rdfs:label "geopt.dtion" ;
    :hasDescription "Time step - Atomic Units (20.670689 AU=0.5 fs)" ;
    :inSection "geopt" ;
    :hasDefault "20.670689" ;
    :hasRange "from 0 to 1000.0" .

:Parameter_geopt_dtmax a :Parameter ;
    rdfs:label "geopt.dtmax" ;
    :hasDescription "Maximal time step for the FIRE method" ;
    :inSection "geopt" ;
    :hasDefault "1.5" ;
    :hasRange "from 0 to 10000.0" .

:Parameter_geopt_extrema_opt a :Parameter ;
    rdfs:label "geopt.extrema_opt" ;
    :hasDescription "Minimize the energy of extremum images during NEB optimization" ;
    :inSection "geopt" ;
    :hasDefault "false" .

:Parameter_geopt_fix_tol a :Parameter ;
    rdfs:label "geopt.fix_tol" ;
    :hasDescription "Tolerance to apply on atom moves between extrema" ;
    :inSection "geopt" ;
    :hasDefault "0.0001" ;
    :hasRange "from 0 to 100" .

:Parameter_geopt_forcemax a :Parameter ;
    rdfs:label "geopt.forcemax" ;
    rdfs:comment "Convergence criteria for the geometry optimization. The geometry optimization stops either if the norm of the individual forces acting on any atom in the system is smaller than forcemax or if the forces get noisy. Noise is present because of the underlying integration grid. The parameter frac_fluct specifies how small the forces should become compared to the noise level to stop the geometry optimization. Values in between 1 and 10 is are reasonable for this parameter. A value of 2 means that the geometry optimization will stop when the largest atomic force is comparable to the 2 times the average noise in the forces themselves. For values of frac_fluct smaller than 1 one can under certain circumstances obtain better relaxed geometries but one risks that the geometry optimization will not converge since the forces are too noisy. In such a case one should closely monitor the progress of the geometry optimization by looking at the posout. files which are written at each step of the geometry optimization and at the data/geopt.mon file." ;
    :hasDescription "Max forces criterion when stop" ;
    :inSection "geopt" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_geopt_frac_fluct a :Parameter ;
    rdfs:label "geopt.frac_fluct" ;
    rdfs:comment "Convergence criteria for the geometry optimization. The geometry optimization stops either if the norm of the individual forces acting on any atom in the system is smaller than forcemax or if the forces get noisy. Noise is present because of the underlying integration grid. The parameter frac_fluct specifies how small the forces should become compared to the noise level to stop the geometry optimization. Values in between 1 and 10 is are reasonable for this parameter. A value of 2 means that the geometry optimization will stop when the largest atomic force is comparable to the 2 times the average noise in the forces themselves. For values of frac_fluct smaller than 1 one can under certain circumstances obtain better relaxed geometries but one risks that the geometry optimization will not converge since the forces are too noisy. In such a case one should closely monitor the progress of the geometry optimization by looking at the posout. files which are written at each step of the geometry optimization and at the data/geopt.mon file." ;
    :hasDescription "Fraction of force fluctuations. Stop if fmax < forces_fluct*frac_fluct" ;
    :inSection "geopt" ;
    :hasDefault "1." ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_geopt_friction a :Parameter ;
    rdfs:label "geopt.friction" ;
    :hasDescription "Friction coefficient for Langevin dynamics" ;
    :inSection "geopt" ;
    :hasDefault "0.001" ;
    :hasRange "from 0 to 100000.0" .

:Parameter_geopt_history a :Parameter ;
    rdfs:label "geopt.history" ;
    :hasDescription "History for DIIS method" ;
    :inSection "geopt" ;
    :hasDefault "4" ;
    :hasRange "from 0 to 100" .

:Parameter_geopt_ionmov a :Parameter ;
    rdfs:label "geopt.ionmov" ;
    :hasDescription "Movement ion method" ;
    :inSection "geopt" ;
    :hasDefault "6" ;
    :hasAllowedValues "{'value': 6, 'label': 'Simple velocity-Verlet molecular dynamic'}, {'value': 7, 'label': 'Quenched molecular dynamic'}, {'value': 8, 'label': 'Nose-Hoover thermostat'}, {'value': 9, 'label': 'Langevin dynamic'}, {'value': 12, 'label': 'Isokinetic ensemble molecular dynamics'}, {'value': 13, 'label': 'Iosthermal/isenthalpic ensemble'}" .

:Parameter_geopt_maxrise a :Parameter ;
    rdfs:label "geopt.maxrise" ;
    :hasDescription "Maximum allowed rise in energy in one geopt step" ;
    :inSection "geopt" ;
    :hasDefault "1e-06" ;
    :hasRange "from 0.0 to 10000000000.0" .

:Parameter_geopt_mdftemp a :Parameter ;
    rdfs:label "geopt.mdftemp" ;
    :hasDescription "Final temperature of molecular dynamics" ;
    :inSection "geopt" ;
    :hasDefault "300.0" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_geopt_mditemp a :Parameter ;
    rdfs:label "geopt.mditemp" ;
    :hasDescription "Temperature of molecular dynamics" ;
    :inSection "geopt" ;
    :hasDefault "300.0" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_geopt_mdwall a :Parameter ;
    rdfs:label "geopt.mdwall" ;
    :hasDescription "Distance in bohr where atoms can bounce for Langevin dynamics" ;
    :inSection "geopt" ;
    :hasDefault "10000.0" ;
    :hasRange "from 0 to 100000.0" .

:Parameter_geopt_method a :Parameter ;
    rdfs:label "geopt.method" ;
    :hasDescription "Geometry optimisation method" ;
    :inSection "geopt" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'No geometry optimization'}, {'value': 'SDCG', 'label': 'A combination of Steepest Descent and Conjugate Gradient'}, {'value': 'VSSD', 'label': 'Variable Stepsize Steepest Descent method'}, {'value': 'LBFGS', 'label': 'Limited-memory BFGS'}, {'value': 'BFGS', 'label': 'Broyden-Fletcher-Goldfarb-Shanno'}, {'value': 'PBFGS', 'label': 'Same as BFGS with an initial Hessian obtained from a force field'}, {'value': 'AB6MD', 'label': 'Molecular dynamics from ABINIT'}, {'value': 'DIIS', 'label': 'Direct inversion of iterative subspace'}, {'value': 'FIRE', 'label': 'Fast Inertial Relaxation Engine as described by Bitzek et al.'}, {'value': 'SOCK', 'label': 'Socket communication'}, {'value': 'NEB', 'label': 'Nudged Elastic Band'}, {'value': 'SBFGS', 'label': 'SQNM minimizer, keyword deprecated, will be replaced by SQNM in future release'}, {'value': 'SQNM', 'label': 'Stabilized quasi-Newton minimzer'}, {'value': 'MD', 'label': 'Molecular dynamics, NVT (Nose-Hoover Chains) or NVE ensemble'}, {'value': 'LOOP', 'label': 'Do nothing except looping, forces should be changed externally'}" .

:Parameter_geopt_ncount_cluster_x a :Parameter ;
    rdfs:label "geopt.ncount_cluster_x" ;
    rdfs:comment "Maximum number of force evaluations to be used for the geometry optimization." ;
    :hasDescription "Maximum number of force evaluations" ;
    :inSection "geopt" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 2000" .

:Parameter_geopt_neb_method a :Parameter ;
    rdfs:label "geopt.neb_method" ;
    :hasDescription "Image minimization method" ;
    :inSection "geopt" ;
    :hasDefault "\"quick-min\"" ;
    :hasAllowedValues "{'value': 'steepest_descent', 'label': 'steepest descent'}, {'value': 'fletcher-reeves', 'label': 'Fletcher Reeves'}, {'value': 'polak-ribiere', 'label': 'Polak Ribiere'}, {'value': 'quick-min', 'label': 'Conjugate gradient'}, {'value': 'damped-verlet', 'label': 'Verlet with damp'}, {'value': 'sim-annealing', 'label': 'Simulation of annealing'}" .

:Parameter_geopt_nhistx a :Parameter ;
    rdfs:label "geopt.nhistx" ;
    :hasDescription "Maximum history length" ;
    :inSection "geopt" ;
    :hasDefault "10" ;
    :hasRange "from 0 to 1000" .

:Parameter_geopt_nimg a :Parameter ;
    rdfs:label "geopt.nimg" ;
    :hasDescription "Number of images" ;
    :inSection "geopt" ;
    :hasDefault "15" ;
    :hasRange "from 3 to 100" .

:Parameter_geopt_noseinert a :Parameter ;
    rdfs:label "geopt.noseinert" ;
    :hasDescription "Thermostat inertia coefficient for Nose_Hoover dynamics" ;
    :inSection "geopt" ;
    :hasDefault "100000.0" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_geopt_qmass a :Parameter ;
    rdfs:label "geopt.qmass" ;
    :hasDescription "Mass of each thermostat (isothermal/isenthalpic ensemble)" ;
    :inSection "geopt" ;
    :hasDefault "[0.0]" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_geopt_randdis a :Parameter ;
    rdfs:label "geopt.randdis" ;
    rdfs:comment "This parameter allows to add random displacements with amplitude randdis to the atomic positions in the input file posinp. This can for instance be useful to break degeneracies (which would lead to convergence problems in the wavefunction optimization) in highly symmetric structures." ;
    :hasDescription "Random displacement amplitude" ;
    :inSection "geopt" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_geopt_sockhost a :Parameter ;
    rdfs:label "geopt.sockhost" ;
    :hasDescription "Socket host name" ;
    :inSection "geopt" ;
    :hasDefault "\"127.0.0.1\"" .

:Parameter_geopt_sockinet a :Parameter ;
    rdfs:label "geopt.sockinet" ;
    :hasDescription "Socket either unix (0) or tcp (1)" ;
    :inSection "geopt" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 1" .

:Parameter_geopt_sockport a :Parameter ;
    rdfs:label "geopt.sockport" ;
    :hasDescription "Socket port number" ;
    :inSection "geopt" ;
    :hasDefault "2121" ;
    :hasRange "from 0 to 100000" .

:Parameter_geopt_springs_k a :Parameter ;
    rdfs:label "geopt.springs_k" ;
    :hasDescription "Maximum and minimum value when changing spring constant during optimization" ;
    :inSection "geopt" ;
    :hasDefault "[0.05, 0.1]" ;
    :hasRange "from 0.0 to 1000.0" .

:Parameter_geopt_steepthresh a :Parameter ;
    rdfs:label "geopt.steepthresh" ;
    :hasDescription "If fmax < steepthresh, geopt method uses steepest descent" ;
    :inSection "geopt" ;
    :hasDefault "0.1" ;
    :hasRange "from 0.0 to 10000000000.0" .

:Parameter_geopt_temp a :Parameter ;
    rdfs:label "geopt.temp" ;
    :hasDescription "Temperature for simulated annealing" ;
    :inSection "geopt" ;
    :hasDefault "0.0" ;
    :hasRange "from 0.0 to 1000.0" .

:Parameter_geopt_trustr a :Parameter ;
    rdfs:label "geopt.trustr" ;
    :hasDescription "Maximum displacement of single atom" ;
    :inSection "geopt" ;
    :hasDefault "0.5" ;
    :hasRange "from 0.0 to 10000000000.0" .

:Parameter_geopt_vmass a :Parameter ;
    rdfs:label "geopt.vmass" ;
    :hasDescription "Barostat masses (isothermal/isenthalpic ensemble)" ;
    :inSection "geopt" ;
    :hasDefault "1.0" ;
    :hasRange "from 0 to 1000000000.0" .

:Parameter_kpt_bands a :Parameter ;
    rdfs:label "kpt.bands" ;
    :hasDescription "For doing band structure calculation" ;
    :inSection "kpt" ;
    :hasDefault "No" .

:Parameter_kpt_iseg a :Parameter ;
    rdfs:label "kpt.iseg" ;
    :hasDescription "Points for each segment of the Brillouin zone path" ;
    :inSection "kpt" ;
    :hasDefault "[1]" .

:Parameter_kpt_kpt a :Parameter ;
    rdfs:label "kpt.kpt" ;
    :hasDescription "Kpt coordinates" ;
    :inSection "kpt" ;
    :hasDefault "[[0.0, 0.0, 0.0]]" .

:Parameter_kpt_kptrlen a :Parameter ;
    rdfs:label "kpt.kptrlen" ;
    :hasDescription "Equivalent length of K-space resolution (Bohr)" ;
    :inSection "kpt" ;
    :hasDefault "0.0" ;
    :hasRange "from 0 to 10000.0" .

:Parameter_kpt_kptv a :Parameter ;
    rdfs:label "kpt.kptv" ;
    :hasDescription "K points defining each segment of the Brillouin zone path" ;
    :inSection "kpt" ;
    :hasDefault "[[0.0, 0.0, 0.0], [0.5, 0.5, 0.5]]" .

:Parameter_kpt_method a :Parameter ;
    rdfs:label "kpt.method" ;
    :hasDescription "K-point sampling method" ;
    :inSection "kpt" ;
    :hasDefault "manual" ;
    :hasAllowedValues "{'value': 'auto', 'label': 'Based on kptrlen'}, {'value': 'mpgrid', 'label': 'Monkhorst-Pack'}, {'value': 'manual', 'label': 'Based on raw coordinates'}" .

:Parameter_kpt_ngkpt a :Parameter ;
    rdfs:label "kpt.ngkpt" ;
    :hasDescription "No. of Monkhorst-Pack grid points" ;
    :inSection "kpt" ;
    :hasDefault "[1, 1, 1]" ;
    :hasRange "from 1 to 10000" .

:Parameter_kpt_ngranularity a :Parameter ;
    rdfs:label "kpt.ngranularity" ;
    :hasDescription "No. of points done for each group" ;
    :inSection "kpt" ;
    :hasDefault "1" ;
    :hasRange "from 1 to 1000" .

:Parameter_kpt_shiftk a :Parameter ;
    rdfs:label "kpt.shiftk" ;
    :hasDescription "Grid shifts" ;
    :inSection "kpt" ;
    :hasDefault "[[0.0, 0.0, 0.0]]" .

:Parameter_kpt_wkpt a :Parameter ;
    rdfs:label "kpt.wkpt" ;
    :hasDescription "Kpt weights" ;
    :inSection "kpt" ;
    :hasDefault "[1.]" ;
    :hasRange "from 0.0 to 10000.0" .

:Parameter_lin_basis_alpha_diis a :Parameter ;
    rdfs:label "lin_basis.alpha_diis" ;
    rdfs:comment "possible value: 2 positive real numbers The support functions gradient is multiplied by this number before being used for the DIIS optimization. The first entry for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Multiplicator for DIIS" ;
    :inSection "lin_basis" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.1 to 10" .

:Parameter_lin_basis_alpha_sd a :Parameter ;
    rdfs:label "lin_basis.alpha_sd" ;
    rdfs:comment "The initial step size which is used to optimize the support functions with steepest descent. If the specified value is not appropriate, it will be adjusted automatically. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Initial step size for SD" ;
    :inSection "lin_basis" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.0001 to 10.0" .

:Parameter_lin_basis_correction_orthoconstraint a :Parameter ;
    rdfs:label "lin_basis.correction_orthoconstraint" ;
    rdfs:comment "Indicates whether the slight non-orthogonality of the support functions should be taken into account during the application of the orthogonality constraint - 0 => take into account - 1 => don't take into account" ;
    :hasDescription "Correction for the slight non-orthonormality in the orthoconstraint" ;
    :inSection "lin_basis" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 1" .

:Parameter_lin_basis_deltae_cv a :Parameter ;
    rdfs:label "lin_basis.deltae_cv" ;
    rdfs:comment "The optimization of the support functions stops if the total relative gain in the target function during the given cycle of support function optimization falls below this threshold" ;
    :hasDescription "Total relative energy difference to stop the optimization ('experimental_mode' only)" ;
    :inSection "lin_basis" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 1e-06 to 0.1" .

:Parameter_lin_basis_extended_ig a :Parameter ;
    rdfs:label "lin_basis.extended_ig" ;
    :hasDescription "whether or not to do an extended input guess (will be activated by default in" ;
    :inSection "lin_basis" ;
    :hasDefault "No" .

:Parameter_lin_basis_fix_basis a :Parameter ;
    rdfs:label "lin_basis.fix_basis" ;
    :hasDescription "Fix the support functions if the density change is below this threshold" ;
    :inSection "lin_basis" ;
    :hasDefault "1.e-10" ;
    :hasRange "from 1e-14 to 1e-06" .

:Parameter_lin_basis_gnrm_cv a :Parameter ;
    rdfs:label "lin_basis.gnrm_cv" ;
    rdfs:comment "Convergence criterion for optimization of the support functions (high / low accuracy). The optimization stops if the mean gradient norm falls below this threshold. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Convergence criterion for the optimization of the support functions" ;
    :inSection "lin_basis" ;
    :hasDefault "[1.e-2, 1.e-4]" ;
    :hasRange "from 1e-06 to 1.0" .

:Parameter_lin_basis_gnrm_dyn a :Parameter ;
    rdfs:label "lin_basis.gnrm_dyn" ;
    rdfs:comment "From this value the effective dynamic convergence criterion is calculated by a division by kappa. Then the optimization of the support functions stops if the mean gradient norm falls below this effective dynamic convergence criterion and is at the same time smaller than the value of min_gnrm_for_dynamic. The specified value should be approximately 10 times smaller than the value of gnrm_cv. This value is only used for the experimental mode." ;
    :hasDescription "Dynamic convergence criterion ('experimental_mode' only)" ;
    :inSection "lin_basis" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 1e-07 to 0.1" .

:Parameter_lin_basis_gnrm_ig a :Parameter ;
    rdfs:label "lin_basis.gnrm_ig" ;
    :hasDescription "Convergence criterion for the optimization of the support functions in the extended" ;
    :inSection "lin_basis" ;
    :hasDefault "1.e-3" ;
    :hasRange "from 1e-05 to 10.0" .

:Parameter_lin_basis_idsx a :Parameter ;
    rdfs:label "lin_basis.idsx" ;
    rdfs:comment "Indicates the method with which the support functions are optimized * n=0 => steepest descent * n>0 => DIIS with history length n" ;
    :hasDescription "DIIS history for optimization of the support functions" ;
    :inSection "lin_basis" ;
    :hasDefault "[6, 6]" ;
    :hasRange "from 0 to 20" .

:Parameter_lin_basis_min_gnrm_for_dynamic a :Parameter ;
    rdfs:label "lin_basis.min_gnrm_for_dynamic" ;
    rdfs:comment "The dynamic convergence criterion (specified by gnrm_dyn) is only active if the mean gradient norm of the support functions is below this threshold" ;
    :hasDescription "Minimal gnrm to active the dynamic gnrm criterion" ;
    :inSection "lin_basis" ;
    :hasDefault "1.e-3" ;
    :hasRange "from 1e-07 to 1.0" .

:Parameter_lin_basis_nit a :Parameter ;
    rdfs:label "lin_basis.nit" ;
    rdfs:comment "Maximal number of iterations in the optimization of the support functions. The first number is used for the low accuracy part, the second one for the high accuracy part. If the hybrid mode is used, only the first value is taken into account." ;
    :hasDescription "Maximal number of iterations in the optimization of the" ;
    :inSection "lin_basis" ;
    :hasDefault "[4, 5]" ;
    :hasRange "from 0 to 100" .

:Parameter_lin_basis_nit_ig a :Parameter ;
    rdfs:label "lin_basis.nit_ig" ;
    :hasDescription "maximal number of iterations to optimize the support functions in the extended input" ;
    :inSection "lin_basis" ;
    :hasDefault "50" ;
    :hasRange "from 0 to 100" .

:Parameter_lin_basis_nstep_prec a :Parameter ;
    rdfs:label "lin_basis.nstep_prec" ;
    rdfs:comment "Indicates how many iterations in the preconditioning of the gradient shall be performed" ;
    :hasDescription "Number of iterations in the preconditioner" ;
    :inSection "lin_basis" ;
    :hasDefault "5" ;
    :hasRange "from 1 to 30" .

:Parameter_lin_basis_orthogonalize_ao a :Parameter ;
    rdfs:label "lin_basis.orthogonalize_ao" ;
    :hasDescription "Orthogonalize the atomic orbitals used as input guess" ;
    :inSection "lin_basis" ;
    :hasDefault "Yes" .

:Parameter_lin_basis_orthogonalize_sfs a :Parameter ;
    rdfs:label "lin_basis.orthogonalize_sfs" ;
    :hasDescription "whether or not to explicitly orthogonalize SFs (will be activated by default except" ;
    :inSection "lin_basis" ;
    :hasDefault "Yes" .

:Parameter_lin_basis_reset_DIIS_history a :Parameter ;
    rdfs:label "lin_basis.reset_DIIS_history" ;
    :hasDescription "Reset the DIIS history when starting the loop which optimizes the support functions" ;
    :inSection "lin_basis" ;
    :hasDefault "No" .

:Parameter_lin_basis_params_ao_confinement a :Parameter ;
    rdfs:label "lin_basis_params.ao_confinement" ;
    rdfs:comment "Indicates the prefactor of the confining potential of this atom type which is used to generate the input guess." ;
    :hasDescription "Prefactor for the input guess confining potential" ;
    :inSection "lin_basis_params" ;
    :hasDefault "8.3e-3" ;
    :hasRange "from -1.0 to 10.0" .

:Parameter_lin_basis_params_confinement a :Parameter ;
    rdfs:label "lin_basis_params.confinement" ;
    rdfs:comment "Indicates the prefactor of the confining potential of this atom type. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Prefactor for the confining potential (low/high accuracy)" ;
    :inSection "lin_basis_params" ;
    :hasDefault "[8.3e-3, 0.0]" ;
    :hasRange "from -1.0 to 10.0" .

:Parameter_lin_basis_params_nbasis a :Parameter ;
    rdfs:label "lin_basis_params.nbasis" ;
    rdfs:comment "Indicates the number of support fuctions centered on this atom type. Possible values are: * 1 (s orbital type) * 4 (s,p orbital types) * 9 (s,p,d orbital types) * 16 (s,p,d,f orbital types)" ;
    :hasDescription "Number of support functions per atom" ;
    :inSection "lin_basis_params" ;
    :hasDefault "4" .

:Parameter_lin_basis_params_rloc a :Parameter ;
    rdfs:label "lin_basis_params.rloc" ;
    rdfs:comment "Indicates the cutoff radius for the support functions. The first entry is used for the low accuracy part, the second one for the high accuracy part; the second value must not be smaller than the first one. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Localization radius for the support functions" ;
    :inSection "lin_basis_params" ;
    :hasDefault "[7.0, 7.0]" ;
    :hasRange "from 2.0 to 1000.0" .

:Parameter_lin_basis_params_rloc_kernel a :Parameter ;
    rdfs:label "lin_basis_params.rloc_kernel" ;
    rdfs:comment "Indicates the cutoff radius for the density kernel. Must be at least as large as the support function cutoff plus 8 times the grid spacing; will be adjusted automatically if it is chosen too small." ;
    :hasDescription "Localization radius for the density kernel" ;
    :inSection "lin_basis_params" ;
    :hasDefault "9.0" ;
    :hasRange "from 2.0 to 1000.0" .

:Parameter_lin_basis_params_rloc_kernel_foe a :Parameter ;
    rdfs:label "lin_basis_params.rloc_kernel_foe" ;
    rdfs:comment "Indicates the cutoff radius used for the matrix vector multiplications. Must be at least as large as the kernel cutoff." ;
    :hasDescription "Cutoff radius for the FOE matrix vector multiplications" ;
    :inSection "lin_basis_params" ;
    :hasDefault "14.0" ;
    :hasRange "from 2.0 to 1000" .

:Parameter_lin_general_calc_dipole a :Parameter ;
    rdfs:label "lin_general.calc_dipole" ;
    rdfs:comment "Indicates whether the dipole moment should be calculated after the run or not" ;
    :hasDescription "Calculate dipole" ;
    :inSection "lin_general" ;
    :hasDefault "No" .

:Parameter_lin_general_calc_quadrupole a :Parameter ;
    rdfs:label "lin_general.calc_quadrupole" ;
    rdfs:comment "Indicates whether the quadrupole moment should be calculated after the run or not" ;
    :hasDescription "Calculate quadrupole" ;
    :inSection "lin_general" ;
    :hasDefault "No" .

:Parameter_lin_general_calculate_FOE_eigenvalues a :Parameter ;
    rdfs:label "lin_general.calculate_FOE_eigenvalues" ;
    :hasDescription "First and last eigenvalue to be calculated using the FOE procedure" ;
    :inSection "lin_general" ;
    :hasDefault "[0, -1]" .

:Parameter_lin_general_calculate_onsite_overlap a :Parameter ;
    rdfs:label "lin_general.calculate_onsite_overlap" ;
    :hasDescription "Calculate the onsite overlap matrix (has only an effect if the matrices are all" ;
    :inSection "lin_general" ;
    :hasDefault "No" .

:Parameter_lin_general_cdft_add_w_guess a :Parameter ;
    rdfs:label "lin_general.cdft_add_w_guess" ;
    rdfs:comment "possible value: 1 real number" ;
    :hasDescription "Add cdft_add_w_guess * W to kernel for CDFT initial guess" ;
    :inSection "lin_general" ;
    :hasDefault "0.0" ;
    :hasRange "from -1000.0 to 1000.0" .

:Parameter_lin_general_cdft_conv_crit a :Parameter ;
    rdfs:label "lin_general.cdft_conv_crit" ;
    rdfs:comment "possible value: 1 positive real number" ;
    :hasDescription "CDFT convergence threshold for the constrained charge" ;
    :inSection "lin_general" ;
    :hasDefault "1.e-2" ;
    :hasRange "from 1e-20 to 1000.0" .

:Parameter_lin_general_cdft_lag_mult_init a :Parameter ;
    rdfs:label "lin_general.cdft_lag_mult_init" ;
    rdfs:comment "The sign is no longer set automatically based on the charge to be constrained" ;
    :hasDescription "CDFT initial value for Lagrange multiplier" ;
    :inSection "lin_general" ;
    :hasDefault "0.05d0" ;
    :hasRange "from -100.0 to 100.0" .

:Parameter_lin_general_cdft_nit a :Parameter ;
    rdfs:label "lin_general.cdft_nit" ;
    :hasDescription "Number of iterations for CDFT loop over V_c" ;
    :inSection "lin_general" ;
    :hasDefault "100" ;
    :hasRange "from 1 to 1000" .

:Parameter_lin_general_cdft_orbital a :Parameter ;
    rdfs:label "lin_general.cdft_orbital" ;
    rdfs:comment "Indicates whether the constraint is spatial or orbital based 0 => spatial -1, -2 => HOMO, HOMO-1... 1, 2... => LUMO, LUMO+1..." ;
    :hasDescription "Which orbital to add/remove charge from in CDFT" ;
    :inSection "lin_general" ;
    :hasDefault "[0, 0]" ;
    :hasRange "from -1000 to 1000" .

:Parameter_lin_general_cdft_spin a :Parameter ;
    rdfs:label "lin_general.cdft_spin" ;
    rdfs:comment "Indicates whether each constraint is spin up or down" ;
    :hasDescription "Which orbital to add/remove charge from in CDFT" ;
    :inSection "lin_general" ;
    :hasDefault "[1, 1]" ;
    :hasRange "from 1 to 2" .

:Parameter_lin_general_cdft_type a :Parameter ;
    rdfs:label "lin_general.cdft_type" ;
    rdfs:comment "Indicates whether singlet/triplet, diag/off-diag 1 -> singlet, diag 2 -> triplet, diag 3 -> singlet, off-diag 4 -> triplet, off-diag" ;
    :hasDescription "Which type of excitation to do" ;
    :inSection "lin_general" ;
    :hasDefault "1" ;
    :hasRange "from 1 to 4" .

:Parameter_lin_general_charge_multipoles a :Parameter ;
    rdfs:label "lin_general.charge_multipoles" ;
    rdfs:comment "Calculate the multipole expansion coefficients of the atomic charge which can then be used to establish a QM/MM coupling. Currently only implemented and tested for nspin=1 Possible values are: * 0 => no calculation * 1 => Loewdin approach, however without explicit orthogonalization #* 2 => new approach using simple projector and orthogonalized support functions #* 3 => new approach using full projector and orthogonalized support functions * 11 => Mulliken approach #* 12 => same as 2, but with non-orthogonalized support functions #* 13 => same as 3, but with non-orthogonalized support functions" ;
    :hasDescription "Calculate the atom-centered multipole coefficients; 0 no, 1 old approach Loewdin, 2" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'no calculation'}, {'value': 1, 'label': 'Loewdin approach, however without explicit orthogonalization'}, {'value': 11, 'label': 'Mulliken approach'}" .

:Parameter_lin_general_check_multipoles a :Parameter ;
    rdfs:label "lin_general.check_multipoles" ;
    :hasDescription "Check the multipoles computed by computing the total dipole." ;
    :inSection "lin_general" ;
    :hasDefault "True" .

:Parameter_lin_general_conf_damping a :Parameter ;
    rdfs:label "lin_general.conf_damping" ;
    rdfs:comment "Prescription how the prefactor for the confining potential should be decreased * negative value => automatic adjustment (recommended) * positive value => at each iteration the prefactor is multiplied with the specified value This variable is only relevant for the hybrid mode." ;
    :hasDescription "How the confinement should be decreased, only relevant for hybrid mode; negative ->" ;
    :inSection "lin_general" ;
    :hasDefault "-0.5" ;
    :hasRange "from -1.0 to 1.0" .

:Parameter_lin_general_consider_entropy a :Parameter ;
    rdfs:label "lin_general.consider_entropy" ;
    :hasDescription "Indicate whether the entropy contribution to the total energy shall be considered" ;
    :inSection "lin_general" ;
    :hasDefault "False" .

:Parameter_lin_general_extra_states a :Parameter ;
    rdfs:label "lin_general.extra_states" ;
    :hasDescription "Number of extra states to include in support function and kernel optimization (dmin" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 10000" .

:Parameter_lin_general_frag_neighbour_cutoff a :Parameter ;
    rdfs:label "lin_general.frag_neighbour_cutoff" ;
    rdfs:comment "Distance (in bohr) beyond which neighbouring atoms are not included in frag_env.xyz" ;
    :hasDescription "Number of neighbours to output for each fragment" ;
    :inSection "lin_general" ;
    :hasDefault "12.0d0" ;
    :hasRange "from 0 to 100" .

:Parameter_lin_general_frag_num_neighbours a :Parameter ;
    rdfs:label "lin_general.frag_num_neighbours" ;
    rdfs:comment "Indicates how many neighbouring atoms should be written to frag_env.xyz - only allow for a small number of neighbours" ;
    :hasDescription "Number of neighbours to output for each fragment" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 4" .

:Parameter_lin_general_hybrid a :Parameter ;
    rdfs:label "lin_general.hybrid" ;
    :hasDescription "Activate the hybrid mode; if activated, only the low accuracy values will be relevant" ;
    :inSection "lin_general" ;
    :hasDefault "No" .

:Parameter_lin_general_kernel_restart_mode a :Parameter ;
    rdfs:label "lin_general.kernel_restart_mode" ;
    rdfs:comment "Indicates how the kernel should be generated for a restart calculation: * 0 => Density kernel * 1 => Coefficients * 2 => Random * 3 => Diagonal kernel, i.e. support functions scaled by number of electrons (per fragment) * 4 => Support functions weights * 5 => Atomic orbitals, i.e. first perform diagonalization and retain coefficients/kernel * 6 => Density kernel of full system (for the case where both fragment and full kernel is available) * 7 => Coefficients of full system (for the case where both fragment and full kernel is available)" ;
    :hasDescription "Method for restarting kernel; 0 kernel, 1 coefficients, 2 random, 3 diagonal, 4" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'Density kernel'}, {'value': 1, 'label': 'Coefficients'}, {'value': 2, 'label': 'Random'}, {'value': 3, 'label': 'Diagonal kernel'}, {'value': 4, 'label': 'Support function weights'}, {'value': 5, 'label': 'Atomic orbitals'}, {'value': 6, 'label': 'Full kernel'}, {'value': 7, 'label': 'FUll coefficients'}" .

:Parameter_lin_general_kernel_restart_noise a :Parameter ;
    rdfs:label "lin_general.kernel_restart_noise" ;
    rdfs:comment "Indicates how much noise should be added to kernel or coefficients for a restart calculation" ;
    :hasDescription "Add random noise to kernel or coefficients when restarting" ;
    :inSection "lin_general" ;
    :hasDefault "0.0d0" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_lin_general_max_inversion_error a :Parameter ;
    rdfs:label "lin_general.max_inversion_error" ;
    rdfs:comment "Maximal error of the Taylor approximations which are used to calculate the inverse of the overlap matrix. If this error is larger than the specified value, the order of the Taylor approximation is increased. The default value is set very large, such such in this case no automatic adjustment is performed." ;
    :hasDescription "Linear scaling maximal error of the Taylor approximations to calculate the inverse of" ;
    :inSection "lin_general" ;
    :hasDefault "1.d0" ;
    :hasRange "from 1e-20 to 1.0" .

:Parameter_lin_general_multipole_centers a :Parameter ;
    rdfs:label "lin_general.multipole_centers" ;
    :hasDescription "Determines whether the multipole centers shall be determined automatically (i.e." ;
    :inSection "lin_general" ;
    :hasDefault "0.0" .

:Parameter_lin_general_nit a :Parameter ;
    rdfs:label "lin_general.nit" ;
    rdfs:comment "Maximal number of outer loop iterations (high / low accuracy). In each iteration both the support function and the kernel are optimized. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Number of iteration with low/high accuracy" ;
    :inSection "lin_general" ;
    :hasDefault "[100, 100]" ;
    :hasRange "from 0 to 1000" .

:Parameter_lin_general_output_coeff a :Parameter ;
    rdfs:label "lin_general.output_coeff" ;
    rdfs:comment "Indicates how the support function coefficients should be written to disk at the end of the run: * 0 => None * 1 => Plain text" ;
    :hasDescription "Output KS coefficients; 0 no output, 1 formatted output" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'None'}, {'value': 1, 'label': 'Plain text'}" .

:Parameter_lin_general_output_fragments a :Parameter ;
    rdfs:label "lin_general.output_fragments" ;
    rdfs:comment "Indicates how the support functions should be written to disk at the end of the run: * 0 => Fragments and full system * 1 => Fragments only * 2 => Full system only" ;
    :hasDescription "Output support functions, kernel and coeffs; 0 fragments and full system, 1" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'Fragments and full system'}, {'value': 1, 'label': 'Fragments only'}, {'value': 2, 'label': 'Full system only'}" .

:Parameter_lin_general_output_mat a :Parameter ;
    rdfs:label "lin_general.output_mat" ;
    rdfs:comment "Indicates how the support function matrices should be written to disk at the end of the run: * 0 => None * 1 => Plain text in sparse format * 11 => Plain text in dense format * 21 => Plain text in both formats * 2 => Fortran binary in sparse format * 12 => Fortran binary in dense format * 22 => Fortran binary in both formats * 4 => MPI native binary in sparse format" ;
    :hasDescription "Output sparse matrices; 0 no output, 1 formatted sparse, 11 formatted dense, 21 formatted both." ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'None'}, {'value': 1, 'label': 'Plain text sparse'}, {'value': 11, 'label': 'Plain text dense'}, {'value': 21, 'label': 'Plain text sparse and dense'}, {'value': 2, 'label': 'Fortran binary sparse'}, {'value': 12, 'label': 'Fortran binary dense'}, {'value': 22, 'label': 'Fortran binary sparse and dense'}, {'value': 31, 'label': 'Matrix market format text.'}, {'value': 4, 'label': 'MPI native binary sparse'}" .

:Parameter_lin_general_output_matmul a :Parameter ;
    rdfs:label "lin_general.output_matmul" ;
    :hasDescription "If outputting support function matrices, also include the matmul file" ;
    :inSection "lin_general" ;
    :hasDefault "False" .

:Parameter_lin_general_output_multipole_matrices a :Parameter ;
    rdfs:label "lin_general.output_multipole_matrices" ;
    :hasDescription "If outputting support function matrices, also output the multipole matrices in the" ;
    :inSection "lin_general" ;
    :hasDefault "True" .

:Parameter_lin_general_output_wf a :Parameter ;
    rdfs:label "lin_general.output_wf" ;
    rdfs:comment "Indicates how the support functions should be written to disk at the end of the run: * 0 => None * 1 => Wavelet, Plain text * 2 => Wavelet, Fortran binary * 3 => Wavelet, ETSF file format * 10 => None * 11 => Wavelet and Interpolating Scaling Function (density), Plain text * 12 => Wavelet and Interpolating Scaling Function (density), Fortran binary * 13 => Wavelet and Interpolating Scaling Function (density), ETSF file format * 20 => None * 21 => Wavelet and Interpolating Scaling Function (wavefunction), Plain text * 22 => Wavelet and Interpolating Scaling Function (wavefunction), Fortran binary * 23 => Wavelet and Interpolating Scaling Function (wavefunction), ETSF file format" ;
    :hasDescription "Output basis functions; 0 no output, 1 formatted output, 2 Fortran bin, 3 ETSF" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'None'}, {'value': 1, 'label': 'Wavelet, Plain text'}, {'value': 2, 'label': 'Wavelet, Fortran binary'}, {'value': 3, 'label': 'Wavelet, ETSF file format'}, {'value': 10, 'label': 'None'}, {'value': 11, 'label': 'Wavelet and Interpolating Scaling Function (density), Plain text'}, {'value': 12, 'label': 'Wavelet and Interpolating Scaling Function (density), Fortran binary'}, {'value': 13, 'label': 'Wavelet and Interpolating Scaling Function (density), ETSF file format'}, {'value': 20, 'label': 'None'}, {'value': 21, 'label': 'Wavelet and Interpolating Scaling Function (wavefunction), Plain text'}, {'value': 22, 'label': 'Wavelet and Interpolating Scaling Function (wavefunction), Fortran binary'}, {'value': 23, 'label': 'Wavelet and Interpolating Scaling Function (wavefunction), ETSF file format'}" .

:Parameter_lin_general_plot_locreg_grids a :Parameter ;
    rdfs:label "lin_general.plot_locreg_grids" ;
    :hasDescription "Plot the scaling function and wavelets grid of each localization region" ;
    :inSection "lin_general" ;
    :hasDefault "False" .

:Parameter_lin_general_precision_FOE_eigenvalues a :Parameter ;
    rdfs:label "lin_general.precision_FOE_eigenvalues" ;
    :hasDescription "Decay length of the error function used to extract the eigenvalues (i.e. something like" ;
    :inSection "lin_general" ;
    :hasDefault "5.e-3" ;
    :hasRange "from 0.0 to 0.1" .

:Parameter_lin_general_rpnrm_cv a :Parameter ;
    rdfs:label "lin_general.rpnrm_cv" ;
    rdfs:comment "Convergence criterion for the outer loop iterations (high / low accuracy). The optimization stops if the mean change of the charge density / potential falls below this threshold. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Convergence criterion for low/high accuracy" ;
    :inSection "lin_general" ;
    :hasDefault "[1.e-12, 1.e-12]" ;
    :hasRange "from 1e-15 to 1e-05" .

:Parameter_lin_general_subspace_diag a :Parameter ;
    rdfs:label "lin_general.subspace_diag" ;
    rdfs:comment "Indicates whether a diagonalization shall be performed at the end of the run" ;
    :hasDescription "Diagonalization at the end" ;
    :inSection "lin_general" ;
    :hasDefault "No" .

:Parameter_lin_general_support_function_multipoles a :Parameter ;
    rdfs:label "lin_general.support_function_multipoles" ;
    :hasDescription "Calculate the multipole moments of the support functions" ;
    :inSection "lin_general" ;
    :hasDefault "False" .

:Parameter_lin_general_taylor_order a :Parameter ;
    rdfs:label "lin_general.taylor_order" ;
    rdfs:comment "Indicates how the matrix powers are calculated: * n<0 => Laura's method of order n * n=0 => exact calculation * n>0 => Taylor series of order n" ;
    :hasDescription "Order of the Taylor approximation; 0 -> exact" ;
    :inSection "lin_general" ;
    :hasDefault "0" ;
    :hasRange "from -100 to 10000" .

:Parameter_lin_kernel_alpha_fit_coeff a :Parameter ;
    rdfs:label "lin_kernel.alpha_fit_coeff" ;
    rdfs:comment "Update the SD step size by fitting a quadratic polynomial to the energy along the direction of the gradient during direct mininimization." ;
    :hasDescription "Update the SD step size by fitting a quadratic polynomial" ;
    :inSection "lin_kernel" ;
    :hasDefault "No" .

:Parameter_lin_kernel_alpha_sd_coeff a :Parameter ;
    rdfs:label "lin_kernel.alpha_sd_coeff" ;
    :hasDescription "Initial step size for SD for direct minimization" ;
    :inSection "lin_kernel" ;
    :hasDefault "0.2" .

:Parameter_lin_kernel_alphamix a :Parameter ;
    rdfs:label "lin_kernel.alphamix" ;
    rdfs:comment "Indicates the mixing parameter used for the mixing of the charge density / potential. The larger the value, the more of the previous value will be kept. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Mixing parameter (low/high accuracy)" ;
    :inSection "lin_kernel" ;
    :hasDefault "[0.5, 0.5]" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_lin_kernel_coeff_scaling_factor a :Parameter ;
    rdfs:label "lin_kernel.coeff_scaling_factor" ;
    rdfs:comment "Specifies a scaling factor for the coefficient gradient, recommended to be around 0.1 - 0.5 for CDFT, fragment calculations or systems where convergence is unstable." ;
    :hasDescription "Factor to scale the gradient in direct minimization" ;
    :inSection "lin_kernel" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_lin_kernel_delta_pnrm a :Parameter ;
    rdfs:label "lin_kernel.delta_pnrm" ;
    rdfs:comment "stop the kernel optimization if the density/potential difference has decreased by this factor compared to the first iteration. The feature is deactivated for a value of -1.0" ;
    :hasDescription "Stop the kernel optimization if the density/potential difference has decreased by this" ;
    :inSection "lin_kernel" ;
    :hasDefault "-1.0" ;
    :hasRange "from -1.0 to 1.0" .

:Parameter_lin_kernel_diag_start a :Parameter ;
    rdfs:label "lin_kernel.diag_start" ;
    :hasDescription "whether or not to diagonalize the SF Hamiltonian at the beginning of a restart" ;
    :inSection "lin_kernel" ;
    :hasDefault "No" .

:Parameter_lin_kernel_gnrm_cv_coeff a :Parameter ;
    rdfs:label "lin_kernel.gnrm_cv_coeff" ;
    rdfs:comment "Convergence criterion on the gradient for direct minimization. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Convergence criterion on the gradient for direct minimization" ;
    :inSection "lin_kernel" ;
    :hasDefault "[1.e-5, 1.e-5]" .

:Parameter_lin_kernel_idsx a :Parameter ;
    rdfs:label "lin_kernel.idsx" ;
    rdfs:comment "Indicates how the density / potential mixing shall be performed: n=0 => linear mixing n=1 => Pulay mixing with history length n The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Mixing method; 0 -> linear mixing, >=1 -> Pulay mixing" ;
    :inSection "lin_kernel" ;
    :hasDefault "[0, 0]" ;
    :hasRange "from 0 to 20" .

:Parameter_lin_kernel_idsx_coeff a :Parameter ;
    rdfs:label "lin_kernel.idsx_coeff" ;
    :hasDescription "DIIS history for direct mininimization - warning, there is" ;
    :inSection "lin_kernel" ;
    :hasDefault "[0, 0]" .

:Parameter_lin_kernel_linear_method a :Parameter ;
    rdfs:label "lin_kernel.linear_method" ;
    rdfs:comment "Indicates the method with which the density kernel is optimized: * DIRMIN => direct minimization * DIAG => diagonalization with density mixing * NTPOLY => diagonalization using NTPoly. * FOE => Fermi Operator Expansion" ;
    :hasDescription "Method to optimize the density kernel" ;
    :inSection "lin_kernel" ;
    :hasDefault "DIAG" ;
    :hasAllowedValues "{'value': 'DIRMIN', 'label': 'direct minimization'}, {'value': 'DIAG', 'label': 'diagonalization'}, {'value': 'NTPOLY', 'label': 'ntpoly library'}, {'value': 'FOE', 'label': 'Fermi Operator Expansion'}" .

:Parameter_lin_kernel_mixing_method a :Parameter ;
    rdfs:label "lin_kernel.mixing_method" ;
    rdfs:comment "Indicates which quantity should be used for the mixing procedure: DEN => density mixing POT => potential mixing" ;
    :hasDescription "Quantity to be mixed" ;
    :inSection "lin_kernel" ;
    :hasDefault "DEN" ;
    :hasAllowedValues "{'value': 'DEN', 'label': 'density mixing'}, {'value': 'POT', 'label': 'potential mixing'}" .

:Parameter_lin_kernel_nit a :Parameter ;
    rdfs:label "lin_kernel.nit" ;
    rdfs:comment "Indicates the number of iterations in the (self-consistent) optimization of the density kernel. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Number of iterations in the (self-consistent)" ;
    :inSection "lin_kernel" ;
    :hasDefault "[5, 5]" ;
    :hasRange "from 0 to 1000" .

:Parameter_lin_kernel_nstep a :Parameter ;
    rdfs:label "lin_kernel.nstep" ;
    rdfs:comment "Indicates the number of steps taken when updating the coefficients via direct minimization for each iteration of the density kernel loop. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Number of steps taken when updating the coefficients via" ;
    :inSection "lin_kernel" ;
    :hasDefault "[1, 1]" ;
    :hasRange "from 0 to 100" .

:Parameter_lin_kernel_rpnrm_cv a :Parameter ;
    rdfs:label "lin_kernel.rpnrm_cv" ;
    rdfs:comment "The optimization of the density kernel is stopped as soon as the mean change of the charge density / potential between two iterations falls below this threshold. The first entry is used for the low accuracy part, the second one for the high accuracy part. When the hybrid mode is used, only the first entry is taken into account." ;
    :hasDescription "Convergence criterion (change in density/potential) for the kernel" ;
    :inSection "lin_kernel" ;
    :hasDefault "[1.e-10, 1.e-10]" ;
    :hasRange "from 1e-14 to 1e-05" .

:Parameter_logfile a :Parameter ;
    rdfs:label "logfile" ;
    :hasDescription "Input variable logfile of BigDFT." ;
    :inSection "logfile" ;
    :hasDefault "Yes" .

:Parameter_md_always_from_scratch a :Parameter ;
    rdfs:label "md.always_from_scratch" ;
    :hasDescription "When true, always restart wavefunctions from scratch to eliminate dissipation effects" ;
    :inSection "md" ;
    :hasDefault "No" .

:Parameter_md_mdsteps a :Parameter ;
    rdfs:label "md.mdsteps" ;
    rdfs:comment "A value greater than 0 will activate molecular dynamics" ;
    :hasDescription "Number of MD steps" ;
    :inSection "md" ;
    :hasDefault "0" ;
    :hasRange "from 0 to inf" .

:Parameter_md_no_translation a :Parameter ;
    rdfs:label "md.no_translation" ;
    :hasDescription "Logical input to set translational correction" ;
    :inSection "md" ;
    :hasDefault "No" .

:Parameter_md_nose_chain_length a :Parameter ;
    rdfs:label "md.nose_chain_length" ;
    :hasDescription "Length of the Nose-Hoover Chains (integer input)" ;
    :inSection "md" ;
    :hasDefault "3" ;
    :hasRange "from 2 to 10" .

:Parameter_md_nose_frequency a :Parameter ;
    rdfs:label "md.nose_frequency" ;
    :hasDescription "Frequency in (cm^-1) corresponding to the inertia of the thermostat degrees of freedom" ;
    :inSection "md" ;
    :hasDefault "3000.0" ;
    :hasRange "from 1.0 to inf" .

:Parameter_md_nose_mts_size a :Parameter ;
    rdfs:label "md.nose_mts_size" ;
    :hasDescription "Multiple time steps used to integrate Nose-Hoover Chains equations of motion (integer input)" ;
    :inSection "md" ;
    :hasDefault "1" ;
    :hasRange "from 1 to 10" .

:Parameter_md_nose_yoshida_factor a :Parameter ;
    rdfs:label "md.nose_yoshida_factor" ;
    :hasDescription "Yoshida-Suzuki order to integrate the Nose-Hoover Chains equations of motion (integer input)" ;
    :inSection "md" ;
    :hasDefault "7" ;
    :hasAllowedValues "{'value': 3, 'label': ''}, {'value': 5, 'label': ''}, {'value': 7, 'label': ''}" .

:Parameter_md_print_frequency a :Parameter ;
    rdfs:label "md.print_frequency" ;
    :hasDescription "Printing frequency for energy.dat and Trajectory.xyz files" ;
    :inSection "md" ;
    :hasDefault "1" ;
    :hasRange "from 1 to 999999" .

:Parameter_md_restart_nose a :Parameter ;
    rdfs:label "md.restart_nose" ;
    :hasDescription "Restart Nose Hoover Chain information from md.restart" ;
    :inSection "md" ;
    :hasDefault "No" .

:Parameter_md_restart_pos a :Parameter ;
    rdfs:label "md.restart_pos" ;
    :hasDescription "Restart nuclear position information from md.restart" ;
    :inSection "md" ;
    :hasDefault "No" .

:Parameter_md_restart_vel a :Parameter ;
    rdfs:label "md.restart_vel" ;
    :hasDescription "Restart nuclear velocities information from md.restart" ;
    :inSection "md" ;
    :hasDefault "No" .

:Parameter_md_temperature a :Parameter ;
    rdfs:label "md.temperature" ;
    :hasDescription "Initial temperature in Kelvin" ;
    :inSection "md" ;
    :hasDefault "300.d0" ;
    :hasRange "from 0 to 9999999.0" .

:Parameter_md_thermostat a :Parameter ;
    rdfs:label "md.thermostat" ;
    :hasDescription "Activates a thermostat for MD" ;
    :inSection "md" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'no thermostat'}, {'value': 'nose_hoover_chain', 'label': 'Nose-Hoover Chain thermostat'}" .

:Parameter_md_timestep a :Parameter ;
    rdfs:label "md.timestep" ;
    :hasDescription "Time step for integration (in a.u.)" ;
    :inSection "md" ;
    :hasDefault "20.d0" ;
    :hasRange "from 0 to 99999.0" .

:Parameter_md_wavefunction_extrapolation a :Parameter ;
    rdfs:label "md.wavefunction_extrapolation" ;
    rdfs:comment "A value greater than 0 activates wfn extrapolation" ;
    :hasDescription "Activates the wavefunction extrapolation for MD" ;
    :inSection "md" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': ''}, {'value': 1, 'label': ''}, {'value': 2, 'label': ''}, {'value': 4, 'label': ''}" .

:Parameter_mix_alphadiis a :Parameter ;
    rdfs:label "mix.alphadiis" ;
    rdfs:comment "The DIIS multiplier used for preconditioning the wavefunctions at constant potential." ;
    :hasDescription "Multiplying factors for the electronic DIIS" ;
    :inSection "mix" ;
    :hasDefault "2." ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_mix_alphamix a :Parameter ;
    rdfs:label "mix.alphamix" ;
    rdfs:comment "The closer this value gets to one, the more cautious will be the mixing of the charge or potential. In the case of straight mixing, it corresponds to alpha according to rho_{new} <-- alpha rho_{old} + (1-alpha) - rho_{new} alphamix must be larger than one half. A typical choice for metals is 0.95." ;
    :hasDescription "Multiplying factors for the mixing" ;
    :inSection "mix" ;
    :hasDefault "0." ;
    :hasRange "from 0 to 1.0" .

:Parameter_mix_diis_sd_switch_tolerance a :Parameter ;
    rdfs:label "mix.diis_sd_switch_tolerance" ;
    :hasDescription "Tolerance to switch between the Steppest Descent and the DIIS" ;
    :inSection "mix" ;
    :hasDefault "0" .

:Parameter_mix_iscf a :Parameter ;
    rdfs:label "mix.iscf" ;
    rdfs:comment "An integer giving the mixing scheme and the mixing target. It follows the ABINIT convention. For values lower than 10, the potential is mixed, while for values greater than 10, the density is mixed. A recommended option is Pulay mixing (7 or 17 for potential or charge mixing, respectively)" ;
    :hasDescription "Mixing scheme (default=0 i.e. direct minimization)" ;
    :inSection "mix" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': -2, 'label': 'Non self-consistent direct minization'}, {'value': -1, 'label': 'Reserved, do not use it.'}, {'value': 0, 'label': 'Direct minimization'}, {'value': 1, 'label': 'Get the largest eigenvalue of the SCF cycle'}, {'value': 2, 'label': 'Simple mixing of the potential'}, {'value': 3, 'label': 'Anderson mixing of the potential'}, {'value': 4, 'label': 'Anderson mixing of the potential based on the two previous iterations'}, {'value': 5, 'label': 'CG based on the minim. of the energy with respect to the potential'}, {'value': 7, 'label': 'Pulay mixing of the potential based on npulayit previous iterations'}, {'value': 12, 'label': 'Simple mixing of the density'}, {'value': 13, 'label': 'Anderson mixing of the density'}, {'value': 14, 'label': 'Anderson mixing of the density based on the two previous iterations'}, {'value': 15, 'label': 'CG based on the minim. of the energy with respect to the density'}, {'value': 17, 'label': 'Pulay mixing of the density'}" .

:Parameter_mix_itrpmax a :Parameter ;
    rdfs:label "mix.itrpmax" ;
    rdfs:comment "Maximum number of repeats for the mixing scheme. Each iteration implies an optimization of the wavefunctions at constant potential according to the settings in input.dft." ;
    :hasDescription "Maximum number of diagonalisation iterations" ;
    :inSection "mix" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 10000" .

:Parameter_mix_norbsempty a :Parameter ;
    rdfs:label "mix.norbsempty" ;
    rdfs:comment "The maximum number of additional (initially unoccupied) bands considered. If a larger value is given, The maximum of orbitals available via the input guess procedure will be used automatically" ;
    :hasDescription "No. of additional bands" ;
    :inSection "mix" ;
    :hasDefault "0" ;
    :hasRange "from 0 to 10000" .

:Parameter_mix_occopt a :Parameter ;
    rdfs:label "mix.occopt" ;
    rdfs:comment "The smearing function to determine the occupation. The conventions differ from those used by ABINIT. 1 = Gaussian, 2 = Fermi, 3 = Marzari (bumb minimization), 4 = Marzari (monotonic tail), 5 = Methfessel and Paxton." ;
    :hasDescription "Smearing method" ;
    :inSection "mix" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 1, 'label': 'Error function smearing'}, {'value': 2, 'label': 'Normal Fermi distribution'}, {'value': 3, 'label': 'Marzari cold smearing a=-.5634 (bumb minimization)'}, {'value': 4, 'label': 'Marzari cold smearing with a=-.8165 (monotonic tail)'}, {'value': 5, 'label': 'Methfessel and Paxton (same as cold with a=0)'}" .

:Parameter_mix_rpnrm_cv a :Parameter ;
    rdfs:label "mix.rpnrm_cv" ;
    rdfs:comment "The stop criterion on the residue of the potential or the density. Typical values are in the order of 1e-10 to 1e-12." ;
    :hasDescription "Stop criterion on the residue of potential or density" ;
    :inSection "mix" ;
    :hasDefault "1.e-4" ;
    :hasRange "from 0.0 to 10.0" .

:Parameter_mix_tel a :Parameter ;
    rdfs:label "mix.tel" ;
    rdfs:comment "The electronic temperature in energy units (Ha)." ;
    :hasDescription "Electronic temperature" ;
    :inSection "mix" ;
    :hasDefault "0." ;
    :hasRange "from 0.0 to 1000000.0" .

:Parameter_mode_add_coulomb_force a :Parameter ;
    rdfs:label "mode.add_coulomb_force" ;
    :hasDescription "Boolean to add coulomb force on top of any of above selected force" ;
    :inSection "mode" ;
    :hasDefault "No" .

:Parameter_mode_method a :Parameter ;
    rdfs:label "mode.method" ;
    :hasDescription "Run method of BigDFT call" ;
    :inSection "mode" ;
    :hasDefault "dft" ;
    :hasAllowedValues "{'value': 'dft', 'label': 'Density Functional Theory (BigDFT)'}, {'value': 'lj', 'label': 'Lennard-Jones force field'}, {'value': 'tdpot', 'label': 'two-dimension test potential'}, {'value': 'lensic', 'label': 'Lenosky Force Field for Si clusters'}, {'value': 'lensib', 'label': 'Lenosky Force Field for Si bulk'}, {'value': 'amber', 'label': 'AMBER Force Fields Package (requires AMBERtools)'}, {'value': 'morse_bulk', 'label': 'Morse bulk'}, {'value': 'morse_slab', 'label': 'Morse slab'}, {'value': 'tersoff', 'label': 'Tersoff potential for C and Si'}, {'value': 'alborz', 'label': 'Alireza Ghasemis ALBORZ package'}, {'value': 'bmhtf', 'label': 'Born Mayer Huggins Tosi Fumi Potential'}, {'value': 'cp2k', 'label': 'CP2K'}, {'value': 'dftbp', 'label': 'DFTP+'}, {'value': 'sw', 'label': 'Stillinger-Weber for Si'}, {'value': 'bazant', 'label': 'Bazant force for Si'}, {'value': 'multi', 'label': 'Mixed approach where parts of the system are treated with different methods'}, {'value': 'plugin', 'label': 'Use the signaling procedure profided by FUTILE'}" .

:Parameter_mode_mm_paramfile a :Parameter ;
    rdfs:label "mode.mm_paramfile" ;
    :hasDescription "Name of parameter or input file for the selected method or code" ;
    :inSection "mode" ;
    :hasDefault "\"none\"" .

:Parameter_mode_mm_paramset a :Parameter ;
    rdfs:label "mode.mm_paramset" ;
    :hasDescription "Name of the hard-coded parameter set. Must be compatible to the chosen force field." ;
    :inSection "mode" ;
    :hasDefault "\"default\"" .

:Parameter_mode_nab_options a :Parameter ;
    rdfs:label "mode.nab_options" ;
    :hasDescription "String to be passed to nab_init compiler in the case of ambertools compilation" ;
    :inSection "mode" ;
    :hasDefault "\"ntpr=1\"" .

:Parameter_mode_plugin_id a :Parameter ;
    rdfs:label "mode.plugin_id" ;
    :hasDescription "Integer handle identifying the calculator associated to the mode plugin" ;
    :inSection "mode" ;
    :hasDefault "1" .

:Parameter_mode_section_buffer a :Parameter ;
    rdfs:label "mode.section_buffer" ;
    :hasDescription "Level of neighbours added to posinp sections" ;
    :inSection "mode" ;
    :hasDefault "1" ;
    :hasRange "from 0 to 10" .

:Parameter_mode_section_passivation a :Parameter ;
    rdfs:label "mode.section_passivation" ;
    :hasDescription "Level of neighbours added to posinp sections" ;
    :inSection "mode" ;
    :hasDefault "true" .

:Parameter_mode_sections a :Parameter ;
    rdfs:label "mode.sections" ;
    :hasDescription "List of labelling subparts to divide the system into" ;
    :inSection "mode" ;
    :hasDefault "[]" .

:Parameter_mode_sw_eqfactor a :Parameter ;
    rdfs:label "mode.sw_eqfactor" ;
    :hasDescription "Factor on sigma value, rule the equilibrium bond length for the Stillinger-Weber potential" ;
    :inSection "mode" ;
    :hasDefault "1.0" .

:Parameter_outdir a :Parameter ;
    rdfs:label "outdir" ;
    :hasDescription "Input variable outdir of BigDFT." ;
    :inSection "outdir" ;
    :hasDefault "./" .

:Parameter_output_atomic_density_matrix a :Parameter ;
    rdfs:label "output.atomic_density_matrix" ;
    rdfs:comment "The atomic species or the atoms written as Atom No are specified, followed by a list of the shells for which the density matrix can be plotted" ;
    :hasDescription "Dictionary of the atoms for which the atomic density matrix has to be plotted" ;
    :inSection "output" ;
    :hasDefault "None" .

:Parameter_output_coupling_matrix a :Parameter ;
    rdfs:label "output.coupling_matrix" ;
    rdfs:comment "Useful to separate the various contributions of the couling matrix. May be plotted exclusively, separately or in complete form." ;
    :hasDescription "kind of the coupling matrix which have to be plotted" ;
    :inSection "output" ;
    :hasDefault "complete" ;
    :hasAllowedValues "{'value': 'complete', 'label': 'dump the total coupling matrix'}, {'value': 'rpa', 'label': 'only dump the RPA term'}, {'value': 'fxc', 'label': 'only dump the fxc term'}" .

:Parameter_output_orbitals a :Parameter ;
    rdfs:label "output.orbitals" ;
    :hasDescription "Write KS orbitals in the full simulation domain (might take lot of disk space!)" ;
    :inSection "output" ;
    :hasDefault "binary" ;
    :hasAllowedValues "{'value': 'None', 'label': 'No output'}, {'value': 'text', 'label': 'Output in wavelet basis'}, {'value': 'binary', 'label': 'Binary file output'}, {'value': 'text_with_densities', 'label': 'In addition output wavefunction densities in interpolating scaling functions (cube file)'}, {'value': 'text_with_cube', 'label': 'In addition output wavefunctions in interpolating scaling functions (cube file)'}, {'value': 'etsf', 'label': 'ETSF file format'}" .

:Parameter_output_outputpsiid a :Parameter ;
    rdfs:label "output.outputpsiid" ;
    rdfs:comment "Define the basename of all the files associated to the output of the wavefunctions. Can be reused in the inputpsiid input parameter." ;
    :hasDescription "basename of the output wavefunctions files written in the data directory" ;
    :inSection "output" ;
    :hasDefault "wavefunction" .

:Parameter_output_sdos a :Parameter ;
    rdfs:label "output.sdos" ;
    rdfs:comment "Plots the density of states by calculating the value of psi*Hpsi per each KS orbital, resolved among x,y or z." ;
    :hasDescription "Spatially-resolved density of states" ;
    :inSection "output" ;
    :hasDefault "No" .

:Parameter_output_verbosity a :Parameter ;
    rdfs:label "output.verbosity" ;
    :hasDescription "Verbosity of the output" ;
    :inSection "output" ;
    :hasDefault "2" ;
    :hasAllowedValues "{'value': 0, 'label': 'Very low'}, {'value': 1, 'label': 'Low'}, {'value': 2, 'label': 'Medium'}, {'value': 3, 'label': 'High'}" .

:Parameter_perf_FOE_restart a :Parameter ;
    rdfs:label "perf.FOE_restart" ;
    :hasDescription "Restart method to be used for the FOE method" ;
    :inSection "perf" ;
    :hasDefault "0" .

:Parameter_perf_accel a :Parameter ;
    rdfs:label "perf.accel" ;
    rdfs:comment "Specify the use of CUDA (resp. OCL) versions of various subroutines. For CUDA, a GPU.config file is needed." ;
    :hasDescription "Acceleration (hardware)" ;
    :inSection "perf" ;
    :hasDefault "NO" ;
    :hasAllowedValues "{'value': False, 'label': 'No material acceleration'}, {'value': 'CUDAGPU', 'label': 'CUDA'}, {'value': 'OCLGPU', 'label': 'OpenCL on GPU'}, {'value': 'OCLCPU', 'label': 'OpenCL on CPU'}, {'value': 'OCLACC', 'label': '???'}" .

:Parameter_perf_adjust_kernel_iterations a :Parameter ;
    rdfs:label "perf.adjust_kernel_iterations" ;
    :hasDescription "Enable the adaptive ajustment of the number of kernel iterations" ;
    :inSection "perf" ;
    :hasDefault "True" .

:Parameter_perf_adjust_kernel_threshold a :Parameter ;
    rdfs:label "perf.adjust_kernel_threshold" ;
    :hasDescription "Enable the adaptive ajustment of the kernel convergence threshold according to the" ;
    :inSection "perf" ;
    :hasDefault "True" .

:Parameter_perf_blas a :Parameter ;
    rdfs:label "perf.blas" ;
    rdfs:comment "Use or not the CUBlas acceleration." ;
    :hasDescription "CUBLAS acceleration" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_calculate_KS_residue a :Parameter ;
    rdfs:label "perf.calculate_KS_residue" ;
    :hasDescription "Linear scaling calculate Kohn-Sham residue" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_calculate_forces a :Parameter ;
    rdfs:label "perf.calculate_forces" ;
    :hasDescription "Whether or not to calculate the forces at the end of a run (cubic and linear)" ;
    :inSection "perf" ;
    :hasDefault "True" .

:Parameter_perf_calculate_gap a :Parameter ;
    rdfs:label "perf.calculate_gap" ;
    :hasDescription "Linear scaling calculate the HOMO LUMO gap" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_check_matrix_compression a :Parameter ;
    rdfs:label "perf.check_matrix_compression" ;
    :hasDescription "Linear scaling perform a check of the matrix compression routines" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_check_overlap a :Parameter ;
    rdfs:label "perf.check_overlap" ;
    :hasDescription "Enables linear overlap check" ;
    :inSection "perf" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 0, 'label': 'No check'}, {'value': 1, 'label': 'Light check'}, {'value': 2, 'label': 'Full check'}" .

:Parameter_perf_check_sumrho a :Parameter ;
    rdfs:label "perf.check_sumrho" ;
    :hasDescription "Enables linear sumrho check" ;
    :inSection "perf" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 0, 'label': 'No check'}, {'value': 1, 'label': 'Light check'}, {'value': 2, 'label': 'Full check'}" .

:Parameter_perf_coeff_weight_analysis a :Parameter ;
    rdfs:label "perf.coeff_weight_analysis" ;
    :hasDescription "Linear scaling perform a Loewdin charge analysis of the coefficients for fragment" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_correction_co_contra a :Parameter ;
    rdfs:label "perf.correction_co_contra" ;
    :hasDescription "Linear scaling correction covariant / contravariant gradient" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_debug a :Parameter ;
    rdfs:label "perf.debug" ;
    rdfs:comment "The debug mode is enable mainly for memory profiling." ;
    :hasDescription "Debug option" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_domain a :Parameter ;
    rdfs:label "perf.domain" ;
    :hasDescription "Domain to add to the hostname to find the IP" ;
    :inSection "perf" ;
    :hasDefault "~" .

:Parameter_perf_enable_matrix_taskgroups a :Parameter ;
    rdfs:label "perf.enable_matrix_taskgroups" ;
    :hasDescription "Enable the matrix taskgroups" ;
    :inSection "perf" ;
    :hasDefault "True" .

:Parameter_perf_exctxpar a :Parameter ;
    rdfs:label "perf.exctxpar" ;
    :hasDescription "Exact exchange parallelisation scheme" ;
    :inSection "perf" ;
    :hasDefault "OP2P" ;
    :hasAllowedValues "{'value': 'BC', 'label': 'Blocking Collective'}, {'value': 'OP2P', 'label': 'Overlap Point-to-Point'}" .

:Parameter_perf_experimental_mode a :Parameter ;
    rdfs:label "perf.experimental_mode" ;
    :hasDescription "Activate the experimental mode in linear scaling" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_explicit_locregcenters a :Parameter ;
    rdfs:label "perf.explicit_locregcenters" ;
    :hasDescription "Linear scaling explicitly specify localization centers" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_fftcache a :Parameter ;
    rdfs:label "perf.fftcache" ;
    rdfs:comment "Specify the cache size for FFT in kBytes." ;
    :hasDescription "Cache size for the FFT" ;
    :inSection "perf" ;
    :hasDefault "8192" .

:Parameter_perf_foe_gap a :Parameter ;
    rdfs:label "perf.foe_gap" ;
    :hasDescription "Use the FOE method to calculate the HOMO-LUMO gap at the end of a calculation" ;
    :inSection "perf" ;
    :hasDefault "False" .

:Parameter_perf_hamapp_radius_incr a :Parameter ;
    rdfs:label "perf.hamapp_radius_incr" ;
    :hasDescription "Radius enlargement for the Hamiltonian application (in grid points)" ;
    :inSection "perf" ;
    :hasDefault "8" ;
    :hasRange "from 0 to 8" .

:Parameter_perf_ig_blocks a :Parameter ;
    rdfs:label "perf.ig_blocks" ;
    :hasDescription "Input guess Block sizes for orthonormalisation" ;
    :inSection "perf" ;
    :hasDefault "[300, 800]" ;
    :hasRange "from 1 to 100000" .

:Parameter_perf_ig_diag a :Parameter ;
    rdfs:label "perf.ig_diag" ;
    :hasDescription "Input guess (T=Direct, F=Iterative) diag. of Ham." ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_ig_norbp a :Parameter ;
    rdfs:label "perf.ig_norbp" ;
    :hasDescription "Input guess Orbitals per process for iterative diag." ;
    :inSection "perf" ;
    :hasDefault "5" ;
    :hasRange "from 1 to 1000" .

:Parameter_perf_ig_tol a :Parameter ;
    rdfs:label "perf.ig_tol" ;
    :hasDescription "Input guess Tolerance criterion" ;
    :inSection "perf" ;
    :hasDefault "1.0e-4" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_perf_imethod_overlap a :Parameter ;
    rdfs:label "perf.imethod_overlap" ;
    :hasDescription "Method to calculate the overlap matrices (1=old, 2=new)" ;
    :inSection "perf" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 1, 'label': 'old'}, {'value': 2, 'label': 'new'}" .

:Parameter_perf_inguess_geopt a :Parameter ;
    rdfs:label "perf.inguess_geopt" ;
    :hasDescription "Input guess to be used during the optimization" ;
    :inSection "perf" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'Wavelet input guess'}, {'value': 1, 'label': 'Real space input guess'}" .

:Parameter_perf_intermediate_forces a :Parameter ;
    rdfs:label "perf.intermediate_forces" ;
    :hasDescription "Linear scaling calculate intermediate forces" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_iterative_orthogonalization a :Parameter ;
    rdfs:label "perf.iterative_orthogonalization" ;
    :hasDescription "Iterative_orthogonalization for input guess orbitals" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_kappa_conv a :Parameter ;
    rdfs:label "perf.kappa_conv" ;
    :hasDescription "Exit kappa for extended input guess (experimental mode)" ;
    :inSection "perf" ;
    :hasDefault "0.1" .

:Parameter_perf_linear a :Parameter ;
    rdfs:label "perf.linear" ;
    :hasDescription "Linear Input Guess approach" ;
    :inSection "perf" ;
    :hasDefault "OFF" ;
    :hasAllowedValues "{'value': False, 'label': '???'}, {'value': 'LIG', 'label': '???'}, {'value': 'FUL', 'label': '???'}, {'value': 'TMO', 'label': '???'}" .

:Parameter_perf_loewdin_charge_analysis a :Parameter ;
    rdfs:label "perf.loewdin_charge_analysis" ;
    :hasDescription "Linear scaling perform a Loewdin charge analysis at the end of the calculation" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_methortho a :Parameter ;
    rdfs:label "perf.methortho" ;
    :hasDescription "Orthogonalisation" ;
    :inSection "perf" ;
    :hasDefault "0" ;
    :hasAllowedValues "{'value': 0, 'label': 'Cholesky'}, {'value': 1, 'label': 'Gram-Schmidt/Cholesky'}, {'value': 2, 'label': 'Loewdin'}" .

:Parameter_perf_mixing_after_inputguess a :Parameter ;
    rdfs:label "perf.mixing_after_inputguess" ;
    :hasDescription "Mixing step after linear input guess" ;
    :inSection "perf" ;
    :hasDefault "1" ;
    :hasAllowedValues "{'value': 0, 'label': 'keep the initial input guess density'}, {'value': 1, 'label': 'perform a mixing step with the default mixing parameter'}, {'value': 2, 'label': 'keep the new density, completely neglecting the input guess density'}" .

:Parameter_perf_mp_isf a :Parameter ;
    rdfs:label "perf.mp_isf" ;
    :hasDescription "(EXPERIMENTAL) Interpolating scaling function or lifted dual order for the multipole" ;
    :inSection "perf" ;
    :hasDefault "16" .

:Parameter_perf_multipole_preserving a :Parameter ;
    rdfs:label "perf.multipole_preserving" ;
    :hasDescription "(EXPERIMENTAL) Preserve the multipole moments of the ionic density" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_ocl_devices a :Parameter ;
    rdfs:label "perf.ocl_devices" ;
    :hasDescription "Chosen OCL devices" ;
    :inSection "perf" ;
    :hasDefault "~" .

:Parameter_perf_ocl_platform a :Parameter ;
    rdfs:label "perf.ocl_platform" ;
    :hasDescription "Chosen OCL platform" ;
    :inSection "perf" ;
    :hasDefault "~" .

:Parameter_perf_projrad a :Parameter ;
    rdfs:label "perf.projrad" ;
    :hasDescription "Radius of the projector as a function of the maxrad" ;
    :inSection "perf" ;
    :hasDefault "15." ;
    :hasRange "from 0.0 to 100.0" .

:Parameter_perf_psp_onfly a :Parameter ;
    rdfs:label "perf.psp_onfly" ;
    :hasDescription "Calculate pseudopotential projectors on the fly" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_rho_commun a :Parameter ;
    rdfs:label "perf.rho_commun" ;
    :hasDescription "Density communication scheme (DBL, RSC, MIX)" ;
    :inSection "perf" ;
    :hasDefault "DEF" .

:Parameter_perf_signaling a :Parameter ;
    rdfs:label "perf.signaling" ;
    :hasDescription "Expose calculation results on Network" ;
    :inSection "perf" ;
    :hasDefault "No" .

:Parameter_perf_signaltimeout a :Parameter ;
    rdfs:label "perf.signaltimeout" ;
    :hasDescription "Time out on startup for signal connection (in seconds)" ;
    :inSection "perf" ;
    :hasDefault "0" ;
    :hasRange "from -1 to 3600" .

:Parameter_perf_store_index a :Parameter ;
    rdfs:label "perf.store_index" ;
    :hasDescription "Store indices or recalculate them for linear scaling" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_store_overlap_matrices a :Parameter ;
    rdfs:label "perf.store_overlap_matrices" ;
    :hasDescription "Store all matrices relating to overlap powers, or recalculate them for linear scaling" ;
    :inSection "perf" ;
    :hasDefault "Yes" .

:Parameter_perf_tolsym a :Parameter ;
    rdfs:label "perf.tolsym" ;
    :hasDescription "Tolerance for symmetry detection" ;
    :inSection "perf" ;
    :hasDefault "1.0e-8" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_perf_unblock_comms a :Parameter ;
    rdfs:label "perf.unblock_comms" ;
    :hasDescription "Overlap Communications of fields (OFF,DEN,POT)" ;
    :inSection "perf" ;
    :hasDefault "OFF" ;
    :hasAllowedValues "{'value': False, 'label': 'Synchronous run'}, {'value': 'DEN', 'label': '???'}, {'value': 'POT', 'label': '???'}" .

:Parameter_perf_wf_extent_analysis a :Parameter ;
    rdfs:label "perf.wf_extent_analysis" ;
    :hasDescription "Perform an analysis of the extent of the support functions (and possibly KS orbitals)" ;
    :inSection "perf" ;
    :hasDefault "False" .

:Parameter_psolver_environment_alphaS a :Parameter ;
    rdfs:label "psolver.environment.alphaS" ;
    :hasDescription "Proportionality of repulsion free energy in term of the surface integral [dyn/cm]" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"water\"" .

:Parameter_psolver_environment_atomic_radii a :Parameter ;
    rdfs:label "psolver.environment.atomic_radii" ;
    :hasDescription "Mapping of the radii that have to be used for each atomic species" ;
    :inSection "psolver.environment" ;
    :hasDefault "0" .

:Parameter_psolver_environment_betaV a :Parameter ;
    rdfs:label "psolver.environment.betaV" ;
    :hasDescription "Proportionality of dispersion free energy in term of volume integral [GPa]" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"water\"" .

:Parameter_psolver_environment_cavitation a :Parameter ;
    rdfs:label "psolver.environment.cavitation" ;
    :hasDescription "Triggers the evaluation of the extra cavitation terms" ;
    :inSection "psolver.environment" ;
    :hasDefault "true" .

:Parameter_psolver_environment_cavity a :Parameter ;
    rdfs:label "psolver.environment.cavity" ;
    rdfs:comment "When not none, a cavity around the density is fixed" ;
    :hasDescription "Type of the cavity" ;
    :inSection "psolver.environment" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'No cavity, traditional vacuum treatment'}, {'value': 'soft-sphere', 'label': 'PCM-like cavity, fixed by some distance from the external atoms'}, {'value': 'sccs', 'label': 'Self-Consistent determination of the cavity from the charge density'}" .

:Parameter_psolver_environment_delta a :Parameter ;
    rdfs:label "psolver.environment.delta" ;
    :hasDescription "Amplitude of the transition region in the soft-sphere cavity (AU)" ;
    :inSection "psolver.environment" ;
    :hasDefault "0.5" .

:Parameter_psolver_environment_edensmaxmin a :Parameter ;
    rdfs:label "psolver.environment.edensmaxmin" ;
    :hasDescription "Extremum values of the charge density, for the definition of the transition region" ;
    :inSection "psolver.environment" ;
    :hasDefault "[0.0001, 0.005]" .

:Parameter_psolver_environment_epsilon a :Parameter ;
    rdfs:label "psolver.environment.epsilon" ;
    :hasDescription "Dielectric constant of the exterior region" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"water\"" ;
    :hasRange "from 1.0 to inf" .

:Parameter_psolver_environment_fact_rigid a :Parameter ;
    rdfs:label "psolver.environment.fact_rigid" ;
    :hasDescription "Multiplying factor for the whole soft-sphere cavity" ;
    :inSection "psolver.environment" ;
    :hasDefault "1.12" .

:Parameter_psolver_environment_fd_order a :Parameter ;
    rdfs:label "psolver.environment.fd_order" ;
    :hasDescription "Order of the Finite-difference derivatives for the GPS solver" ;
    :inSection "psolver.environment" ;
    :hasDefault "16" ;
    :hasAllowedValues "{'value': 2, 'label': ''}, {'value': 4, 'label': ''}, {'value': 6, 'label': ''}, {'value': 8, 'label': ''}, {'value': 16, 'label': ''}" .

:Parameter_psolver_environment_gammaS a :Parameter ;
    rdfs:label "psolver.environment.gammaS" ;
    :hasDescription "Cavitation term, surface tension of the solvent [dyn/cm]" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"water\"" .

:Parameter_psolver_environment_gps_algorithm a :Parameter ;
    rdfs:label "psolver.environment.gps_algorithm" ;
    :hasDescription "Algorithm for the Generalised Poisson Equation" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"PCG\"" ;
    :hasAllowedValues "{'value': 'SC', 'label': 'Self-Consistent method'}, {'value': 'PCG', 'label': 'Preconditioned Conjugate Gradient'}" .

:Parameter_psolver_environment_input_guess a :Parameter ;
    rdfs:label "psolver.environment.input_guess" ;
    :hasDescription "Triggers the input guess procedure of gps_algorithm" ;
    :inSection "psolver.environment" ;
    :hasDefault "true" .

:Parameter_psolver_environment_itermax a :Parameter ;
    rdfs:label "psolver.environment.itermax" ;
    :hasDescription "Maximum number of iterations of the GPS outer loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "200" .

:Parameter_psolver_environment_minres a :Parameter ;
    rdfs:label "psolver.environment.minres" ;
    :hasDescription "Convergence threshold of the loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "1.e-8" .

:Parameter_psolver_environment_pb_eta a :Parameter ;
    rdfs:label "psolver.environment.pb_eta" ;
    :hasDescription "Mixing parameter of the PBe loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "1.0" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_psolver_environment_pb_input_guess a :Parameter ;
    rdfs:label "psolver.environment.pb_input_guess" ;
    :hasDescription "Triggers the input guess procedure of PBe loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "true" .

:Parameter_psolver_environment_pb_ions a :Parameter ;
    rdfs:label "psolver.environment.pb_ions" ;
    :hasDescription "List of the ions of the PBe environment" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"nacl\"" .

:Parameter_psolver_environment_pb_itermax a :Parameter ;
    rdfs:label "psolver.environment.pb_itermax" ;
    :hasDescription "Maximum number of iterations of the PBe loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "50" .

:Parameter_psolver_environment_pb_method a :Parameter ;
    rdfs:label "psolver.environment.pb_method" ;
    :hasDescription "Defines the method for the Poisson Boltzmann Equation" ;
    :inSection "psolver.environment" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'No PBe, only GPe equation'}, {'value': 'linear', 'label': 'Linearized PBe'}, {'value': 'standard', 'label': 'PBe Equation, Gouy-Chapmann method'}, {'value': 'modified', 'label': 'Bikermann-type modified expression'}" .

:Parameter_psolver_environment_pb_minres a :Parameter ;
    rdfs:label "psolver.environment.pb_minres" ;
    :hasDescription "Convergence criterion of the PBe loop" ;
    :inSection "psolver.environment" ;
    :hasDefault "1e-10" ;
    :hasRange "from 0.0 to inf" .

:Parameter_psolver_environment_pb_t a :Parameter ;
    rdfs:label "psolver.environment.pb_t" ;
    :hasDescription "Temperature in Kelvin of the electrolytic solution" ;
    :inSection "psolver.environment" ;
    :hasDefault "300.0" ;
    :hasRange "from 0.0 to inf" .

:Parameter_psolver_environment_pi_eta a :Parameter ;
    rdfs:label "psolver.environment.pi_eta" ;
    :hasDescription "Mixing parameter of the SC algorithm" ;
    :inSection "psolver.environment" ;
    :hasDefault "0.6" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_psolver_environment_radii_set a :Parameter ;
    rdfs:label "psolver.environment.radii_set" ;
    :hasDescription "Set of vdW radii used by default in the setter function" ;
    :inSection "psolver.environment" ;
    :hasDefault "\"UFF\"" ;
    :hasAllowedValues "{'value': 'UFF', 'label': 'Unified Force Field'}, {'value': 'Bondi', 'label': 'Bondi collection'}, {'value': 'Pauling', 'label': 'Pauling collection'}" .

:Parameter_psolver_kernel_isf_order a :Parameter ;
    rdfs:label "psolver.kernel.isf_order" ;
    rdfs:comment "Fixes the order of the ISF family that is used for the discretization of the kernel" ;
    :hasDescription "Order of the Interpolating Scaling Function family" ;
    :inSection "psolver.kernel" ;
    :hasDefault "16" ;
    :hasAllowedValues "{'value': 2, 'label': ''}, {'value': 4, 'label': ''}, {'value': 6, 'label': ''}, {'value': 8, 'label': ''}, {'value': 14, 'label': ''}, {'value': 16, 'label': ''}, {'value': 20, 'label': ''}, {'value': 24, 'label': ''}, {'value': 30, 'label': ''}, {'value': 40, 'label': ''}, {'value': 50, 'label': ''}, {'value': 60, 'label': ''}, {'value': 100, 'label': ''}" .

:Parameter_psolver_kernel_screening a :Parameter ;
    rdfs:label "psolver.kernel.screening" ;
    rdfs:comment "Activates the exponential (Yukawa-like) screening in the coulomb kernel" ;
    :hasDescription "Mu screening parameter" ;
    :inSection "psolver.kernel" ;
    :hasDefault "0" ;
    :hasRange "from 0.0 to inf" .

:Parameter_psolver_kernel_stress_tensor a :Parameter ;
    rdfs:label "psolver.kernel.stress_tensor" ;
    rdfs:comment "It calculates the derivative of the hartree energy with respect to the deformation. It makes sense only for a vacuum-like calculation" ;
    :hasDescription "Triggers the calculation of the stress tensor" ;
    :inSection "psolver.kernel" ;
    :hasDefault "Yes" .

:Parameter_psolver_setup_accel a :Parameter ;
    rdfs:label "psolver.setup.accel" ;
    :hasDescription "Material Acceleration" ;
    :inSection "psolver.setup" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'CPU Solver'}, {'value': 'CUDA', 'label': 'CUFFT-based solver'}" .

:Parameter_psolver_setup_global_data a :Parameter ;
    rdfs:label "psolver.setup.global_data" ;
    :hasDescription "Charge density and Electrostatic potential are given by global arrays" ;
    :inSection "psolver.setup" ;
    :hasDefault "No" .

:Parameter_psolver_setup_keep_gpu_memory a :Parameter ;
    rdfs:label "psolver.setup.keep_gpu_memory" ;
    :hasDescription "Do not deallocate GPU memory at each call of the (G)PS routine" ;
    :inSection "psolver.setup" ;
    :hasDefault "true" .

:Parameter_psolver_setup_output a :Parameter ;
    rdfs:label "psolver.setup.output" ;
    rdfs:comment "Might be a list containing kewywords like cavity, potential or density" ;
    :hasDescription "Quantities to be plotted after the main solver routine" ;
    :inSection "psolver.setup" ;
    :hasDefault "none" .

:Parameter_psolver_setup_taskgroup_size a :Parameter ;
    rdfs:label "psolver.setup.taskgroup_size" ;
    :hasDescription "Size of the taskgroups of the Poisson Solver" ;
    :inSection "psolver.setup" ;
    :hasDefault "0" .

:Parameter_psolver_setup_use_gpu_direct a :Parameter ;
    rdfs:label "psolver.setup.use_gpu_direct" ;
    :hasDescription "Force (or not) the usage of GPUdirect communication, if available" ;
    :inSection "psolver.setup" ;
    :hasDefault "true" .

:Parameter_psolver_setup_verbose a :Parameter ;
    rdfs:label "psolver.setup.verbose" ;
    :hasDescription "Verbosity switch" ;
    :inSection "psolver.setup" ;
    :hasDefault "Yes" .

:Parameter_radical a :Parameter ;
    rdfs:label "radical" ;
    :hasDescription "Input variable radical of BigDFT." ;
    :inSection "radical" ;
    :hasDefault "h2o" .

:Parameter_run_from_files a :Parameter ;
    rdfs:label "run_from_files" ;
    :hasDescription "Input variable run_from_files of BigDFT." ;
    :inSection "run_from_files" ;
    :hasDefault "Yes" .

:Parameter_sic_sic_alpha a :Parameter ;
    rdfs:label "sic.sic_alpha" ;
    :hasDescription "SIC downscaling parameter" ;
    :inSection "sic" ;
    :hasDefault "0." ;
    :hasRange "from 0 to 1.0" .

:Parameter_sic_sic_approach a :Parameter ;
    rdfs:label "sic.sic_approach" ;
    :hasDescription "SIC (self-interaction correction) method" ;
    :inSection "sic" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'No self-interaction correction'}, {'value': 'PZ', 'label': 'Perdew-Zunger SIC scheme'}, {'value': 'NK', 'label': 'Non-Koopmans correction (Experimental)'}" .

:Parameter_sic_sic_fref a :Parameter ;
    rdfs:label "sic.sic_fref" ;
    :hasDescription "Reference occupation fref (for Non-Koopman case only)" ;
    :inSection "sic" ;
    :hasDefault "0.0" ;
    :hasRange "from 0.0 to 1.0" .

:Parameter_skip a :Parameter ;
    rdfs:label "skip" ;
    :hasDescription "Input variable skip of BigDFT." ;
    :inSection "skip" ;
    :hasDefault "No" .

:Parameter_tddft_decompose_perturbation a :Parameter ;
    rdfs:label "tddft.decompose_perturbation" ;
    :hasDescription "Indicate the directory of the perturbation to be decomposed in the basis of empty" ;
    :inSection "tddft" ;
    :hasDefault "none" .

:Parameter_tddft_tddft_approach a :Parameter ;
    rdfs:label "tddft.tddft_approach" ;
    :hasDescription "Time-Dependent DFT method" ;
    :inSection "tddft" ;
    :hasDefault "none" ;
    :hasAllowedValues "{'value': 'none', 'label': 'no tddft post-processing'}, {'value': 'TDA', 'label': \"Casida's LR-TDDFT using Tamm-Dancoff Approximation\"}, {'value': 'full', 'label': \"Full Casida's LR-TDDFT\"}" .

:Attribute_Logfile_XC_energy a :Attribute ;
    rdfs:label "XC_energy" ;
    :hasDescription "log.XC_energy: XC energy, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Last Iteration > Energies > EXC" ;
    :readsLogKey "Ground State Optimization > -1 > self consistency summary > -1 > Energies > EXC" .

:Attribute_Logfile_XC_parameter a :Attribute ;
    rdfs:label "XC_parameter" ;
    :hasDescription "log.XC_parameter: ixc:, read from the log (it repeats the input). Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "dft > ixc" ;
    :readsLogKey "DFT parameters: > XC ID:" .

:Attribute_Logfile_astruct a :Attribute ;
    rdfs:label "astruct" ;
    :hasDescription "log.astruct: astruct, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Atomic structure" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_5fb8fd409fbe> .

:Attribute_Logfile_data_directory a :Attribute ;
    rdfs:label "data_directory" ;
    :hasDescription "log.data_directory: data directory, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Data Writing directory" .

:Attribute_Logfile_dipole a :Attribute ;
    rdfs:label "dipole" ;
    :hasDescription "log.dipole: Dipole (AU), read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Electric Dipole Moment (AU) > P vector" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_90e6dfaaa9a3> .

:Attribute_Logfile_electrostatic_multipoles a :Attribute ;
    rdfs:label "electrostatic_multipoles" ;
    :hasDescription "log.electrostatic_multipoles: electrostatic multipoles, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Multipole coefficients" .

:Attribute_Logfile_energy a :Attribute ;
    rdfs:label "energy" ;
    :hasDescription "log.energy: Energy, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Last Iteration > FKS" ;
    :readsLogKey "Last Iteration > EKS" ;
    :readsLogKey "Energy (Hartree)" ;
    :readsLogKey "Ground State Optimization > -1 > self consistency summary > -1 > energy" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_24a1fde40aa8> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_90e6dfaaa9a3> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_ab6f691cfd10> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_b8ba0bca0fcb> ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_eb9431b43940> .

:Attribute_Logfile_evals a :Attribute ;
    rdfs:label "evals" ;
    :hasDescription "log.evals: evals, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Complete list of energy eigenvalues" ;
    :readsLogKey "Ground State Optimization > -1 > Orbitals" ;
    :readsLogKey "Ground State Optimization > -1 > Hamiltonian Optimization > -1 > Subspace Optimization > Orbitals" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_fef6feefdaa1> .

:Attribute_Logfile_fermi_level a :Attribute ;
    rdfs:label "fermi_level" ;
    :hasDescription "log.fermi_level: fermi level, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Ground State Optimization > -1 > Fermi Energy" ;
    :readsLogKey "Ground State Optimization > -1 > Hamiltonian Optimization > -1 > Subspace Optimization > Fermi Energy" ;
    :shownIn <http://bigdft.org/onto#:CodeSnippet:sha256_90e6dfaaa9a3> .

:Attribute_Logfile_force_fluct a :Attribute ;
    rdfs:label "force_fluct" ;
    :hasDescription "log.force_fluct: Threshold fluctuation of Forces, read from the log. Absent when the log does not hold it." ;
    :attributeOf :Class_BigDFT_Logfiles_Logfile ;
    :readsLogKey "Geometry > FORCES norm(Ha/Bohr) > fluct" .

:Attribute_Logfile_forcemax a :Attribute ;
