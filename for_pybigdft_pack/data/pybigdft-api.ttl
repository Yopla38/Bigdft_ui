    :hasSignature "SequenceRecord(sequence, start_index=1, line_length=None)" ;
    :hasArgument "sequence (required)" ;
    :hasArgument "start_index=1" ;
    :hasArgument "line_length=None" .

:Class_BigDFT_Interop_OpenMMInterop_OMMSystem a :PythonClass ;
    rdfs:label "OMMSystem" ;
    rdfs:comment "Class of OpenMM binder system which enables functionalities\nof openMM on a BigDFT system\n\nArgs:\n    system (System): a instance of a system class\n    filename (str): name of the PDB file to instantiate the system\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature.\n\nMethods and properties: OMMenergy, OMMposition, OMMsimulation, OMMsystem, forcegroups, get_energies, optimize, set_forcefields, set_integrator, write.\nInherited: ase_potential_energy (from System), compute_matching (from System), dataframe_slicing (from System), dict (from System), display (from System), distances_from_target (from System), examine (from System), get_external_potential (from System), get_k_nearest_fragments (from System), get_nearest_fragment (from System), get_net_force (from System), get_posinp (from System), reform_superunits (from System), rename_fragments (from System), serialize (from System), set_atom_forces (from System), set_atom_multipoles (from System), set_electrons_from_log (from System), set_logfile_info (from System), subsystem (from System), to_dataframe (from System), update_positions_from_dict (from System)." ;
    :hasDescription "Class of OpenMM binder system which enables functionalities of openMM on a BigDFT system" ;
    :definedIn :Module_BigDFT_Interop_OpenMMInterop ;
    :hasSignature "OMMSystem(system=None, filename=None)" ;
    :hasArgument "system=None" ;
    :hasArgument "filename=None" ;
    :inheritsFrom :Class_BigDFT_Systems_System .

:Class_BigDFT_Interop_PSI4Interop_PSI4Calculator a :PythonClass ;
    rdfs:label "PSI4Calculator" ;
    rdfs:comment "Perform a calculation on a given system using the PSI4 code.\n\nNote that if you intend to use an SAPT method, you need to pass a\nsystem which is composed of exactly two fragments.\n\nPSI4 has a number of different actions, ab initio methods, and basis\nsets. Be sure to specify each of these to the run command.\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature.\n\nMethods and properties: post_processing, pre_processing, process_run.\nInherited: get_global_option (from Runner), global_options (from Runner), pop_global_option (from Runner), run (from Runner), update_global_options (from Runner)." ;
    :hasDescription "Perform a calculation on a given system using the PSI4 code." ;
    :definedIn :Module_BigDFT_Interop_PSI4Interop ;
    :hasSignature "PSI4Calculator(omp='4', skip=False, verbose=True)" ;
    :hasArgument "omp='4'" ;
    :hasArgument "skip=False" ;
    :hasArgument "verbose=True" ;
    :inheritsFrom :Class_BigDFT_Calculators_Runner .

:Class_BigDFT_Interop_PSI4Interop_PSI4Logfile a :PythonClass ;
    rdfs:label "PSI4Logfile" ;
    rdfs:comment "A logfile wrapper for an SAPT calculation.\n\nThis logfile inherits from a dictionary, as the properties we get out\nof a calculation depend on the type of calculation performed.\n\nArgs:\n    fname (str): the name of the file to process.\n    action (str): the action that was used when running SAPT (energy,\n      optimize, frequency).\n    method (str): the scf method used.\n\nConstructor: Initialize self.  See help(type(self)) for accurate signature." ;
    :hasDescription "A logfile wrapper for an SAPT calculation." ;
    :definedIn :Module_BigDFT_Interop_PSI4Interop ;
    :hasSignature "PSI4Logfile(sys, fname, action, method)" ;
    :hasArgument "sys (required)" ;
    :hasArgument "fname (required)" ;
    :hasArgument "action (required)" ;
    :hasArgument "method (required)" .

